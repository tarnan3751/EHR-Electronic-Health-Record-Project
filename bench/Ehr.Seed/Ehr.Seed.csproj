       line (Ehr.Bench) and the tests that check the seed leaves the database protected (Ehr.Security.Tests). -->

  <ItemGroup>
    <!-- The name lists, for the tests that check every seeded name is drawn from them. -->
    <InternalsVisibleTo Include="Ehr.Security.Tests" />
    <InternalsVisibleTo Include="Ehr.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tables' entities and code lists, so the seed writes what the app reads; Npgsql comes with it. -->
    <ProjectReference Include="..\..\src\Ehr.Data\Ehr.Data.csproj" />
  </ItemGroup>

</Project>
