<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core and EF Core (keep on the same .NET 10 servicing release)">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Data access: EF Core for writes, Dapper for hot reads, both on Npgsql">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup Label="Cloud app forwards every write to the on-prem app">
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Restores pinned htmx and Alpine.js at build (see src/Ehr.Design/libman.json)">
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
  </ItemGroup>

  <ItemGroup Label="Tests (xunit on Microsoft.Testing.Platform; opted in via global.json)">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <!-- For tests/Ehr.Testing, which shares fixtures without being a test project. Same version as xunit.v3.mtp-v2. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <!-- Runs the web app in memory. Same .NET 10 servicing release as the ASP.NET Core packages above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Real browser coverage of the clinical keyboard, focus and failure/retry workflow. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
    <!-- The version ArchUnitNET depends on; the architecture tests also use it directly. -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup Label="UCUM, in the web tests only (Firely's Fhir.Metrics, BSD-3-Clause; the expansion plan's step 11)">
    <!-- To check every unit the reference data and the seed record (UcumTests). -->
    <PackageVersion Include="Fhir.Metrics" Version="1.4.0" />
  </ItemGroup>
</Project>
