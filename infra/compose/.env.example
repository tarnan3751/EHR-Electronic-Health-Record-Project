# Copy to .env in this folder. .env is gitignored; these values are for local development only.

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
REPLICATOR_PASSWORD=change-me-replicator
BARMAN_PASSWORD=change-me-barman

# Database roles: ehr_owner runs migrations (the migrate service); ehr_app and ehr_read are the apps' roles.
EHR_OWNER_PASSWORD=change-me-owner
EHR_APP_PASSWORD=change-me-app
EHR_READ_PASSWORD=change-me-read

# The first admin. The on-prem app creates this staff account at startup when there are no staff accounts yet, and
# never again; at first sign-in it must set a new password and enroll MFA. Leave both empty to skip.
EHR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EHR_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# Simulated latency, added in each direction (a round trip costs twice this).
# Internet: off-site browsers and the desktop app to the cloud app.
INTERNET_LATENCY_MS=30
INTERNET_JITTER_MS=5
# WAN: the cloud replica, cloud app and Barman to the on-prem site.
WAN_LATENCY_MS=40
WAN_JITTER_MS=5

# Host ports. Everything binds to 127.0.0.1 only.
ONPREM_HTTPS_PORT=8443
CLOUD_HTTPS_PORT=9443
ONPREM_DB_PORT=15432
CLOUD_DB_PORT=15433
RESTORE_DB_PORT=15434
TOXIPROXY_API_PORT=8474
MAILPIT_UI_PORT=8025

# AI profile only (docker compose --profile ai up -d). uv run src/Ehr.Dictation/setup_models.py puts the
# model file in infra/compose/models/ and prints its name for this line.
LLAMA_MODEL_FILE=K2-Horizon-7B-Q4_K_M.gguf
LLAMA_API_KEY=change-me-llama
