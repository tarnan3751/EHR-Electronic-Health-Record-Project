# Copy to .env in this folder. .env is gitignored; these values are for local development only.

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
REPLICATOR_PASSWORD=change-me-replicator
BARMAN_PASSWORD=change-me-barman

# Database roles: ehr_owner runs migrations (the migrate service); ehr_app and ehr_read are the apps' roles.
EHR_OWNER_PASSWORD=change-me-owner
EHR_APP_PASSWORD=change-me-app
EHR_READ_PASSWORD=change-me-read

# Shared by both apps: the cloud app ships the audit events of the PHI reads it serves to the on-prem app with it.
# At least 32 characters.
EHR_CLOUD_AUDIT_KEY=change-me-cloud-audit-key-32-chars-min

# The key portal enrollment codes are hashed with. Only the on-prem app holds it. At least 32 characters. Changing it makes the
# codes already handed out stop working.
EHR_ENROLLMENT_KEY=change-me-enrollment-key-32-chars-min

# Optional: the simulated lab's key (step 12). With it, the migration job stores its hash, the on-prem app opens the
# lab's door and the lab service files synthetic results for new lab orders; leave it empty, or leave the line out, for
# no lab. At least 32 characters: make one with `openssl rand -hex 32`, or in PowerShell 7
# `[Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))`.
EHR_LAB_KEY=change-me-lab-key-for-the-simulated-lab-32-chars-min

# The first admin. The on-prem app creates this staff account at startup when there are no staff accounts yet, and
# never again; at first sign-in it must set a new password and enroll MFA. Leave both empty to skip.
EHR_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EHR_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# Simulated latency, added in each direction (a round trip costs twice this).
# Internet: off-site browsers and the desktop app to the cloud app.
INTERNET_LATENCY_MS=30
INTERNET_JITTER_MS=5
# WAN: the cloud replica, cloud app and Barman to the on-prem site.
WAN_LATENCY_MS=40
WAN_JITTER_MS=5

# Host ports. Everything binds to 127.0.0.1 only.
ONPREM_HTTPS_PORT=8443
CLOUD_HTTPS_PORT=9443
ONPREM_DB_PORT=15432
CLOUD_DB_PORT=15433
RESTORE_DB_PORT=15434
TOXIPROXY_API_PORT=8474
MAILPIT_UI_PORT=8025
# Monitoring profile only.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Monitoring profile only (docker compose --profile monitoring up -d): the password its postgres_exporter logs in to the
# primary with, as the monitor role, which reads the replication slots' state and no table. The role takes it when the
# primary is first initialized, so set it before then (or reset the stack); without it the exporter refuses to start.
MONITOR_PASSWORD=change-me-monitor

# AI profile only (docker compose --profile ai up -d). uv run src/Ehr.Dictation/setup_models.py puts the
# model file in infra/compose/models/ and prints its name for this line.
LLAMA_MODEL_FILE=K2-Horizon-7B-Q4_K_M.gguf
LLAMA_API_KEY=change-me-llama
# The key the on-prem app calls the dictation sidecar with; both get it.
DICTATION_API_KEY=change-me-dictation

# Optional. The clinic's time zone, an IANA name, and the two abbreviations shown after a time (standard, daylight).
# Set both or neither: the defaults are America/Chicago and CST,CDT.
# EHR_CLINIC_TIME_ZONE=America/New_York
# EHR_CLINIC_TIME_ZONE_ABBREVIATIONS=EST,EDT
