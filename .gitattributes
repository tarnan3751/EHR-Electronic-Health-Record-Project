# LF everywhere: Linux containers and CI break on CRLF, and Git for Windows converts to CRLF by default.
* text=auto eol=lf

# cmd.exe needs CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.woff2 binary

# Generated files, collapsed in GitHub's diffs so a review shows what people wrote. The reference data is written by
# tools/reference from pinned sources; the designer and snapshot files by `dotnet ef migrations add`. A migration's
# own .cs file and db/migrations/schema.sql are not marked: they are what reviewers read.
db/reference/** linguist-generated=true
db/reference/ddinter/LICENSE.md linguist-generated=false
db/migrations/*.Designer.cs linguist-generated=true
db/migrations/EhrDbContextModelSnapshot.cs linguist-generated=true
