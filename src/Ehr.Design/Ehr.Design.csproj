<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Razor class library: shared partials plus static assets (tokens, CSS, sprite sheet, htmx, Alpine.js). -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" />
  </ItemGroup>

  <!-- LibMan downloads into wwwroot/lib during the build, after MSBuild has listed the files in wwwroot. On a clean
       build (always, in Docker and CI) the downloaded files would be missing from that list and never served. -->
  <Target Name="IncludeRestoredLibraries" AfterTargets="LibraryManagerRestore">
    <ItemGroup>
      <Content Include="wwwroot/lib/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
