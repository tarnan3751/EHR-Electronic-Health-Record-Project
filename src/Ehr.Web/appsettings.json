{
  // Search terms and dates of birth travel in the query string (/patients?name=...&birthdate=...), and a chart's link
  // carries them back to its search. ASP.NET Core logs every request's address at Information, and where it redirects
  // to, which after signing in is the address the person asked for, and YARP logs every address the cloud app
  // forwards, so these log only warnings and errors: no patient's details in a log line. Everything else, the apps'
  // own warnings and errors included, logs as it would without this file. Both servers read it.
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Mvc.Infrastructure.LocalRedirectResultExecutor": "Warning",
      "Microsoft.AspNetCore.Mvc.Infrastructure.RedirectResultExecutor": "Warning",
      "Yarp": "Warning"
    }
  },
  // Listening to a visit (the expansion plan's step 16) is off unless the clinic switches it on (Ambient/AmbientListening).
  "Ehr": {
    "Ambient": {
      "Enabled": false
    }
  }
}
