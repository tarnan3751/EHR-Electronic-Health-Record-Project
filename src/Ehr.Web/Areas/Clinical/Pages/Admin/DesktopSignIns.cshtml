@page "/admin/staff/{id:guid}/desktop"
@model DesktopSignInsModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Desktop sign-ins";
    var name = Model.Member.DisplayName;
}
<h1>Desktop sign-ins: @name</h1>
@* What revoking does, and the choice, at a reading width: the warning's lines are long sentences. *@
<div class="sc-desktop">
    @if (Model.Unended == 0)
    {
        <p class="sc-notice sc-notice--info" data-desktop-none><span class="sc-notice__state">No desktop sign-ins.</span></p>
    }
    else
    {
        <p data-desktop-count>@name has @Model.Unended active desktop @(Model.Unended == 1 ? "sign-in" : "sign-ins").</p>
        <section class="sc-notice sc-notice--warning" data-desktop-confirm>
            <p><strong>Revoke @name's desktop sign-ins?</strong> Each computer deletes its SwiftChart data the next time it connects. Unsent drafts and recordings are lost.</p>
            <p data-desktop-order>Revoke now. A computer signed out first is out of reach.</p>
        </section>
        <details class="sc-prose">
            <summary>More about revoking</summary>
            <ul>
                <li>Revoking is what deletes it. Disabling the account or resetting its password or authenticator deletes nothing.</li>
                <li>A computer that never connects again locks its data, and closes it 30 days after its last sign-in.</li>
                <li>They can sign in again afterwards, unless the account is disabled.</li>
            </ul>
        </details>
        @if (!OnPrem.IsReachable)
        {
            <p class="sc-muted" data-desktop-offline>Revoking needs the clinic's server.</p>
        }
        else
        {
            <form method="post" class="sc-actions">
                <button class="sc-btn sc-btn--danger">Revoke and delete</button>
                <a class="sc-btn" asp-page="/Admin/Staff">Cancel</a>
            </form>
        }
    }
</div>
