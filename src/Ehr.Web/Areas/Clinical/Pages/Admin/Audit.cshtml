@page "/admin/audit"
@using Ehr.Data.Audit
@using Ehr.Domain.Audit
@model AuditModel
@{
    ViewData["Title"] = "Audit";
}
<h1>Audit</h1>
<p class="sc-lede">Every view and change of patient information, and every sign-in, newest first. Patients appear by ID, and a change to their information by the names of the fields it changed, never its values. Emergency access is marked for review until an administrator reviews it.</p>
<form method="get" class="sc-filters">
    <div class="sc-field">
        <label asp-for="Action" class="sc-field__label">Action</label>
        <select asp-for="Action" class="sc-field__input">
            <option value="">Any</option>
            @foreach (var action in AuditActions.All)
            {
                <option value="@action">@action</option>
            }
        </select>
    </div>
    <div class="sc-field">
        <label asp-for="Part" class="sc-field__label">Part of the record</label>
        <select asp-for="Part" class="sc-field__input">
            <option value="">Any</option>
            @foreach (var part in AuditParts.All)
            {
                <option value="@part">@part</option>
            }
        </select>
    </div>
    <div class="sc-field">
        <label asp-for="Actor" class="sc-field__label">Staff account</label>
        <select asp-for="Actor" class="sc-field__input">
            <option value="">Anyone</option>
            @foreach (var member in Model.Staff)
            {
                <option value="@member.Id">@member.DisplayName</option>
            }
        </select>
    </div>
    <div class="sc-field">
        <label asp-for="Patient" class="sc-field__label">Patient ID</label>
        <input asp-for="Patient" class="sc-field__input sc-field__input--mono" autocomplete="off">
    </div>
    <div class="sc-field">
        <label asp-for="From" class="sc-field__label">From</label>
        <input asp-for="From" class="sc-field__input" type="date">
    </div>
    <div class="sc-field">
        <label asp-for="To" class="sc-field__label">To</label>
        <input asp-for="To" class="sc-field__input" type="date">
    </div>
    <label class="sc-check"><input asp-for="Flagged" type="checkbox"> Emergency access only</label>
    @* Step 18: emergency accesses by their review. *@
    <div class="sc-field">
        <label asp-for="Review" class="sc-field__label">Review</label>
        <select asp-for="Review" class="sc-field__input">
            <option value="">Any</option>
            <option value="@AuditReviewFilter.Waiting">Waiting for review</option>
            <option value="@AuditReviewFilter.NotAppropriate">Not appropriate</option>
        </select>
    </div>
    <button class="sc-btn sc-btn--primary">Show</button>
</form>
@if (Model.Log.Events.Count == 0)
{
    <p class="sc-muted">No events match.</p>
}
else
{
    @* Dense (docs/brand: AuditTable): times and IDs in mono, a header that stays in view, and the rows that need
       review tinted and tagged, so the color is never the only sign. An empty cell shows a muted dash. *@
    <div class="sc-table-wrap">
        <table class="sc-table">
            <thead>
                <tr><th>When (UTC)</th><th>Who</th><th>What</th><th>Patient</th><th>Row</th><th>Part</th><th>Reason and details</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Log.Events)
                {
                    <tr class="@(e.Action == AuditActions.BreakGlass && !(e.RowId is { } reviewed && Model.Reviews.ContainsKey(reviewed)) ? "sc-table__flagged" : null)">
                        <td class="sc-table__mono">@e.OccurredAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(e.ActorId is { } actor ? Model.Log.Actors.GetValueOrDefault(actor, actor.ToString()) : e.Source == AuditSources.Lab ? "Lab" : "System")</td>
                        @* An emergency access: "Review" until reviewed, then "Reviewed" and, when so, "Not appropriate"; either way the
                           way to its review (step 18). *@
                        <td>@e.Action@if (e.Action == AuditActions.BreakGlass && e.RowId is { } access)
                            {
                                if (Model.Reviews.TryGetValue(access, out var review))
                                {
                                    <text> <span class="sc-tag">Reviewed</span></text>
                                    if (review.Outcome == EmergencyAccessOutcomes.NotAppropriate)
                                    {
                                        <text> <span class="sc-tag sc-tag--danger">Not appropriate</span></text>
                                    }
                                }
                                else
                                {
                                    <text> <span class="sc-tag sc-tag--danger">Review</span></text>
                                }
                                <text> <a asp-page="EmergencyAccess" asp-route-id="@access" data-review-link>Open the review</a></text>
                            }</td>
                        @if (e.PatientId is { } patientId)
                        {
                            <td class="sc-table__id">@patientId</td>
                        }
                        else
                        {
                            <td class="sc-table__muted">—</td>
                        }
                        @if (e.TableName is { } table)
                        {
                            <td class="sc-table__id">@table @e.RowId</td>
                        }
                        else
                        {
                            <td class="sc-table__muted">—</td>
                        }
                        @* Which part of the record a read was for (step 13c2): none for any other event, or a read recorded
                           before that step. *@
                        @if (e.Part is { } part)
                        {
                            <td class="sc-table__mono">@part</td>
                        }
                        else
                        {
                            <td class="sc-table__muted">—</td>
                        }
                        <td>
                            @e.Reason
                            @if (e.Sensitive)
                            {
                                @* A write to a sensitive item: that it changed and who changed it, never its values. *@
                                <span class="sc-tag sc-tag--warning">Sensitive</span> <span>A sensitive item changed. Its values aren't shown here.</span>
                            }
                            else if (e.TableName == "chart_history")
                            {
                                <span class="sc-muted">A copy for the lists' history. Its values aren't shown here: see the entry's own event.</span>
                            }
                            else if (Model.Log.Fields.TryGetValue(e.Id, out var fields))
                            {
                                @* A write to patient data: the names of the fields it changed, never a value (step 18a). In
                                   mono, as IDs are, and wrapping, since an insert can name a dozen. *@
                                <span class="sc-muted">Fields changed:</span> <span class="sc-table__id" data-audit-fields>@fields</span>
                            }
                            else if (e.Reason is null && e.Details is null)
                            {
                                <span class="sc-table__muted">—</span>
                            }
                            @if (e.Details is { } details)
                            {
                                <details><summary>Details</summary><pre>@details</pre></details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Log.More)
    {
        <p><a asp-page="Audit" asp-all-route-data="Model.OlderRoute()">Older events</a></p>
    }
}
