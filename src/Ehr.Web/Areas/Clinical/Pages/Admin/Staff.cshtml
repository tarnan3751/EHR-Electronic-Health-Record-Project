@page "/admin/staff"
@model StaffModel
@{
    ViewData["Title"] = "Staff";
}
<h1>Staff</h1>

@if (Model.SetupLink is { } link)
{
    <section class="sc-notice sc-notice--success">
        <p><span class="sc-notice__state">Account created.</span> Send this setup link to the person. They choose their password with it, and it works once. It isn't shown again.</p>
        <p class="sc-copy">@link</p>
    </section>
}

@if (Model.Message is { } message)
{
    <p class="sc-notice sc-notice--info">@message</p>
}
<div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>

@* Each row's name, roles and status as wide as they are, the email taking the rest, and the row's actions on the right
   on one line: the link to the desktop sign-ins, the setup link (what most account trouble needs) as the one button with
   an edge, and the authenticator reset and the account switch quiet, since they lock the person out until they act. *@
<div class="sc-table-wrap sc-staff">
    <table class="sc-table">
        <thead>
            <tr><th class="sc-table__fit">Name</th><th>Email</th><th class="sc-table__fit">Roles</th><th class="sc-table__fit">Status</th><th class="sc-table__actions"><span class="sc-visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Staff)
            {
                <tr>
                    <td class="sc-table__fit">@member.DisplayName</td>
                    <td>@member.Email</td>
                    <td class="sc-table__fit">@string.Join(", ", member.Roles)</td>
                    <td>@StaffModel.StatusOf(member)</td>
                    <td class="sc-table__actions">
                        <div class="sc-actions">
                            @if (member.Roles.Contains(StaffRoles.Clinician))
                            {
                                @* Anyone's, their own included: the remote wipe for a lost laptop (DesktopSignIns). A link, since it
                                   opens a page; the buttons beside it act at once, and none is the page's primary. *@
                                <a asp-page="/Admin/DesktopSignIns" asp-route-id="@member.Id">Desktop sign-ins</a>
                            }
                            @if (member.Id != Model.CurrentUserId)
                            {
                                <form method="post" asp-page-handler="Reissue"><input type="hidden" name="id" value="@member.Id"><button class="sc-btn sc-btn--compact">New setup link</button></form>
                                @if (member.TwoFactorEnabled)
                                {
                                    <form method="post" asp-page-handler="ResetAuthenticator"><input type="hidden" name="id" value="@member.Id"><button class="sc-btn sc-btn--compact sc-btn--quiet">Reset authenticator</button></form>
                                }
                                @if (StaffAccounts.IsDisabled(member))
                                {
                                    <form method="post" asp-page-handler="Enable"><input type="hidden" name="id" value="@member.Id"><button class="sc-btn sc-btn--compact sc-btn--quiet">Enable account</button></form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Disable"><input type="hidden" name="id" value="@member.Id"><button class="sc-btn sc-btn--compact sc-btn--quiet sc-staff__disable">Disable account</button></form>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@* A card at the form's width, under the table it adds to. *@
<form method="post" class="sc-form sc-formcard">
    <h2>Add a staff account</h2>
    <div class="sc-field">
        <label asp-for="Input.Email" class="sc-field__label">Email</label>
        <input asp-for="Input.Email" class="sc-field__input" type="email" autocomplete="off" required>
        <span asp-validation-for="Input.Email" class="sc-field__error"></span>
    </div>
    <div class="sc-field">
        <label asp-for="Input.DisplayName" class="sc-field__label">Name to show</label>
        <input asp-for="Input.DisplayName" class="sc-field__input" autocomplete="off" required>
        <span asp-validation-for="Input.DisplayName" class="sc-field__error"></span>
    </div>
    <fieldset class="sc-stack">
        <legend>Roles</legend>
        <label class="sc-check"><input asp-for="Input.Clinician" type="checkbox"> Clinician: finds patients, reads charts, writes notes, places orders</label>
        <label class="sc-check"><input asp-for="Input.Admin" type="checkbox"> Admin: manages staff accounts and reads the audit log</label>
    </fieldset>
    <button class="sc-btn sc-btn--primary">Create account</button>
</form>
