@page "/appointments/{appointmentId:guid}"
@using Ehr.Data.Scheduling
@using Ehr.Domain.Scheduling
@model Ehr.Web.Areas.Clinical.Pages.Schedule.AppointmentModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    // The page is about a patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    var patient = Model.Detail.Patient;
    var appointment = Model.Detail.Appointment;
    ViewData["Title"] = "Appointment";
    var saved = Model.Saved switch
    {
        "rescheduled" => "Appointment rescheduled.",
        "cancelled" => "Appointment cancelled.",
        "checked-in" => "Checked in.",
        "no-show" => "Marked as a no-show.",
        _ => null,
    };
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(patient, Model.Detail.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-route-id="@patient.Id" class="sc-back">Back to chart</a></p>
    <p><a asp-page="Index" asp-route-clinician="@appointment.ClinicianId" asp-route-day="@Clinic.Day(appointment.StartsAt)" class="sc-back">Back to schedule</a></p>
    @* Step 13e: the forms asked for before this visit, and asking for one, on the patient's pre-visit forms page. *@
    <p><a asp-page="/Patients/Forms/Index" asp-route-patientId="@patient.Id" asp-fragment="appointment-@appointment.Id" class="sc-btn" data-forms>Pre-visit forms</a></p>
</div>
<h1>Appointment</h1>
@if (Model.Gone)
{
    <p class="sc-notice sc-notice--danger" role="alert"><span class="sc-notice__state">Not saved.</span> This appointment changed while the page was open.</p>
}
else if (saved is not null && Model.Errors.Count == 0)
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">@saved</span></p>
}
@* The appointment and what can be done with it, as panels two to a row. *@
<div class="sc-split sc-split--even">
<section class="sc-panel sc-sheet" aria-label="Appointment">
    <dl class="record">
        <dt>When</dt><dd>@Clinic.Plain(appointment.StartsAt, "dddd, MMMM d, yyyy"), @AppointmentForm.Time(Clinic, appointment)</dd>
        <dt>With</dt><dd>@appointment.Clinician</dd>
        <dt>Reason</dt><dd>@appointment.Reason</dd>
        <dt>Status</dt><dd><span class="sc-tag" data-appointment-status="@appointment.Status">@AppointmentStatus.Names[appointment.Status]</span></dd>
        @if (appointment.CancelReason is { } why)
        {
            <dt>Reason for cancelling</dt><dd>@why</dd>
        }
    </dl>
</section>
@if (Model.CanChange && OnPrem.IsReachable)
{
    <section class="sc-panel sc-sheet" aria-labelledby="appointment-arrival">
        <h2 class="sc-panel__title" id="appointment-arrival">Arrival</h2>
        <div class="sc-actions">
            <form method="post" asp-page-handler="CheckIn"><input type="hidden" name="Version" value="@Model.Version"><button class="sc-btn sc-btn--primary" aria-describedby="appointment-arrival-note">Check in</button></form>
            <form method="post" asp-page-handler="NoShow"><input type="hidden" name="Version" value="@Model.Version"><button class="sc-btn" aria-describedby="appointment-arrival-note">Mark as a no-show</button></form>
        </div>
        <p class="sc-muted" id="appointment-arrival-note">This can't be undone.</p>
    </section>
    <section class="sc-panel sc-sheet" aria-labelledby="appointment-reschedule">
        <h2 class="sc-panel__title" id="appointment-reschedule">Reschedule</h2>
        <form method="post" asp-page-handler="Reschedule" class="sc-form">
            <input type="hidden" name="Version" value="@Model.Version">
            <partial name="_When" model="new WhenFields(Model.Day, Model.Time, Model.Minutes, Model.Reason, Model.Errors)" />
            <button type="submit" class="sc-btn">Save new time</button>
        </form>
    </section>
    <section class="sc-panel sc-sheet" aria-labelledby="appointment-cancel">
        <h2 class="sc-panel__title" id="appointment-cancel">Cancel appointment</h2>
        <form method="post" asp-page-handler="Cancel" class="sc-form">
            <input type="hidden" name="Version" value="@Model.Version">
            <div class="sc-field">
                <label for="appointment-cancel-reason">Reason for cancelling <span>(required)</span></label>
                <textarea id="appointment-cancel-reason" class="sc-field__input" name="CancelReason" rows="2" maxlength="@Appointments.MaximumReasonLength" required
                          aria-invalid="@(Model.Errors.ContainsKey("CancelReason") ? "true" : null)"
                          aria-describedby="@(Model.Errors.ContainsKey("CancelReason") ? "appointment-cancel-reason-error" : null)">@Model.CancelReason</textarea>
                @if (Model.Errors.TryGetValue("CancelReason", out var cancelError))
                {
                    <p class="sc-field__error" id="appointment-cancel-reason-error">@cancelError</p>
                }
            </div>
            <p class="sc-muted" id="appointment-cancel-note">This can't be undone.</p>
            <button type="submit" class="sc-btn sc-btn--danger" aria-describedby="appointment-cancel-note">Cancel appointment</button>
        </form>
    </section>
}
else if (appointment.Status == AppointmentStatus.Booked && !OnPrem.IsReachable)
{
    <p class="sc-muted">Changing an appointment needs the clinic's server.</p>
}
else if (appointment.Status == AppointmentStatus.Booked)
{
    <p class="sc-muted">To change this appointment, add this patient to My patients.</p>
}
</div>
