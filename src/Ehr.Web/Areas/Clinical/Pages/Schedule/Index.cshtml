@page "/schedule"
@using Ehr.Data.Scheduling
@model Ehr.Web.Areas.Clinical.Pages.Schedule.IndexModel
@{
    // Patients are named here. Without htmx, nothing keeps the page in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    ViewData["Title"] = "Schedule";
}
<h1>Schedule</h1>
<form method="get" class="sc-filters">
    <div class="sc-field">
        <label for="schedule-clinician">Clinician</label>
        <select id="schedule-clinician" class="sc-field__input" name="clinician">
            @foreach (var (id, name) in Model.Clinicians)
            {
                <option value="@id" selected="@(id == Model.Shown)">@name</option>
            }
        </select>
    </div>
    <div class="sc-field">
        <label for="schedule-day">Day</label>
        <input type="date" id="schedule-day" class="sc-field__input" name="day" value="@Model.Date.ToString("yyyy-MM-dd")">
    </div>
    <button class="sc-btn">Show</button>
</form>
@* The day's heading, with the way to the day before and after on its right. *@
<div class="sc-sectionhead">
    <h2>@Model.Date.ToString("dddd, MMMM d, yyyy")</h2>
    <nav aria-label="Days">
        <ul class="sc-actions">
            <li><a href="@Model.Link(-1)" class="sc-btn sc-btn--compact">Previous day</a></li>
            <li><a href="@Model.Link(1)" class="sc-btn sc-btn--compact">Next day</a></li>
        </ul>
    </nav>
</div>
@if (Model.Appointments.Count == 0)
{
    <p class="sc-empty">No appointments on this day.</p>
}
else
{
    <div class="sc-table-wrap">
        <table class="sc-table">
            <thead>
                <tr><th scope="col" class="sc-table__fit">Time</th><th scope="col" class="sc-table__fit">Patient</th><th scope="col">Reason</th><th scope="col" class="sc-table__fit">Status</th><th scope="col" class="sc-table__actions"><span class="sc-visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model.Appointments)
                {
                    <tr data-appointment="@appointment.Status">
                        <td class="sc-table__mono">@AppointmentForm.Time(Clinic, appointment)</td>
                        <td class="sc-table__fit"><a asp-page="/Patients/Chart" asp-route-id="@appointment.PatientId">@appointment.PatientName</a> <span class="sc-table__mono sc-table__muted">@appointment.PatientMrn</span></td>
                        @if (Model.ShowsReason(appointment))
                        {
                            <td>@appointment.Reason</td>
                        }
                        else
                        {
                            <td class="sc-table__muted">Not one of your patients</td>
                        }
                        <td><span class="sc-tag @(appointment.Status == AppointmentStatus.Cancelled || appointment.Status == AppointmentStatus.NoShow ? "sc-tag--warning" : appointment.Status == AppointmentStatus.Fulfilled ? "sc-tag--success" : null)">@AppointmentStatus.Names[appointment.Status]</span></td>
                        <td class="sc-table__actions"><a asp-page="Appointment" asp-route-appointmentId="@appointment.Id" aria-label="Open appointment: @appointment.PatientName, @AppointmentForm.Time(Clinic, appointment)">Open</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
