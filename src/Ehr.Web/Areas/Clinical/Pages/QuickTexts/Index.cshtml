@page "/quick-texts"
@model IndexModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Quick text";
}
<h1>Quick text</h1>
<p class="sc-lede">Shared phrases, each inserted by typing its shortcut.</p>

@if (OnPrem.IsReachable)
{
    <partial name="_AddForm" model="new QuickTextForm()" />
}
else
{
    @* UC 2 (Tahseen Arnan): off-site with the clinic's server unreachable, nothing could be saved. *@
    <p class="sc-muted">Phrases can't be added or changed until the clinic's server is back.</p>
}

<ul id="quick-texts" class="sc-quicktexts">
    @foreach (var quickText in Model.QuickTexts)
    {
        <partial name="_QuickText" model="quickText" />
    }
</ul>
