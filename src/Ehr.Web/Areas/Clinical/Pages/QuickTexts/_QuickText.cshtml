@model QuickText
<li id="quick-text-@Model.Id">
    <span class="shortcut">@Model.Shortcut</span>
    <span class="body">@Model.Body</span>
    <button type="button" hx-get="@Url.Page("Index", "Edit", new { id = Model.Id })"
            hx-target="closest li" hx-swap="outerHTML">Edit</button>
</li>
