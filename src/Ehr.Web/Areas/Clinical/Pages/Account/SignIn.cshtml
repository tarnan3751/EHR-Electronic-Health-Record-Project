@page "/sign-in"
@model SignInModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (Model.Message is { } message)
{
    <p class="notice">@message</p>
}
<form method="post" class="account-form">
    <input type="hidden" asp-for="ReturnUrl">
    <label>Email <input asp-for="Input.Email" type="email" autocomplete="username" required autofocus></label>
    <span asp-validation-for="Input.Email" class="error"></span>
    <label>Password <input asp-for="Input.Password" type="password" autocomplete="current-password" required></label>
    <span asp-validation-for="Input.Password" class="error"></span>
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <button>Continue</button>
</form>
