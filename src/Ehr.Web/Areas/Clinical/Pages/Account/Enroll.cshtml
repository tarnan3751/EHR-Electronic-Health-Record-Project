@page "/sign-in/enroll"
@model EnrollModel
@{
    ViewData["Title"] = "Set up your authenticator";
}
@if (Model.RecoveryCodes is { } codes)
{
    <h1>Your recovery codes</h1>
    <p><strong>Save these codes now.</strong> They aren't shown again.</p>
    <ul class="sc-codes">
        @foreach (var code in codes)
        {
            <li class="mono-code">@code</li>
        }
    </ul>
    <p><a href="@Model.Continue" class="sc-btn sc-btn--primary">Continue</a></p>
}
else
{
    <h1>Set up your authenticator</h1>
    <p>Add this account to your authenticator app, then enter the code it shows.</p>
    <p><a href="@Model.Setup!.Uri">Open in an authenticator app</a>, or enter this key:</p>
    <p class="sc-code mono-code">@Model.KeyGrouped</p>
    <form method="post" class="sc-form">
        <input type="hidden" asp-for="ReturnUrl">
        <div class="sc-field">
            <label asp-for="Code" class="sc-field__label">Code from your app</label>
            <input asp-for="Code" class="sc-field__input sc-field__input--mono" inputmode="numeric" autocomplete="one-time-code" required autofocus>
            <span asp-validation-for="Code" class="sc-field__error"></span>
        </div>
        <button class="sc-btn sc-btn--primary">Finish setup</button>
    </form>
}
