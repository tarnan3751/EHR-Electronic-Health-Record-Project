@page "/sign-in/code"
@model CodeModel
@{
    ViewData["Title"] = "Enter your code";
}
<h1>Enter your code</h1>
<p>Enter the code from your authenticator app, or one of your recovery codes.</p>
<form method="post" class="sc-form">
    <input type="hidden" asp-for="ReturnUrl">
    <div class="sc-field">
        <label asp-for="Code" class="sc-field__label">Code</label>
        @* Not inputmode="numeric": recovery codes have letters. No spellcheck or capitals, which only get in a code's way. *@
        <input asp-for="Code" class="sc-field__input sc-field__input--mono" autocomplete="one-time-code" autocapitalize="off"
               spellcheck="false" maxlength="20" aria-describedby="code-hint" required autofocus>
        <p class="sc-field__hint" id="code-hint">A new code shows in your app every 30 seconds. A recovery code works once.</p>
        <span asp-validation-for="Code" class="sc-field__error"></span>
    </div>
    <div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>
    <button class="sc-btn sc-btn--primary">Sign in</button>
</form>
