@page "/sign-in/setup"
@model SetupModel
@{
    ViewData["Title"] = "Set up your account";
}
<h1>Set up your account</h1>
@if (!Model.LinkIsValid)
{
    <p class="notice error">This link is not valid or has already been used. Ask an administrator for a new one.</p>
}
else
{
    <p>Welcome, @Model.DisplayName. Choose a password; at your first sign-in you'll also set up an authenticator app.</p>
    <form method="post" class="account-form" asp-route-user="@Model.UserId" asp-route-token="@Model.Token">
        <label>Password <input asp-for="Input.Password" type="password" autocomplete="new-password" required autofocus></label>
        <span asp-validation-for="Input.Password" class="error"></span>
        <label>Password, again <input asp-for="Input.Confirm" type="password" autocomplete="new-password" required></label>
        <span asp-validation-for="Input.Confirm" class="error"></span>
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <button>Set password</button>
    </form>
}
