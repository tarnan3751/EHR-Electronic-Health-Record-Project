@page "/sign-in/setup"
@model SetupModel
@{
    ViewData["Title"] = "Set up your account";
}
<h1>Set up your account</h1>
@if (!Model.LinkIsValid)
{
    <p class="sc-notice sc-notice--danger">This setup link isn't valid or has already been used. Ask an administrator for a new one.</p>
}
else
{
    <p>Welcome, @Model.DisplayName. Choose a password. When you first sign in, you'll also set up an authenticator app.</p>
    <form method="post" class="sc-form" asp-route-user="@Model.UserId" asp-route-token="@Model.Token">
        <div class="sc-field">
            <label asp-for="Input.Password" class="sc-field__label">Password</label>
            <input asp-for="Input.Password" class="sc-field__input" type="password" autocomplete="new-password" required autofocus>
            <span asp-validation-for="Input.Password" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Confirm" class="sc-field__label">Password, again</label>
            <input asp-for="Input.Confirm" class="sc-field__input" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Input.Confirm" class="sc-field__error"></span>
        </div>
        <div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>
        <button class="sc-btn sc-btn--primary">Set password</button>
    </form>
}
