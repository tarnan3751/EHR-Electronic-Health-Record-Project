@page "/patients/{id:guid}/{list:regex(^(allergies|medications|diagnoses)$)}/{entryId:guid?}"
@using Ehr.Data.Patients
@using Ehr.Domain.Patients
@model Ehr.Web.Areas.Clinical.Pages.Patients.Lists.EntryModel
@{
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    // Off the panel nothing about the patient was read: the page says the post wasn't saved, and no more.
    var patient = Model.OffPanel ? null : Model.Form.Patient;
    var heading = $"{(Model.IsNew ? "Add" : "Change")} {Model.About.One}";
    ViewData["Title"] = patient is null ? "Not saved" : heading;
}
@section Scripts {
    @if (patient is not null)
    {
        <script src="~/_content/Ehr.Design/js/code-search.js" defer></script>
    }
}
@section Banner {
    @if (patient is not null)
    {
        <partial name="_PatientBanner" model="new PatientBanner(patient, Model.Form.Allergies)" />
    }
}
@if (patient is null)
{
    <h1>Not saved</h1>
    <p class="sc-notice sc-notice--danger" role="alert" tabindex="-1" data-focus-on-load data-not-saved><span class="sc-notice__state">Not saved.</span> This isn't one of your patients.</p>
    <div class="sc-form sc-kept">
        @foreach (var (field, value) in Model.Typed)
        {
            @* A newline first in each box, which the browser drops, so one that starts the text is kept. *@
            <label>@field <textarea readonly rows="2">@("\n")@value</textarea></label>
        }
        <p><a asp-page="/Patients/Index" asp-all-route-data="Model.Search.RouteData()">Back to patients</a></p>
    </div>
}
else
{
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-all-route-data="Model.ChartLink" class="sc-back">Back to chart</a></p>
</div>
<h1>@heading</h1>
@if (Model.Proposed is { } proposed)
{
    <partial name="~/Areas/Clinical/Pages/Patients/Notes/_ProposedFromDictation.cshtml" model="proposed" />
}

<form method="post" class="sc-form sc-formcard sc-formcard--wide sc-formgrid">
    @if (Model.IsNew)
    {
        @* The new entry's ID, so posting this form twice saves one entry (ChartLists.SaveAsync). *@
        <input type="hidden" name="NewEntryId" value="@Model.NewEntryId">
    }
    @if (Model.ProposalDecided)
    {
        @* Step 15: nothing was added, so nothing waits to be undone. *@
        <p class="sc-notice sc-notice--danger" role="alert" tabindex="-1" data-focus-on-load><span class="sc-notice__state">Not saved.</span> This proposal was already decided. <a href="@Model.ReviewLink">Back to review</a></p>
    }
    else if (Model.Errors.Count > 0)
    {
        <p class="sc-notice sc-notice--danger" role="alert"><span class="sc-notice__state">Not saved.</span> Fix the highlighted fields and try again.</p>
    }
    else if (Model.Refused)
    {
        <p class="sc-notice sc-notice--danger" role="alert" tabindex="-1" data-focus-on-load data-not-saved><span class="sc-notice__state">Not saved.</span> The entry changed, or this isn't one of your patients.</p>
    }
    @{ var nameError = Model.Errors.GetValueOrDefault("Name"); }
    <div class="sc-field">
        <label for="entry-name">@Model.About.Label <span>(required)</span></label>
        <input id="entry-name" class="sc-field__input" name="Name" value="@Model.Name" list="entry-codes" maxlength="@ChartLists.MaximumLength" autocomplete="off" required
               autofocus="@(Model.Focused == "Name")" data-code-search="@Model.About.Kind"
               aria-invalid="@(nameError is null ? null : "true")" aria-describedby="@(nameError is null ? "entry-name-hint" : "entry-name-error entry-name-hint")">
        <datalist id="entry-codes"></datalist>
        @if (nameError is not null)
        {
            <p class="sc-field__error" id="entry-name-error">@nameError</p>
        }
        @* How to search, since only a name from the list (or, for a diagnosis, its code) is saved. The search says when
           nothing matches or the session has ended (js/code-search.js). *@
        <p class="sc-field__hint" id="entry-name-hint">@(Model.List == "diagnoses" ? "Search by name or ICD-10-CM code." : "Type at least two letters to search.")<span aria-live="polite" data-code-search-status></span></p>
    </div>
    @if (Model.List == "allergies")
    {
        Text("Reaction", "entry-reaction", "Reaction", Model.Reaction, "entry-reactions");
        <datalist id="entry-reactions">
            @foreach (var reaction in ChartLists.Reactions)
            {
                <option value="@reaction"></option>
            }
        </datalist>
        Choice("Severity", "entry-severity", "Severity", Model.Severity, optional: true, ChartListWords.Severities);
        Choice("Criticality", "entry-criticality", "Criticality", Model.Criticality, optional: true, ChartListWords.Criticalities);
    }
    else if (Model.List == "medications")
    {
        Text("Dosage", "entry-dosage", "Dosage", Model.Dosage, list: null);
        Day("Started", "entry-started", "Started", Model.Started);
        Day("Stopped", "entry-stopped", "Stopped", Model.Stopped);
    }
    else
    {
        Day("Onset", "entry-onset", "Onset", Model.Onset);
    }
    @{ Choice("Status", "entry-status", "Status", Model.Status, optional: false, Model.Statuses); }
    @if (Model.List != "allergies")
    {
        <div class="sc-field">
            @if (Model.SensitiveByCode)
            {
                @* Marked by the rule, so it can't be cleared (docs/brand: Sensitive items). A disabled box isn't posted;
                   the page and the database keep the diagnosis sensitive either way. *@
                <label class="sc-check" for="entry-sensitive"><input type="checkbox" id="entry-sensitive" checked disabled aria-describedby="entry-sensitive-hint"> Sensitive</label>
                <p class="sc-field__hint" id="entry-sensitive-hint">Always sensitive for this code. Views are logged.</p>
            }
            else
            {
                <label class="sc-check" for="entry-sensitive"><input type="checkbox" id="entry-sensitive" name="Sensitive" value="true" checked="@Model.Sensitive" aria-describedby="entry-sensitive-hint"> Sensitive</label>
                <p class="sc-field__hint" id="entry-sensitive-hint">Views are logged.</p>
            }
        </div>
    }
    <div class="sc-actions">
        <button type="submit" class="sc-btn sc-btn--primary">Save @Model.About.One</button>
        @if (Model.ReviewLink is { } review)
        {
            <a href="@review">Cancel</a>
        }
        else
        {
            <a asp-page="/Patients/Chart" asp-all-route-data="Model.ChartLink">Cancel</a>
        }
    </div>
</form>
}

@functions {
    void Text(string name, string id, string label, string? value, string? list)
    {
        var error = Model.Errors.GetValueOrDefault(name);
        <div class="sc-field">
            <label for="@id">@label</label>
            <input id="@id" class="sc-field__input" name="@name" value="@value" list="@list" maxlength="@ChartLists.MaximumLength" autocomplete="off" autofocus="@(Model.Focused == name)"
                   aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : $"{id}-error")">
            @if (error is not null)
            {
                <p class="sc-field__error" id="@id-error">@error</p>
            }
        </div>
    }

    void Day(string name, string id, string label, string? value)
    {
        var error = Model.Errors.GetValueOrDefault(name);
        <div class="sc-field">
            <label for="@id">@label</label>
            <input type="date" id="@id" class="sc-field__input" name="@name" value="@value" autofocus="@(Model.Focused == name)"
                   aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : $"{id}-error")">
            @if (error is not null)
            {
                <p class="sc-field__error" id="@id-error">@error</p>
            }
        </div>
    }

    void Choice(string name, string id, string label, string? value, bool optional, IReadOnlyList<(string Code, string Name)> options)
    {
        var error = Model.Errors.GetValueOrDefault(name);
        <div class="sc-field">
            <label for="@id">@label</label>
            <select id="@id" class="sc-field__input" name="@name" autofocus="@(Model.Focused == name)" aria-invalid="@(error is null ? null : "true")" aria-describedby="@(error is null ? null : $"{id}-error")">
                @if (optional)
                {
                    <!option value="">Not recorded</!option>
                }
                @foreach (var (code, text) in options)
                {
                    <!option value="@code" selected="@(code == value)">@text</!option>
                }
            </select>
            @if (error is not null)
            {
                <p class="sc-field__error" id="@id-error">@error</p>
            }
        </div>
    }
}
