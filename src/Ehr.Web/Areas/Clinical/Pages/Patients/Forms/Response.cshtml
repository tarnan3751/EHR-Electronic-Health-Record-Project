@page "/patients/{patientId:guid}/forms/{responseId:guid}"
@model Ehr.Web.Areas.Clinical.Pages.Patients.Forms.ResponseModel
@{
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    var patient = Model.Answers.Patient;
    var form = Model.Answers.Form;
    var answered = form.Response!;
    var definition = form.Definition;
    // A page title names no form: it is a sensitive item (docs/brand: sensitive items).
    ViewData["Title"] = $"Pre-visit form: {patient.FamilyName}, {patient.GivenName}";
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(patient)" />
}
<div class="sc-pagehead">
    @if (Model.FromInbox)
    {
        <p><a asp-page="/Inbox/Index">Back to the inbox</a></p>
    }
    else
    {
        <p><a asp-page="Index" asp-route-patientId="@patient.Id" asp-route-sensitive="true" asp-fragment="appointment-@form.AppointmentId">Back to pre-visit forms</a></p>
    }
</div>
<h1>Pre-visit form: @patient.FamilyName, @patient.GivenName</h1>
@if (Model.Answers.CareTeam is { } team)
{
    @* Opened from the reader's inbox, not their panel: whose patient this is, and the one way to the chart. *@
    <p class="sc-notice sc-notice--info" data-form-not-on-panel><span class="sc-notice__state">Not on your panel:</span> @patient.GivenName @patient.FamilyName is @(team.Count == 0 ? "on no clinician's panel" : $"on the panel of {string.Join(", ", team)}"), and the chart opens to you only under emergency access, which <a asp-page="/Patients/Chart" asp-route-id="@patient.Id">the chart</a> asks you for.</p>
}
<p class="sc-notice sc-notice--info" data-sensitive="shown"><span class="sc-notice__state">Sensitive items shown:</span> your view of them is recorded.</p>
@if (answered.Alert)
{
    @foreach (var (number, item) in definition.NeedingReview(answered.Answers))
    {
        <p class="sc-notice sc-notice--danger" data-form-alert><span class="sc-notice__state">An answer needs review:</span> question @number, "@item.Text".</p>
    }
}
<section class="sc-panel" aria-label="The form">
    <dl class="record">
        <dt>Questionnaire</dt><dd>@form.Title <span class="sc-tag sc-tag--warning">Sensitive</span></dd>
        <dt>Before</dt><dd>@Clinic.Format(form.AppointmentStartsAt) with @form.AppointmentClinician</dd>
        <dt>Answered</dt><dd>@Clinic.Format(answered.AnsweredAt) by @(answered.ByProxy ? $"{answered.Proxy}, not the patient" : "the patient")</dd>
        @if (answered.Score is { } score)
        {
            <dt>Score</dt>
            <dd data-form-score>@score@(definition.Max is { } max ? $" of {max}" : "")@(answered.Band is { } band ? $" · {band}" : "")@if (answered.FollowUp) {<text> </text><span class="sc-tag sc-tag--warning" data-form-follow-up>Needs follow-up</span>}</dd>
        }
    </dl>
</section>
<h2>Answers</h2>
<p>@definition.Prompt</p>
@* Each question, then the answer chosen beneath it, with its score when the question is scored (sc-answers). *@
<dl class="sc-answers" data-form-answers>
    @foreach (var item in definition.Items)
    {
        var chosen = answered.Answers.TryGetValue(item.Code, out var code) ? definition.AnswersTo(item).FirstOrDefault(answer => answer.Code == code) : null;
        <dt>@item.Text</dt>
        <dd>@(chosen?.Text ?? "Not answered")@if (item.Scored && chosen?.Score is { } points)
            {
                <text> </text><span class="sc-answers__score">· score @points.ToString(System.Globalization.CultureInfo.InvariantCulture)</span>
            }</dd>
    }
</dl>
@if (definition.Attribution is { } attribution)
{
    <p class="sc-muted">@attribution</p>
}
