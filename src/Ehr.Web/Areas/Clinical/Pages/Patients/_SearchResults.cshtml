@* What the patients page shows under the search form, and all that comes back as the clinician types: what to correct,
   the search's results, or, with no search, the clinician's panel, which typing that empties the fields doesn't
   list again. *@
@model IndexModel
@if (Model.Problems.Count > 0)
{
    <ul class="notice error" role="alert">
        @foreach (var problem in Model.Problems)
        {
            <li>@problem</li>
        }
    </ul>
}
else if (Model.Searched)
{
    <h2>Search results</h2>
    @if (Model.Results.Count == 0)
    {
        <p>No patients match.</p>
    }
    else
    {
        @if (Model.Results.Any(patient => !Model.Panel.Contains(patient.Id)))
        {
            <p><span class="tag restricted">Restricted</span> Not on your panel: opening the chart asks for a reason first.</p>
        }
        <partial name="_PatientTable" model="new PatientTable(Model.Results, Model.Panel, MarkPanel: true, Model.Search)" />
        @if (Model.More && Model.Live)
        {
            <p>More patients match than are listed here. Keep typing to narrow them, or press Enter for the full list.</p>
        }
        else if (Model.More)
        {
            <p>More patients match than are listed here. Add more letters of the name, or a date of birth, to narrow them.</p>
        }
    }
}
else if (Model.Live)
{
    <p>Type a name, a date of birth or an MRN to search, or press Clear to see your patients.</p>
}
else
{
    <h2>My patients</h2>
    @if (Model.PanelPatients.Count == 0)
    {
        <p>No patients are on your panel yet. Search for a patient and add them from the chart.</p>
    }
    else
    {
        <partial name="_PatientTable" model="new PatientTable(Model.PanelPatients, Model.Panel, MarkPanel: false, SearchQuery.None)" />
        @if (Model.PanelMore)
        {
            <p>More patients are on your panel than are listed here: these are the first @IndexModel.PanelLimit, in name order. Search to find the others.</p>
        }
    }
}
