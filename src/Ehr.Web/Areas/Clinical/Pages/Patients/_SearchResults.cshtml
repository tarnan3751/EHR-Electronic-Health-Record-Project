@* What the patients page shows under the search form, and all that comes back as the clinician types: what to correct,
   the search's results, or, with no search, the clinician's panel, which typing that empties the fields doesn't
   list again. *@
@model IndexModel
@if (Model.Problems.Count > 0)
{
    <ul class="sc-notice sc-notice--danger" role="alert">
        @foreach (var problem in Model.Problems)
        {
            <li>@problem</li>
        }
    </ul>
}
else if (Model.Searched)
{
    <h2>Search results</h2>
    @if (Model.Results.Count == 0)
    {
        <p class="sc-muted">No patients match.</p>
    }
    else
    {
        @if (Model.Results.Any(patient => !Model.Panel.Contains(patient.Id)))
        {
            <p class="sc-muted"><span class="sc-tag sc-tag--warning">Restricted</span> Not one of your patients. Opening the chart asks for a reason first.</p>
        }
        <partial name="_PatientTable" model="new PatientTable(Model.Results, Model.Panel, MarkPanel: true, Model.Search)" />
        @if (Model.More && Model.Live)
        {
            <p class="sc-muted">More patients match than are shown. Keep typing to narrow them, or press Enter to see more.</p>
        }
        else if (Model.More)
        {
            <p class="sc-muted">More patients match than are shown. Add more of the name, or a date of birth, to narrow them.</p>
        }
    }
}
else if (Model.Live)
{
    <p class="sc-muted">Type a name, a date of birth or an MRN to search, or press Clear to see your patients.</p>
}
else
{
    <h2>My patients</h2>
    @if (Model.PanelPatients.Count == 0)
    {
        <p class="sc-muted">No patients yet. Search for a patient, then add them from their chart.</p>
    }
    else
    {
        <partial name="_PatientTable" model="new PatientTable(Model.PanelPatients, Model.Panel, MarkPanel: false, SearchQuery.None)" />
        @if (Model.PanelMore)
        {
            <p class="sc-muted">Showing the first @IndexModel.PanelLimit, by name. Search to find the others.</p>
        }
    }
}
