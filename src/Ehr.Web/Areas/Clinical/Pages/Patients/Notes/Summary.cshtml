@page "/patients/{patientId:guid}/notes/{noteId:guid}/summary"
@using Ehr.Domain.Notes
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.SummaryModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Write visit summary";
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    string[] fields = ["summary-talked-about", "summary-found", "summary-next-steps"];
    string?[] values = [Model.TalkedAbout, Model.Found, Model.NextSteps];
    string[] names = [nameof(Model.TalkedAbout), nameof(Model.Found), nameof(Model.NextSteps)];
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" class="sc-back">Back to note</a></p>
</div>
<h1>Write visit summary</h1>
@* The form beside the note it is written from. *@
<div class="sc-split">
<div class="sc-formcard sc-formcard--wide">
@if (Model.SourcesSensitive)
{
    <p class="sc-notice sc-notice--info" data-summary-sensitive><span class="sc-notice__state">Sensitive summary.</span> Proxies see it only if the patient allows sensitive items.</p>
}
@if (!OnPrem.IsReachable)
{
    @* UC 2: reached by Back or a tab opened before the outage. Nothing to release until the server is back: no form,
       under the layout's read-only band. *@
}
else if (Model.Standing is not null)
{
    @if (Model.Errors.Count > 0)
    {
        <div class="sc-notice sc-notice--danger" role="alert" data-summary-errors>
            @foreach (var error in Model.Errors) { <p><span class="sc-notice__state">Not released.</span> @error</p> }
        </div>
    }
    <p class="sc-notice sc-notice--info" data-summary-standing><span class="sc-notice__state">Already released.</span> Released by @Model.Standing.ReleasedBy, @Clinic.Format(Model.Standing.ReleasedAt). To write another, withdraw it first.</p>
}
else
{
<form method="post" class="sc-form sc-form--wide" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id">
    @if (Model.Errors.Count > 0)
    {
        <div class="sc-notice sc-notice--danger" role="alert" data-summary-errors>
            @for (var e = 0; e < Model.Errors.Count; e++) { <p id="summary-error-@e"><span class="sc-notice__state">Not released.</span> @Model.Errors[e]</p> }
        </div>
    }
    @for (var i = 0; i < VisitSummaries.Parts.Length; i++)
    {
        @* Only the parts an error is about are invalid, each described by its errors. *@
        string[] about = [.. Enumerable.Range(0, Model.ErrorParts.Count).Where(e => Model.ErrorParts[e] == i).Select(e => $"summary-error-{e}")];
        <div class="sc-field">
            <label for="@fields[i]">@VisitSummaries.Parts[i] <span>(required)</span></label>
            <textarea id="@fields[i]" class="sc-field__input" name="@names[i]" rows="5" maxlength="@VisitSummaries.MaxLength" required autofocus="@(i == 0 ? "autofocus" : null)"
                      aria-describedby="@(about.Length > 0 ? string.Join(' ', about) : null)" aria-invalid="@(about.Length > 0 ? "true" : null)">@values[i]</textarea>
        </div>
    }
    @if (!Model.SourcesSensitive)
    {
        <label class="sc-check" for="summary-sensitive"><input type="checkbox" id="summary-sensitive" name="Sensitive" value="true" checked="@Model.Sensitive" aria-describedby="summary-sensitive-hint"> Sensitive</label>
        <p class="sc-field__hint" id="summary-sensitive-hint">Views are logged.</p>
    }
    @* What the patient will read, at the moment of releasing it; the rest under the disclosure. *@
    <p class="sc-muted">The patient sees it in the portal as written. It can't be edited after release.</p>
    <details>
        <summary>More about visit summaries</summary>
        <ul>
            <li>Proxies see it too; a sensitive one only if the patient allows sensitive items.</li>
            <li>Leave out codes and record numbers.</li>
            <li>To correct a released summary, withdraw it and write a new one.</li>
        </ul>
    </details>
    <div class="sc-actions">
        <button type="submit" class="sc-btn sc-btn--primary" data-release-summary>Release visit summary</button>
        <a class="sc-btn" asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id">Cancel</a>
    </div>
</form>
}
</div>

@* For reference only: nothing of it is copied into the summary, which the clinician writes for the patient. *@
<section class="sc-sheet" aria-labelledby="signed-note">
<h2 id="signed-note">Signed note</h2>
<partial name="_NoteContent" model="NoteSections.Of(Model.Note)" />
</section>
</div>
