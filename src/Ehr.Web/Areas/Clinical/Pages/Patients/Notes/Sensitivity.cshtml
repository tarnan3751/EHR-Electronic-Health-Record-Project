@page "/patients/{patientId:guid}/notes/{noteId:guid}/sensitivity"
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.SensitivityModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    var what = Model.Entry is not null ? "addendum" : Model.SummaryEntry is not null ? "visit summary" : "note";
    var title = Model.Sensitive ? $"Unmark this {what} as sensitive" : $"Mark this {what} sensitive";
    ViewData["Title"] = title;
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" class="sc-back">Back to note</a></p>
</div>
<h1>@title</h1>
@* What is marked, what marking does, then the reason: one task, in one card. *@
<div class="sc-formcard sc-formcard--wide">
@if (Model.Entry is { } entry)
{
    <p class="sc-prose">Addendum by <strong>@entry.AuthorName</strong>, signed @Clinic.Format(entry.SignedAt).</p>
}
else if (Model.SummaryEntry is { } summary)
{
    @* Step 13a: who released it and when, not its text. *@
    <p class="sc-prose">Visit summary released by <strong>@summary.ReleasedBy</strong>, @Clinic.Format(summary.ReleasedAt).</p>
}
else
{
    <p class="sc-prose">Note signed @Clinic.Format(Model.Note.SignedAt).</p>
}
@* That views are logged, when marking; what else marking or unmarking changes, under the disclosure. *@
@if (!Model.Sensitive)
{
    <p class="sc-prose">Views are logged.</p>
}
<details>
    <summary>@(Model.Sensitive ? "More about unmarking" : "More about sensitive items")</summary>
    <ul>
        @if (Model.SummaryEntry is not null && !Model.Sensitive)
        {
            <li>Hidden on the note's page until someone shows sensitive items.</li>
            <li>In the portal, the patient sees it when they choose to.</li>
            <li>Proxies see it only if the patient allows sensitive items.</li>
            <li>Only you or the note's signer can unmark it.</li>
        }
        else if (Model.SummaryEntry is not null)
        {
            <li>Shown with the note again, and in the portal to the patient's proxies.</li>
        }
        else if (!Model.Sensitive)
        {
            <li>Hidden from the chart until someone shows sensitive items.</li>
            <li>@(Model.Entry is null ? "Its addenda and visit summaries become sensitive too." : "The note's visit summaries become sensitive too.")</li>
            <li>Not kept offline.</li>
            <li>@(Model.IsSigner ? "Only you can unmark it." : "Only you or the note's signer can unmark it.")</li>
        }
        else if (Model.Entry is null)
        {
            <li>Addenda sensitive only because of this note are unmarked too.</li>
            <li>Its visit summaries are unmarked too, unless an addendum is still sensitive.</li>
            <li>An addendum marked on its own stays marked.</li>
        }
        else
        {
            <li>The note's visit summaries are unmarked too, unless the note or another addendum is still sensitive.</li>
        }
    </ul>
</details>
@if (!OnPrem.IsReachable)
{
    @* Off-site with the clinic's server down: no form, under the layout's read-only band. *@
}
else if (Model.Sensitive && Model.HeldByNote && Model.SummaryEntry is not null)
{
    <p class="sc-notice sc-notice--info" data-held-by-sources><span class="sc-notice__state">Can't unmark yet.</span> Unmark the note and its sensitive addenda first.</p>
}
else if (Model.Sensitive && Model.HeldByNote)
{
    <p class="sc-notice sc-notice--info"><span class="sc-notice__state">Can't unmark yet.</span> Unmark the note first.</p>
}
else if (Model.Sensitive && !Model.MayUnmark)
{
    <p class="sc-notice sc-notice--info" data-may-not-unmark><span class="sc-notice__state">Can't unmark.</span> Only the person who marked it or the note's signer can.</p>
}
else
{
    <form method="post" class="sc-form sc-form--wide" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-addendum="@Model.Addendum" asp-route-summary="@Model.Summary">
        @if (Model.Errors.Count > 0)
        {
            <div class="sc-notice sc-notice--danger" role="alert">
                @foreach (var error in Model.Errors) { <p><span class="sc-notice__state">Not saved.</span> @error</p> }
            </div>
        }
        <input type="hidden" name="Mark" value="@(Model.Sensitive ? "false" : "true")">
        <div class="sc-field">
            <label for="sensitivity-reason">Reason <span>(required)</span></label>
            <input id="sensitivity-reason" class="sc-field__input" name="Reason" value="@Model.Reason" maxlength="500" required autofocus autocomplete="off"
                   aria-invalid="@(Model.Errors.Count > 0 ? "true" : null)">
        </div>
        <div class="sc-actions">
            <button type="submit" class="sc-btn sc-btn--primary" data-change-sensitivity>@(Model.Sensitive ? "Unmark as sensitive" : "Mark sensitive")</button>
            <a class="sc-btn" asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id">Cancel</a>
        </div>
    </form>
}
</div>
