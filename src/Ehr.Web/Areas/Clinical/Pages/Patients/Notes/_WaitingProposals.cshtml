@model (Guid DraftId, IReadOnlyList<Ehr.Data.Patients.AiChartProposal> Waiting, bool Signed)
@* The expansion plan's step 15: the orders and allergies to add this note's dictations proposed that still wait for their
   author's decision, on the note being written and, near its top, the signed note. They never hold up signing, unlike
   the note's fields, and signing doesn't decide them: each is opened in its form, or dismissed, on its review. *@
@if (Model.Waiting.Count > 0)
{
    var first = Model.Waiting[0];
    var one = Model.Waiting.Count == 1;
    <p class="sc-notice sc-notice--warning" data-waiting-proposals="@Model.Waiting.Count"><span class="sc-notice__state">Awaiting review.</span> @(one ? "An order or allergy" : $"{Model.Waiting.Count} orders or allergies") proposed from dictation. <a asp-page="/Patients/Notes/Review" asp-area="Clinical" asp-route-patientId="@first.PatientId" asp-route-draftId="@Model.DraftId" asp-route-reviewId="@first.ReviewId">@(one ? "Review it" : "Review them")</a>. @if (Model.Signed)
        {<text>You can still open or dismiss @(one ? "it" : "them").</text>}
        else if (one)
        {<text>Unlike the note's fields, it doesn't hold up signing.</text>}
        else
        {<text>Unlike the note's fields, they don't hold up signing.</text>}</p>
}
