@page "/patients/{patientId:guid}/notes/{noteId:guid}"
@using Ehr.Domain.Notes
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.ViewModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Signed clinical note";
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
}
@* The patient, in the banner under the app bar. The note pages read no allergies, so the banner shows none. *@
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-route-id="@Model.Patient.Id" class="sc-back">Back to chart</a></p>
</div>
<h1 class="sc-title">Clinical note <span class="sc-tag sc-tag--success">Signed · read-only</span>@if (Model.Note.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning" data-note-sensitive>Sensitive</span> }</h1>
@if (Model.Done == "addendum")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Addendum signed.</span> It's shown after the note.</p>
}
else if (Model.Done is "summary" or "withdrawn")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">@(Model.Done == "summary" ? "Released." : "Withdrawn.")</span> @(Model.Done == "summary" ? "The patient can now read the summary in the portal." : "The patient no longer sees the summary in the portal.")</p>
}
else if (Model.Done is "marked" or "unmarked")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Saved.</span> @(Model.Done == "marked" ? "Marked sensitive, with your reason." : "No longer marked sensitive.")</p>
}
else
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Signed.</span> Corrections go in an addendum.</p>
}
<partial name="_WaitingProposals" model="(Model.Note.DraftId, Model.WaitingProposals, true)" />
@if (Model.Note.Sensitive)
{
    <p class="sc-notice sc-notice--info" data-sensitive="shown"><span class="sc-notice__state">Sensitive note.</span> Your view of it is logged.</p>
}
@* The note as one document: who signed it and when, its sections, then what can change about it. *@
<div class="sc-notedoc">
    <dl class="record">
        <dt>Signed by</dt><dd>@Model.SignerName</dd>
        <dt>Signed</dt><dd><time datetime="@Model.Note.SignedAt.ToString("O")">@Clinic.Format(Model.Note.SignedAt, "yyyy-MM-dd HH:mm:ss")</time></dd>
    </dl>
    <partial name="_NoteContent" model="NoteSections.Of(Model.Note)" />
    @* Step 10b: the note's sensitivity can change after signing, with a reason; its text never does. *@
    @if (Model.Note.SensitiveReason is not null)
    {
        <p class="sc-muted" data-sensitivity-reason>@Model.Change(Model.Note.Sensitive, Model.Note.SensitiveMarkedBy) @Clinic.Format(Model.Note.SensitiveChangedAt): @Model.Note.SensitiveReason</p>
    }
    @if (Model.OnPanel && OnPrem.IsReachable)
    {
        <p><a asp-page="Sensitivity" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" data-note-sensitivity>@(Model.Note.Sensitive ? "Unmark this note as sensitive" : "Mark this note sensitive")</a></p>
    }
</div>

@* Addenda (step 10): the note above never changes; each addendum is a signed text after it, oldest first. *@
<section class="sc-sheet" aria-labelledby="addenda">
<h2 id="addenda">Addenda</h2>
@if (Model.Addenda.SensitiveHidden > 0)
{
    <p class="sc-notice sc-notice--info" data-sensitive="hidden"><span class="sc-notice__state">Sensitive addenda hidden.</span> @Model.Addenda.SensitiveHidden @(Model.Addenda.SensitiveHidden == 1 ? "addendum is" : "addenda are") not shown. <a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-sensitive="true" asp-fragment="addenda">Show sensitive addenda</a></p>
}
else if (Model.Addenda.SensitiveShown && !Model.Note.Sensitive && Model.Addenda.Shown.Any(a => a.Sensitive))
{
    <p class="sc-notice sc-notice--info" data-sensitive="shown"><span class="sc-notice__state">Sensitive addenda shown.</span> Your view of them is logged. <a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-fragment="addenda">Hide sensitive addenda</a></p>
}
@if (Model.Addenda.Shown.Count == 0)
{
    <p class="sc-muted">@(Model.Addenda.SensitiveHidden > 0 ? "No other addenda." : "No addenda.")</p>
}
else
{
    <ol class="sc-list" data-addenda>
        @foreach (var addendum in Model.Addenda.Shown)
        {
            <li data-addendum="@addendum.Id">
                <p>
                    @* Step 10b: one written by someone other than the note's signer says so. *@
                    <strong>@(addendum.ByNoteAuthor ? addendum.AuthorName : $"Addendum by {addendum.AuthorName}, not the note's author")</strong>
                    <span class="sc-muted">· signed <time datetime="@addendum.SignedAt.ToString("O")">@Clinic.Format(addendum.SignedAt)</time></span>
                    @if (addendum.Sensitive)
                    {
                        @* Inherited from the note: it goes when the note is unmarked. Its own: until it is unmarked itself. *@
                        <span class="sc-tag sc-tag--warning" data-addendum-sensitive="@(addendum.SensitiveInherited ? "inherited" : "own")">@(addendum.SensitiveInherited ? "Sensitive with the note" : "Sensitive")</span>
                    }
                </p>
                <p class="sc-note__text">@addendum.Text</p>
                @if (addendum.SensitiveReason is not null)
                {
                    <p class="sc-muted">@(addendum.SensitiveInherited ? "Sensitive with the note" : Model.Change(addendum.Sensitive, addendum.SensitiveMarkedBy)) @Clinic.Format(addendum.SensitiveChangedAt): @addendum.SensitiveReason</p>
                }
                @if (Model.OnPanel && OnPrem.IsReachable && !(addendum.Sensitive && Model.Note.Sensitive))
                {
                    <p><a asp-page="Sensitivity" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-addendum="@addendum.Id" data-addendum-sensitivity>@(addendum.Sensitive ? "Unmark as sensitive" : "Mark sensitive")<span class="sc-visually-hidden">, the addendum by @addendum.AuthorName signed @Clinic.Format(addendum.SignedAt)</span></a></p>
                }
            </li>
        }
    </ol>
}

@* The form is on a page of its own: this page stays read-only, with nothing to type into. *@
@if (!Model.OnPanel)
{
    <p class="sc-muted">To sign an addendum, add this patient to My patients.</p>
}
else if (!OnPrem.IsReachable)
{
    <p class="sc-muted">An addendum can't be signed until the clinic's server is back.</p>
}
else
{
    <p><a class="sc-btn" asp-page="Addendum" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" data-add-addendum>Add addendum</a></p>
}
</section>

@* Step 13a: what the patient reads of this note, written for them. The note itself never reaches the portal. *@
<section class="sc-sheet" aria-labelledby="summary">
<h2 id="summary">Visit summary for the patient</h2>
@if (Model.Summaries.SensitiveHidden > 0)
{
    <p class="sc-notice sc-notice--info" data-sensitive="hidden-summaries"><span class="sc-notice__state">Sensitive summaries hidden.</span> @Model.Summaries.SensitiveHidden @(Model.Summaries.SensitiveHidden == 1 ? "visit summary is" : "visit summaries are") not shown. <a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-sensitive="true" asp-fragment="summary">Show sensitive summaries</a></p>
}
else if (Model.Summaries.SensitiveShown && !Model.Note.Sensitive && Model.Summaries.Shown.Any(s => s.Sensitive))
{
    <p class="sc-notice sc-notice--info" data-sensitive="shown-summaries"><span class="sc-notice__state">Sensitive summaries shown.</span> Your view of them is logged. <a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-fragment="summary">Hide sensitive summaries</a></p>
}
@if (!Model.Summaries.HasStanding)
{
    <p class="sc-muted" data-summary="none">None yet. The patient can't see anything of this note.</p>
}
@foreach (var summary in Model.Summaries.Shown)
{
    <div data-summary="@(summary.WithdrawnAt is null ? "standing" : "withdrawn")">
        @if (summary.WithdrawnAt is null)
        {
            <p><strong>Released to the patient by @summary.ReleasedBy</strong> <span class="sc-muted">· <time datetime="@summary.ReleasedAt.ToString("O")">@Clinic.Format(summary.ReleasedAt)</time></span>@if (summary.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning" data-summary-sensitive="@(summary.SensitiveInherited ? "inherited" : "own")">@(summary.SensitiveInherited ? "Sensitive with the note" : "Sensitive")</span> }</p>
        }
        else
        {
            <p class="sc-muted">Released by @summary.ReleasedBy, @Clinic.Format(summary.ReleasedAt). <strong>Withdrawn by @summary.WithdrawnBy</strong> · @Clinic.Format(summary.WithdrawnAt): @summary.WithdrawnReason@if (summary.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning" data-summary-sensitive="@(summary.SensitiveInherited ? "inherited" : "own")">@(summary.SensitiveInherited ? "Sensitive with the note" : "Sensitive")</span> }</p>
        }
        <div class="sc-notedoc">
            <partial name="_SummaryContent" model="summary" />
        </div>
        @* Its sensitivity can change after it is released, with a reason, as an addendum's (Tahseen's decision of 21 November 2026). *@
        @if (summary.SensitiveReason is not null)
        {
            <p class="sc-muted" data-summary-sensitivity-reason>@(summary.SensitiveInherited ? "Sensitive with the note" : Model.Change(summary.Sensitive, summary.SensitiveMarkedBy)) @Clinic.Format(summary.SensitiveChangedAt): @summary.SensitiveReason</p>
        }
        @if (Model.OnPanel && OnPrem.IsReachable)
        {
            <p>
                @if (summary.WithdrawnAt is null)
                {
                    <a asp-page="WithdrawSummary" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-summaryId="@summary.Id" data-withdraw-summary>Withdraw this summary…</a>
                }
                @if (!(summary.Sensitive && Model.SourcesSensitive))
                {
                    @(summary.WithdrawnAt is null ? " · " : "")<a asp-page="Sensitivity" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" asp-route-summary="@summary.Id" data-summary-sensitivity>@(summary.Sensitive ? "Unmark as sensitive" : "Mark sensitive")<span class="sc-visually-hidden">, the visit summary released @Clinic.Format(summary.ReleasedAt)</span></a>
                }
            </p>
        }
    </div>
}
@if (!Model.OnPanel)
{
    <p class="sc-muted">To write a visit summary, add this patient to My patients.</p>
}
else if (!OnPrem.IsReachable)
{
    <p class="sc-muted">A summary can't be released until the clinic's server is back.</p>
}
else if (!Model.Summaries.HasStanding)
{
    <p><a class="sc-btn" asp-page="Summary" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" data-write-summary>Write visit summary</a></p>
}
</section>

<partial name="_ReviewHistory" model="Model.CompletedReviews" />
