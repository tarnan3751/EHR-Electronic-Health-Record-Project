@page "/patients/{patientId:guid}/notes/{noteId:guid}/addendum"
@using Ehr.Domain.Notes
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.AddendumModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Add addendum";
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id" class="sc-back">Back to note</a></p>
</div>
<h1>Add addendum</h1>
@* The form beside the note it follows. *@
<div class="sc-split">
<div class="sc-formcard sc-formcard--wide">
@* UC 2: reached by Back or a tab opened before the outage, there is nothing to sign with until the server is back: no
   form, under the layout's read-only band. *@
@if (OnPrem.IsReachable)
{
<form method="post" class="sc-form sc-form--wide" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id">
    @if (Model.Errors.Count > 0)
    {
        <div class="sc-notice sc-notice--danger" role="alert">
            @foreach (var error in Model.Errors) { <p><span class="sc-notice__state">Not signed.</span> @error</p> }
        </div>
    }
    <div class="sc-field">
        <label for="addendum-text">Addendum <span>(required)</span></label>
        <textarea id="addendum-text" class="sc-field__input" name="Text" rows="8" maxlength="@Ehr.Data.Patients.NoteAddendumConfiguration.MaxLength" required autofocus
                  aria-invalid="@(Model.Errors.Count > 0 ? "true" : null)">@Model.Text</textarea>
    </div>
    @if (Model.Note.Sensitive)
    {
        <p class="sc-muted">Sensitive, as the note is.</p>
    }
    else
    {
        <label class="sc-check" for="addendum-sensitive"><input type="checkbox" id="addendum-sensitive" name="Sensitive" value="true" checked="@Model.Sensitive" aria-describedby="addendum-sensitive-hint"> Sensitive</label>
        <p class="sc-field__hint" id="addendum-sensitive-hint">Views are logged.</p>
    }
    <p class="sc-muted">This can't be undone.</p>
    <div class="sc-actions">
        <button type="submit" class="sc-btn sc-btn--primary" data-sign-addendum>Sign addendum</button>
        <a class="sc-btn" asp-page="View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@Model.Note.Id">Cancel</a>
    </div>
</form>
}
</div>

<section class="sc-sheet" aria-labelledby="signed-note">
<h2 id="signed-note">Signed note</h2>
<partial name="_NoteContent" model="NoteSections.Of(Model.Note)" />
</section>
</div>
