@model IReadOnlyList<Ehr.Domain.Notes.NoteSection>
@* A note's sections, read-only, under the headings it was written with, their text kept as it was typed (step 14:
   Subjective, Objective, Assessment and Plan; or History, Assessment and Plan for a note written before them). *@
<section class="sc-note">
    @if (Model.Count > 0 && Model[0].Title == Ehr.Domain.Notes.NoteSections.History)
    {
        <p class="sc-muted" data-note-format="history">Earlier format: History, Assessment and Plan.</p>
    }
    @foreach (var part in Model)
    {
        <h2>@part.Title</h2><p class="sc-note__text">@part.Text</p>
    }
</section>
