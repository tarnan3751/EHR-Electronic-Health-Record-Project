@model IReadOnlyList<Ehr.Data.Patients.AiNoteReview>
@if (Model.Count > 0)
{
    <details>
        <summary>Saved AI reviews</summary>
        <ul class="sc-list">
            @foreach (var review in Model)
            {
                <li><a asp-page="/Patients/Notes/Review" asp-area="Clinical" asp-route-patientId="@review.PatientId" asp-route-draftId="@review.DraftId" asp-route-reviewId="@review.Id">Dictation and review saved @Clinic.Format(review.CompletedAt, "yyyy-MM-dd HH:mm:ss") — original proposals and decisions</a></li>
            }
        </ul>
    </details>
}
