@using Ehr.Web.Api.Dictation
@model IReadOnlyList<Ehr.Data.Patients.AiNoteReview>
@if (Model.Count > 0)
{
    <details>
        <summary>Finished dictation reviews</summary>
        <ul class="sc-list">
            @foreach (var review in Model)
            {
                <li><a asp-page="/Patients/Notes/Review" asp-area="Clinical" asp-route-patientId="@review.PatientId" asp-route-draftId="@review.DraftId" asp-route-reviewId="@review.Id">Dictation@(DictationResult.SpokenLanguageOf(review.ResultJson) == SpokenLanguage.Spanish ? " in Spanish" : "") and review saved @Clinic.Format(review.CompletedAt, "MMM d, yyyy HH:mm:ss"), with its proposals and decisions</a></li>
            }
        </ul>
    </details>
}
