@page "/patients/{patientId:guid}/notes/drafts/{draftId:guid}/review/{reviewId:guid}"
@using Ehr.Domain.Notes
@using Ehr.Data.Patients
@model Ehr.Web.Areas.Clinical.Pages.Patients.Notes.ReviewModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@inject AmbientTranscriptKeep Keep
@{
    ViewData["Title"] = Model.Ambient ? "Review the note drafted from the visit" : "Review dictated fields";
}
@* The patient, in the banner under the app bar. The note pages read no allergies, so the banner shows none. *@
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
@functions {
    // A proposal's state in the words and the tone its tag shows it in (js/note-review.js does the same as states change).
    static string StateWords(string? state) => state switch
    {
        AiProposalStates.Pending => "Awaiting review",
        AiProposalStates.Accepted => "Accepted",
        AiProposalStates.Edited => "Edited",
        AiProposalStates.Rejected => "Rejected",
        _ => "No usable suggestion",
    };

    // A proposed field's heading. A dictation sorted into History (before the expansion plan's step 14) is added to
    // Subjective, where the editor asks for what belongs in Objective to be moved there (NoteReviews).
    static string FieldLabel(string field) => field == "history" ? "History (goes into Subjective)" : char.ToUpperInvariant(field[0]) + field[1..];

    static string StateTone(string? state) => state switch
    {
        AiProposalStates.Pending => "sc-tag sc-tag--warning",
        AiProposalStates.Accepted or AiProposalStates.Edited => "sc-tag sc-tag--success",
        _ => "sc-tag",
    };
}
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-route-id="@Model.Patient.Id">Back to chart</a></p>
</div>
<h1>@(Model.Ambient ? "Review the note drafted from the visit" : "Review dictated fields")</h1>
<p class="sc-prose">Check each proposal against @(Model.Ambient ? "what was said" : "your own words"). Nothing goes into the note until you finish the review. This review never places orders or changes allergies.</p>
@* The expansion plan's step 16: a recorded visit's review. *@
@if (Model.Ambient)
{
    <p class="sc-notice sc-notice--info" data-ambient-own-words><span class="sc-notice__state">Patient's own words.</span> Subjective values quote the patient. Reword each as your note before you accept it.</p>
    @if (Model.DecideAtTheClinic)
    {
        <p class="sc-notice sc-notice--warning" data-ambient-at-the-clinic><span class="sc-notice__state">Read-only here.</span> @ReviewModel.FinishAtTheClinic</p>
    }
}
@* Off-site, a visit's words are read only at the clinic: the script says so where it would quote them. *@
<section data-note-review data-dictation data-stage-url="@($"/api/dictation/sessions/review/{Model.Review.Id}/stage")" data-dictation-words-at-the-clinic="@(Model.DecideAtTheClinic ? "true" : "false")">
    <script type="application/json" data-review-snapshot>@Json.Serialize(Model.Snapshot)</script>
    @* Step 16: a recorded visit's transcript, read at the clinic, as stored (ReviewModel.ConversationJson). *@
    @if (Model.ConversationJson is { } conversation)
    {
        <script type="application/json" data-review-transcript>@Html.Raw(conversation)</script>
    }
    <p id="note-save-status" class="sc-status" role="status" aria-live="polite">Saved review</p>
    <div id="note-errors" class="sc-notice sc-notice--danger" role="alert" tabindex="-1" hidden="@(Model.Errors.Count == 0)">
        @foreach (var error in Model.Errors) { <p>@error</p> }
    </div>
    <p data-review-progress class="sc-status" role="status" aria-live="polite">@(Model.Proposals.Count(p => p.State != AiProposalStates.Pending)) of @Model.Proposals.Count @(Model.Proposals.Count == 1 ? "proposal" : "proposals") reviewed.</p>
    @Html.AntiForgeryToken()
    @if (Model.Review.State == AiReviewStates.Recording && !Model.Signed)
    {
        @* Step 16: a visit left here when its page couldn't fetch it, or was closed, says what it is. One whose voices were
           named may still be drafting at the service, so Retrieve comes first and the sentence says to wait for it;
           otherwise it is discarded. *@
        @if (Model.Ambient)
        {
            <p class="sc-notice sc-notice--warning" data-ambient-not-drafted><span class="sc-notice__state">Not drafted yet.</span> A visit was recorded at @Clinic.Format(Model.Review.CreatedAt). If you named its voices a moment ago, wait a minute, then retrieve its draft. Otherwise, discard it and dictate or listen again.</p>
        }
        else
        {
            <p class="sc-notice sc-notice--warning"><span class="sc-notice__state">Not ready for review.</span> Retrieve the finished dictation, or discard it and write the note yourself. Nothing from it is in the note.</p>
        }
        <div class="sc-actions">
            <button type="button" class="sc-btn" data-review-retrieve>@(Model.Ambient ? "Retrieve the visit's draft" : "Retrieve finished dictation")</button>
            <form method="post" asp-page-handler="Discard" data-review-submit>
                <button class="sc-btn sc-btn--danger">@(Model.Ambient ? "Discard the visit" : "Discard dictation")</button>
            </form>
        </div>
    }
    @* Signing ends the fields' review, not the proposals' (step 15): those still waiting are opened or dismissed below. *@
    @if (Model.Signed)
    {
        <p class="sc-notice sc-notice--info"><span class="sc-notice__state">Signed.</span> This review is read-only.@(Model.ChartProposals.Any(p => p.Waiting) ? " You can still open or dismiss the proposed orders and allergies below." : "")</p>
    }
    @if (Model.Translated)
    {
        @* The expansion plan's step 17: the checks compare the kinds of word that carry the most risk, not the meaning of every word. *@
        <p class="sc-notice sc-notice--info"><span class="sc-notice__state">Translated from Spanish.</span> Check each English sentence against the Spanish beside it before you accept it. The automatic checks cover numbers, doses, units, dates, medicine names, sides, routes, how often, what changes and negations. They don't check the meaning of every word.</p>
    }
    <div class="sc-review">
        <section>
            <section class="sc-transcript" aria-labelledby="review-transcript">
                <div class="sc-transcript__head"><h2 class="sc-transcript__title" id="review-transcript">@(Model.Translated ? "Original transcript, in Spanish" : "Original transcript")</h2></div>
                @if (Model.Ambient && !Model.TranscriptKept)
                {
                    <div class="sc-transcript__body" data-dictation-transcript><p class="sc-transcript__placeholder" data-ambient-transcript-gone>@(Model.Review.State == AiReviewStates.Pending ? NoteReviews.TranscriptGone(Keep) : "This visit's transcript was deleted when its review was finished. Each proposal shows who said the words it came from.")</p></div>
                }
                else if (Model.Ambient && Model.DecideAtTheClinic)
                {
                    <div class="sc-transcript__body" data-dictation-transcript><p class="sc-transcript__placeholder">The conversation can be read only at the clinic.</p></div>
                }
                else
                {
                    <div class="sc-transcript__body" data-dictation-transcript lang="@(Model.Translated ? "es" : null)"><p>@(Model.Ambient ? Model.ConversationText : Model.Result?.Transcript.Text)</p></div>
                }
                <p class="sc-transcript__note" data-dictation-unclear hidden>Marked passages were unclear. Check them before approving.</p>
            </section>
            <p class="sc-status" data-dictation-sort-message></p>
            <section class="sc-notice sc-notice--warning" data-dictation-not-carried hidden>
                <h3>Not carried over</h3>
                <p>@(Model.Ambient ? "This draft" : "Dictation") doesn't propose these. Place any that still apply yourself, in their usual forms.</p>
                <ul data-dictation-not-carried-list></ul>
            </section>
        </section>
        <section>
            <h2>Proposed fields</h2>
            <dl class="sc-proposals">
                @foreach (var field in Model.FieldNames)
                {
                    var proposal = Model.Proposals.SingleOrDefault(p => p.Field == field);
                    <div class="sc-proposal" data-dictation-field="@field" data-proposal-id="@proposal?.Id" data-review-state="@proposal?.State">
                        <dt class="sc-proposal__head"><span class="sc-proposal__field">@FieldLabel(field)</span> <span class="@StateTone(proposal?.State)" data-field-status>@StateWords(proposal?.State)</span></dt>
                        <dd data-field-value>@if (Model.Statements(field).ToList() is { Count: > 0 } statements)
                        {
                            // From a dictation in Spanish (step 17), each English sentence beside the Spanish it was translated
                            // from (docs/brand: Translated sentences), each saying it is a translation to check, warning or not,
                            // so none reads as checked for having no warning; otherwise the value as proposed.
                            <ol class="sc-translation">
                                @foreach (var (english, spanish) in statements)
                                {
                                    <li class="sc-translation__pair"><p class="sc-translation__check">@ReviewModel.TranslatedSentence</p><p class="sc-translation__english">@english</p><p class="sc-translation__spanish">You said: <span lang="es">“@spanish”</span></p></li>
                                }
                            </ol>
                        }
                        else { @proposal?.OriginalValue }</dd>
                        @if (proposal is { State: AiProposalStates.Pending } && !Model.Signed && !Model.DecideAtTheClinic)
                        {
                            <dd class="sc-proposal__controls" data-review-controls>
                                <form method="post" asp-page-handler="Decide" data-review-submit>
                                    <input type="hidden" name="Version" value="@Model.Draft.Version" />
                                    <input type="hidden" name="ProposalId" value="@proposal.Id" />
                                    <input type="hidden" name="DecisionKey" value="@(Model.ProposalId == proposal.Id && Model.DecisionKey != Guid.Empty ? Model.DecisionKey : Guid.NewGuid())" />
                                    <div class="sc-actions">
                                        @if (!Model.TranscriptGone)
                                        {
                                            <button class="sc-btn" name="Decision" value="accepted">@(Model.Translated ? "Accept translated" : "Accept") @field</button>
                                        }
                                        <button class="sc-btn" name="Decision" value="rejected">Reject @field</button>
                                    </div>
                                    <details>
                                        <summary>Edit @field</summary>
                                        <div class="sc-stack">
                                            <div class="sc-field sc-field--wide">
                                                <label for="edited-@field">Corrected @field</label>
                                                @* Step 16: with a visit's transcript gone, the words offered can't go in as they are, so they aren't
                                                   offered here ready to approve. *@
                                                @if (Model.TranscriptGone)
                                                {
                                                    <p class="sc-field__hint" id="edited-@field-hint" data-ambient-own-note>Write it as your own note: with the visit's transcript deleted, the words offered can't go in as they are.</p>
                                                }
                                                <textarea id="edited-@field" class="sc-field__input" name="EditedValue" rows="5" aria-describedby="@(Model.TranscriptGone ? $"edited-{field}-hint" : null)">@(Model.ProposalId == proposal.Id ? Model.EditedValue : Model.TranscriptGone ? "" : proposal.OriginalValue)</textarea>
                                            </div>
                                            <div class="sc-actions"><button class="sc-btn" name="Decision" value="edited">Approve edited @field</button></div>
                                        </div>
                                    </details>
                                </form>
                            </dd>
                        }
                        <dd class="sc-proposal__approved" data-approved-value>@(proposal?.State == AiProposalStates.Rejected ? "Rejected. Nothing from it will be added." : proposal?.ApprovedValue)</dd>
                    </div>
                }
            </dl>
            @* The expansion plan's step 15: what the dictation proposes beyond the note, each in the clinician's words as heard,
               with what was heard after it (step 15.1, so a retraction the service's rules don't read is in view beside the
               button, as said and never judged), opened in its form, where it is signed or saved through every check of that
               form, or dismissed here. None holds up this review or signing. *@
            @if (Model.ChartProposals.Count > 0)
            {
                <section data-chart-proposals aria-labelledby="chart-proposals">
                    <h2 id="chart-proposals" tabindex="-1" autofocus="@(Model.Decided is not null && Model.NextProposal is null)">Proposed orders and allergies</h2>
                    <div class="sc-prose">
                        <p>Proposed from what you said. Dictation doesn't place or save any of them.</p>
                        <ul>
                            <li>Open each in its form to check every field, then sign or save it there. Or dismiss it.</li>
                            <li>Each shows what you said after it, in case you corrected it.</li>
                            <li>They don't hold up this review or signing the note.</li>
                        </ul>
                    </div>
                    @if (!OnPrem.IsReachable)
                    {
                        <p class="sc-muted" data-chart-proposals-offline>Opening or dismissing a proposal needs the clinic's server. The review remains readable.</p>
                    }
                    <ol class="sc-proposals">
                        @foreach (var proposed in Model.ChartProposals)
                        {
                            var row = proposed.Row;
                            <li class="sc-proposal" data-chart-proposal="@row.Id" data-review-state="@row.State" data-chart-proposal-start="@proposed.Start" data-chart-proposal-end="@proposed.End">
                                <p class="sc-proposal__head"><span class="sc-proposal__field">@proposed.KindWords</span> <span class="@(proposed.Waiting ? "sc-tag sc-tag--warning" : row.State == AiChartProposalStates.Dismissed ? "sc-tag" : "sc-tag sc-tag--success")" data-chart-proposal-state>@proposed.StateWords</span></p>
                                <p class="sc-proposal__value" data-chart-proposal-words><span class="sc-proposal__field">As heard:</span> @proposed.Before<mark class="sc-transcript__source">@proposed.Words</mark>@proposed.After</p>
                                @if (proposed.HeardAfter.Length > 0)
                                {
                                    <p class="sc-proposal__value" data-chart-proposal-heard-after><span class="sc-proposal__field">Heard after it:</span> @proposed.HeardAfter</p>
                                }
                                @* Its warnings only while it waits: once decided, there is nothing left to check them for. *@
                                @if (proposed.Waiting)
                                {
                                    foreach (var warning in proposed.Warnings)
                                    {
                                        <p class="sc-proposal__warning">Check: @ProposedFromDictation.WarningWords(warning.Code) “@warning.Said”</p>
                                    }
                                }
                                @if (row.DecidedAt is { } decidedAt)
                                {
                                    @* What it was decided into, on the chart: the order signed for it, or the allergy added. Only the
                                       proposal's own clinician reads its review (row-level security). *@
                                    var made = row.OrderId is { } order ? $"order-{order}" : row.AllergyId is { } allergy ? $"allergy-{allergy}" : null;
                                    <p class="sc-proposal__message">
                                        @proposed.StateWords @Clinic.Format(decidedAt).
                                        @if (made is not null)
                                        {
                                            <a asp-page="/Patients/Chart" asp-route-id="@Model.Patient.Id" asp-fragment="@made" data-chart-proposal-made>@(row.OrderId is not null ? "See the order on the chart" : "See the allergy on the chart")</a>
                                        }
                                    </p>
                                }
                                else if (OnPrem.IsReachable)
                                {
                                    var first = Model.NextProposal == row.Id;
                                    <div class="sc-actions">
                                        @if (proposed.IsOrder)
                                        {
                                            <a class="sc-btn" asp-page="/Patients/Orders/New" asp-route-id="@Model.Patient.Id" asp-route-proposal="@row.Id" autofocus="@first" data-open-proposal>Open in the order form</a>
                                        }
                                        else
                                        {
                                            <a class="sc-btn" asp-page="/Patients/Lists/Entry" asp-route-id="@Model.Patient.Id" asp-route-list="allergies" asp-route-proposal="@row.Id" autofocus="@first" data-open-proposal>Open in the allergy form</a>
                                        }
                                        <form method="post" asp-page-handler="DismissProposal">
                                            <input type="hidden" name="ChartProposalId" value="@row.Id" />
                                            <button class="sc-btn sc-btn--quiet">Dismiss proposal</button>
                                        </form>
                                    </div>
                                }
                            </li>
                        }
                    </ol>
                </section>
            }
            else if (Model.Translated)
            {
                @* The expansion plan's step 17: nothing is proposed beyond the note from a dictation in Spanish. *@
                <section data-chart-proposals-none aria-labelledby="chart-proposals">
                    <h2 id="chart-proposals">Proposed orders and allergies</h2>
                    <p class="sc-prose">A dictation in Spanish never proposes orders or allergy changes. Any you dictated are listed under “Not carried over”, for you to place yourself.</p>
                </section>
            }
        </section>
    </div>
    <details>
        <summary>The saved note, to compare before adding approved values</summary>
        <partial name="_NoteContent" model="NoteSections.AsSaved(Model.Draft)" />
    </details>
    @if (Model.Ambient && Model.Review.State == AiReviewStates.Pending && !Model.Signed && !Model.DecideAtTheClinic && Model.Proposals.Any(p => p.State == AiProposalStates.Pending))
    {
        @* For a patient who withdraws their consent after the visit: nothing goes into the note, and the transcript goes. *@
        <form method="post" asp-page-handler="RejectAll" class="sc-form sc-form--wide" data-ambient-reject-all>
            <input type="hidden" name="Version" value="@Model.Draft.Version" />
            <button class="sc-btn sc-btn--danger sc-btn--wraps">Reject every proposal and delete the conversation</button>
        </form>
    }
    @if (Model.Review.State == AiReviewStates.Pending && !Model.Signed && !Model.DecideAtTheClinic)
    {
        <form method="post" asp-page-handler="Complete" class="sc-form sc-form--wide" data-review-submit data-review-complete>
            <input type="hidden" name="Version" value="@Model.Draft.Version" />
            <label class="sc-check"><input type="checkbox" name="Append" value="true" /> Keep text already in a field and add the approved value after it.</label>
            <button class="sc-btn sc-btn--primary" disabled="@(Model.Proposals.Any(p => p.State == AiProposalStates.Pending))">Add approved fields and continue to note</button>
        </form>
    }
    else if (Model.Review.State != AiReviewStates.Recording || Model.Signed)
    {
        <p><a asp-page="Edit" asp-route-patientId="@Model.Patient.Id" asp-route-draftId="@Model.Draft.Id">Continue to note</a></p>
    }
</section>
<script src="~/_content/Ehr.Design/js/dictation-view.js" defer></script>
<script src="~/_content/Ehr.Design/js/note-review.js" defer></script>
