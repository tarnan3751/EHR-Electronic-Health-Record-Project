@page "/patients/{id:guid}"
@model ChartModel
@{
    ViewData["Title"] = $"{Model.Patient.FamilyName}, {Model.Patient.GivenName}";
}
<h1>@Model.Patient.FamilyName, @Model.Patient.GivenName @if (Model.OnPanel) { <span class="tag">Yours</span> }</h1>
@if (Model.EmergencyUntil is { } until)
{
    <p class="notice">Emergency access: this patient is not on your panel. Your access and the reason you gave are recorded for review. It lasts until @until.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC.</p>
}
<dl class="record">
    <dt>MRN</dt><dd>@Model.Patient.Mrn</dd>
    <dt>Born</dt><dd>@Model.Patient.BirthDate.ToString("yyyy-MM-dd")</dd>
    <dt>Gender</dt><dd>@Model.Patient.Gender</dd>
</dl>
<div class="actions">
    @if (Model.OnPanel)
    {
        <form method="post" asp-page-handler="Unassign">
            <button>Remove from my patients</button>
        </form>
    }
    else
    {
        <form method="post" asp-page-handler="Assign">
            <button>Add to my patients</button>
        </form>
    }
</div>

<h2>Patient portal</h2>
@if (Model.EnrollmentCode is { } code)
{
    <section class="notice">
        <p>Give the patient this code. It lets them register for the portal once, within 14 days, and isn't shown again.</p>
        <p class="code">@code</p>
    </section>
}
else
{
    <form method="post" asp-page-handler="Enroll">
        <button>Issue an enrollment code</button>
    </form>
}
