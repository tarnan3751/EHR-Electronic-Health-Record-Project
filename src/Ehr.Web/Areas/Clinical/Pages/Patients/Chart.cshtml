@page "/patients/{id:guid}"
@using Ehr.Data.Patients
@model ChartModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@inject Ehr.Domain.Notes.NoteWriteAuthority NoteWrites
@inject Ehr.Web.Ambient.AmbientListening Listening
@{
    // This chart uses native forms. Avoid htmx's automatic patient-URL sessionStorage history.
    ViewData["UseHtmx"] = false;
    ViewData["Title"] = $"{Model.Patient.FamilyName}, {Model.Patient.GivenName}";
}
@section Scripts {
    @if (Model.OnPanel && OnPrem.IsReachable)
    {
        <script src="~/_content/Ehr.Design/js/orders.js" defer></script>
    }
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Chart.Allergies, Model.OnPanel, Model.EmergencyUntil, Title: true)" />
}
<div class="sc-pagehead">
    <p><partial name="_BackToSearch" model="Model.Search" /></p>
    @* Off-site with the clinic's server down nothing can be saved, so no change is offered (UC 2). *@
    <div class="sc-actions">
        @if (!OnPrem.IsReachable)
        {
            <p class="sc-muted">Your patients can't be changed until the clinic's server is back.</p>
        }
        else if (Model.OnPanel)
        {
            <form method="post" asp-page-handler="Unassign" asp-all-route-data="Model.Search.RouteData()">
                <button class="sc-btn">Remove from my patients</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Assign" asp-all-route-data="Model.Search.RouteData()">
                <button class="sc-btn">Add to my patients</button>
            </form>
        }
    </div>
</div>
@if (Model.EmergencyUntil is { } until)
{
    <p class="sc-notice sc-notice--danger"><span class="sc-notice__state">Emergency access:</span> this patient is not on your panel. Your access and the reason you gave are recorded for review. It lasts until @Clinic.Format(until).</p>
}
@if (Model.Chart.FormToReview)
{
    @* Step 13e: a pre-visit form in this clinician's inbox has an answer to review. No questionnaire, answer or score. *@
    <p class="sc-notice sc-notice--danger" data-form-review><span class="sc-notice__state">Needs review.</span> A pre-visit form has an answer for you to review. <a asp-page="Forms/Index" asp-route-patientId="@Model.Patient.Id" asp-route-sensitive="true">Open pre-visit forms</a></p>
}
@* The notices after an action take the focus (data-focus-on-load, js/patient-search.js), so the keyboard and a
   screen reader start from what just happened. *@
@if (Model.Chart.ConfirmsDiscontinued)
{
    <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load><span class="sc-notice__state">Order discontinued.</span> <strong>@Model.Chart.DiscontinuedName</strong> is under discontinued orders.</p>
}
@if (Model.SignedOrder is { } signed && Model.Chart.ReplacedName is { } replaced)
{
    <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load><span class="sc-notice__state">Order changed.</span> <strong>@signed.Display</strong> replaces <strong>@replaced</strong>, signed @Clinic.Format(signed.SignedAt). The old order is under discontinued orders.</p>
}
else if (Model.SignedOrder is { } newOrder)
{
    <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load><span class="sc-notice__state">Order signed.</span> <strong>@newOrder.Display</strong> is under active orders, signed @Clinic.Format(newOrder.SignedAt).</p>
}
@* After the entry form saved an entry. A sensitive one the chart leaves out isn't named: the notice says where it is. *@
@if (Model.Chart.Saved is { Hidden: true } hiddenSave)
{
    <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load data-saved><span class="sc-notice__state">Saved.</span> The @Ehr.Domain.Patients.ChartListWords.Lists[hiddenSave.Table].One is sensitive, so it's hidden with the other sensitive items.</p>
}
else if (Model.Chart.Saved is { } saved)
{
    <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load data-saved><span class="sc-notice__state">Saved.</span> <strong>@saved.Display</strong>@ChartModel.SavedWhere(saved)</p>
}
@switch (Model.NoKnownAllergiesNotice)
{
    case "saved":
        <p class="sc-notice sc-notice--success" role="status" tabindex="-1" data-focus-on-load data-saved><span class="sc-notice__state">Saved.</span> This patient has no known allergies.</p>
        break;
    case "allergy-recorded":
        <p class="sc-notice sc-notice--danger" role="alert" tabindex="-1" data-focus-on-load data-not-saved><span class="sc-notice__state">Not saved.</span> This patient has an allergy on record, listed below.</p>
        break;
    case "refused":
        <p class="sc-notice sc-notice--danger" role="alert" tabindex="-1" data-focus-on-load data-not-saved><span class="sc-notice__state">Not saved.</span> You can't change this patient's allergies now.</p>
        break;
}

@* Sensitive diagnoses and medications aren't sent with the chart until the clinician asks, and the asking is recorded. *@
@{
    var sensitiveRoute = Model.Search.RouteData();
    sensitiveRoute["id"] = Model.Patient.Id.ToString();
    // While sensitive items are shown, the history shows them too, as the next view the clinician asked for.
    var historyRoute = new Dictionary<string, string>(sensitiveRoute);
    if (Model.Chart.SensitiveShown)
    {
        historyRoute["sensitive"] = "true";
    }
}
@if (Model.Chart.SensitiveShown)
{
    <p class="sc-notice sc-notice--info" data-sensitive="shown"><span class="sc-notice__state">Sensitive items shown:</span> your view of them is recorded. <a asp-page="Chart" asp-all-route-data="sensitiveRoute">Hide sensitive items</a></p>
}
else if (Model.Chart.SensitiveHidden > 0 || Model.Chart.SensitiveNotesHidden > 0)
{
    sensitiveRoute["sensitive"] = "true";
    @* Step 10: signed notes marked sensitive are counted beside the sensitive diagnoses and medications. *@
    var hiddenLists = Model.Chart.SensitiveHidden == 0 ? "" : $"{Model.Chart.SensitiveHidden} {(Model.Chart.SensitiveHidden == 1 ? "diagnosis or medication is" : "diagnoses or medications are")} not shown. ";
    var hiddenNotes = Model.Chart.SensitiveNotesHidden == 0 ? "" : $"{Model.Chart.SensitiveNotesHidden} signed {(Model.Chart.SensitiveNotesHidden == 1 ? "note is" : "notes are")} not shown. ";
    <p class="sc-notice sc-notice--info" data-sensitive="hidden"><span class="sc-notice__state">Sensitive items hidden:</span> @hiddenLists@hiddenNotes<a asp-page="Chart" asp-all-route-data="sensitiveRoute">Show sensitive items</a></p>
}
<p><a asp-page="Lists/History" asp-all-route-data="historyRoute">History of allergies, medications and diagnoses</a></p>

<div class="sc-chart">
    @* Allergies, medications and diagnoses: added and changed for a patient on the clinician's panel while the clinic's
       server can be reached (Lists/Entry). Nothing is deleted; an entry that no longer applies gets another status. *@
    <section class="sc-panel" aria-labelledby="chart-allergies">
        <h2 class="sc-panel__title" id="chart-allergies">Allergies</h2>
        @{ AddLink("allergies", "Add allergy"); }
        @if (Model.KnownAllergies.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var allergy in Model.KnownAllergies)
                {
                    <li id="allergy-@allergy.Id">
                        <strong>@allergy.Display</strong>@if (allergy.Reaction is { } reaction) { <text>: @reaction</text> }
                        @if (allergy.Criticality == AllergyCriticality.High)
                        {
                            <span class="sc-tag sc-tag--danger">High risk</span>
                        }
                        @{ EditLink("allergies", allergy.Id, allergy.Display); }
                    </li>
                }
            </ul>
        }
        else if (Model.NoKnownAllergies is { } none)
        {
            <p>No known allergies (recorded @Clinic.Day(none.RecordedAt)@(Model.Chart.NoKnownAllergiesRecordedBy is { } recorder ? $" by {recorder}" : "")).</p>
        }
        else
        {
            <p class="sc-muted">No allergy information recorded.</p>
            @if (Model.OnPanel && OnPrem.IsReachable)
            {
                @* Asked and none: recorded as an entry of its own, which adding an allergy later clears. *@
                <form method="post" asp-page-handler="NoKnownAllergies" asp-all-route-data="Model.SensitiveRouteData()">
                    <button class="sc-btn sc-btn--compact" data-no-known-allergies>Record no known allergies</button>
                </form>
            }
        }
    </section>

    <section class="sc-panel" aria-labelledby="chart-medications">
        <h2 class="sc-panel__title" id="chart-medications">Medications</h2>
        @{ AddLink("medications", "Add medication"); }
        @if (Model.Chart.Medications.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var medication in Model.Chart.Medications)
                {
                    <li>
                        <strong>@medication.Display</strong>@if (medication.Dosage is { } dosage) { <text>: @dosage</text> }
                        @if (medication.Sensitive)
                        {
                            <span class="sc-tag sc-tag--warning">Sensitive</span>
                        }
                        @{ EditLink("medications", medication.Id, medication.Display); }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">No active medications.</p>
        }
    </section>

    <section class="sc-panel" aria-labelledby="chart-diagnoses">
        <h2 class="sc-panel__title" id="chart-diagnoses">Diagnoses</h2>
        @{ AddLink("diagnoses", "Add diagnosis"); }
        @if (Model.Chart.Conditions.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var condition in Model.Chart.Conditions)
                {
                    <li>
                        <strong>@condition.Display</strong>
                        @if (condition.Code is { } diagnosisCode) { <text>(@diagnosisCode)</text> }
                        @if (condition.OnsetDate is { } onset) { <text> since @onset.ToString("yyyy-MM-dd")</text> }
                        @if (condition.Sensitive)
                        {
                            <span class="sc-tag sc-tag--warning">Sensitive</span>
                        }
                        @{ EditLink("diagnoses", condition.Id, condition.Display); }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">No active diagnoses.</p>
        }
    </section>

    <section class="sc-panel" aria-labelledby="chart-notes">
        <h2 class="sc-panel__title" id="chart-notes">Clinical notes</h2>
        @* UC 9 and UC 10: dictate a note for this patient, offered as "New note" is: for a patient on the clinician's panel,
           while the clinic's server can be reached. Nothing is saved there yet. The patient and the search travel in one
           dictionary, since asp-all-route-data replaces asp-route-*. *@
        @{
            var dictateRoute = Model.Search.RouteData();
            dictateRoute["id"] = Model.Patient.Id.ToString();
        }
        @if (Model.OnPanel && OnPrem.IsReachable)
        {
            <div class="sc-actions">
                <form method="post" asp-page-handler="NewNote"><button class="sc-btn sc-btn--compact">New note</button></form>
                <a asp-page="Dictate" asp-all-route-data="dictateRoute" class="sc-btn sc-btn--compact" data-dictate-link>Dictate a note</a>
                @* Step 16: listening to a visit, when the clinic has it switched on, at the clinic only, and not in what the
                   cloud app forwards here. *@
                @if (Listening.Enabled && Ehr.Web.Forwarding.ClinicNetwork.AtTheClinic(HttpContext.Request, NoteWrites))
                {
                    <a asp-page="Listen" asp-all-route-data="dictateRoute" class="sc-btn sc-btn--compact" data-listen-link>Listen to the visit</a>
                }
            </div>
        }
        else if (!Model.OnPanel)
        {
            <p class="sc-muted">To write a note, add this patient to My patients.</p>
        }
        else
        {
            <p class="sc-muted">New notes and signing need the clinic's server. Saved notes remain readable.</p>
        }
        @if (Model.Drafts.Count > 0)
        {
            <h3>Your drafts</h3>
            <ul class="sc-list">
                @foreach (var draft in Model.Drafts)
                {
                    <li><a asp-page="Notes/Edit" asp-route-patientId="@Model.Patient.Id" asp-route-draftId="@draft.Id">Open draft</a> · version @draft.Version · unsigned</li>
                }
            </ul>
        }
        @if (Model.Notes.Count > 0)
        {
            <h3>Signed notes</h3>
            <ul class="sc-list">
                @foreach (var note in Model.Notes)
                {
                    <li><a asp-page="Notes/View" asp-route-patientId="@Model.Patient.Id" asp-route-noteId="@note.Id">Signed note · @Clinic.Format(note.SignedAt)</a>@if (note.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning">Sensitive</span> }@if (note.SummaryReleased) { <text> </text><span class="sc-tag" data-summary-released>Summary released</span> }</li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">@(Model.Chart.SensitiveNotesHidden > 0 ? "No other signed notes." : "No signed notes.")</p>
        }
    </section>

    @* UC 1 Place an order (Tahseen Arnan): offered as "New note" is, for a patient on the clinician's panel while the clinic's
       server can be reached. Alt+Shift+O follows the link (js/orders.js). The list is part of the chart's one recorded read. *@
    <section class="sc-panel" aria-labelledby="chart-orders">
        <h2 class="sc-panel__title" id="chart-orders">Orders</h2>
        @if (Model.OnPanel && OnPrem.IsReachable)
        {
            var orderRoute = Model.Search.RouteData();
            orderRoute["id"] = Model.Patient.Id.ToString();
            <p class="sc-actions">
                <a asp-page="Orders/New" asp-all-route-data="orderRoute" class="sc-btn sc-btn--compact" data-new-order aria-keyshortcuts="Alt+Shift+O">New order <kbd class="sc-kbd" aria-hidden="true">Alt+Shift+O</kbd></a>
            </p>
        }
        else if (!Model.OnPanel)
        {
            <p class="sc-muted">To place an order, add this patient to My patients.</p>
        }
        else
        {
            <p class="sc-muted">New orders need the clinic's server. Active orders remain readable.</p>
        }
        <h3>Active orders</h3>
        @if (Model.Chart.Orders.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var order in Model.Chart.Orders)
                {
                    <li id="order-@order.Id">
                        <strong>@order.Display</strong> (@Ehr.Domain.Orders.OrderForms.TypeNames[order.Type])
                        @Ehr.Domain.Orders.OrderForms.Summary(order.Type, order.Details) · signed @Clinic.Format(order.SignedAt)
                        @if (Model.OnPanel && OnPrem.IsReachable)
                        {
                            @* A signed order is never edited: "Change" signs a new order in its place, and "Discontinue…"
                               asks for the reason first. Plain links, so Tab reaches them and Enter follows them. *@
                            var changeRoute = Model.Search.RouteData();
                            changeRoute["id"] = Model.Patient.Id.ToString();
                            changeRoute["type"] = order.Type;
                            changeRoute["replaces"] = order.Id.ToString();
                            var discontinueRoute = Model.Search.RouteData();
                            discontinueRoute["id"] = Model.Patient.Id.ToString();
                            discontinueRoute["orderId"] = order.Id.ToString();
                            <span class="sc-list__actions">
                                <a asp-page="Orders/New" asp-all-route-data="changeRoute" aria-label="Change: @order.Display" data-change-order>Change</a>
                                <a asp-page="Orders/Discontinue" asp-all-route-data="discontinueRoute" aria-label="Discontinue…: @order.Display" data-discontinue-order>Discontinue…</a>
                                @if (order.Type == Ehr.Data.Orders.OrderType.Lab)
                                {
                                    @* Step 7: where the lab's values are typed in, until the lab sends them itself. *@
                                    <a asp-page="Orders/Results" asp-route-patientId="@Model.Patient.Id" asp-route-orderId="@order.Id" aria-label="Enter results: @order.Display" data-enter-results>Enter results</a>
                                }
                            </span>
                        }
                    </li>
                }
            </ul>
            @if (Model.OnPanel && !OnPrem.IsReachable)
            {
                <p class="sc-muted">Changing or discontinuing an order needs the clinic's server.</p>
            }
        }
        else
        {
            <p class="sc-muted">No active orders.</p>
        }
        @{
            var discontinuedRoute = Model.Search.RouteData();
            discontinuedRoute["id"] = Model.Patient.Id.ToString();
        }
        <p><a asp-page="Orders/Discontinued" asp-all-route-data="discontinuedRoute">Discontinued orders</a></p>
    </section>

    @* Lab orders whose results are in (step 7), part of the chart's one recorded read: those still to acknowledge
       first, abnormal before the rest. Each opens its results. *@
    <section class="sc-panel" aria-labelledby="chart-results">
        <h2 class="sc-panel__title" id="chart-results">Results</h2>
        @if (Model.Chart.Resulted.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var resulted in Model.Chart.Resulted)
                {
                    <li data-resulted="@(resulted.Acknowledged ? "acknowledged" : "to-acknowledge")">
                        <a asp-page="Orders/Results" asp-route-patientId="@Model.Patient.Id" asp-route-orderId="@resulted.Id">@resulted.Display</a>
                        @if (resulted.Abnormal > 0)
                        {
                            <span class="sc-tag sc-tag--warning">Abnormal</span>
                        }
                        @if (!resulted.Acknowledged)
                        {
                            <span class="sc-tag sc-tag--info">To acknowledge</span>
                        }
                        @if (resulted.ResultedAt is { } at)
                        {
                            <span class="sc-muted">· @Clinic.Day(at)</span>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">No results yet.</p>
        }
    </section>

    @* Vital signs (step 9): the newest value of each sign, from the chart's one query of the patient's vital signs. Every set, the trends and recording are on the vital signs page. *@
    <section class="sc-panel" aria-labelledby="chart-vitals">
        <h2 class="sc-panel__title" id="chart-vitals">Vital signs</h2>
        @if (Model.Chart.LatestVitals.Count == 0)
        {
            <p class="sc-muted">No vital signs.</p>
        }
        else
        {
            @* A list, not a table: the panel is a third of the page. Short names, as on the entry form. *@
            <ul class="sc-list" data-latest-vitals>
                @foreach (var vital in Model.Chart.LatestVitals)
                {
                    <li>
                        @* A blood pressure is one reading (step 9c): one item, both numbers, flagged when either is outside its range, or a
                           child's at or above its screening value (step 9d). *@
                        <strong>@(vital.Diastolic is null ? Ehr.Domain.Results.VitalSigns.Name(vital.Code, vital.Display) : "Blood pressure")</strong>
                        @vital.Shown @Ehr.Domain.Results.Units.Shown(vital.Unit)
                        @foreach (var flag in vital.Flags)
                        {
                            <span class="sc-tag sc-tag--warning">@flag</span>
                        }
                        @* Up or down against the reading before it (step 9b), in a shape and in words. *@
                        @if (vital.Direction is { } direction)
                        {
                            <span class="sc-trendmark" data-direction="@direction"><span aria-hidden="true">@(direction == "up" ? "▲" : "▼")</span><span class="sc-visually-hidden">@direction from @vital.PreviousShown</span></span>
                        }
                        <span class="sc-muted">· @Clinic.Day(vital.TakenAt)</span>
                    </li>
                }
            </ul>
        }
        <p><a asp-page="Vitals/Index" asp-route-patientId="@Model.Patient.Id" data-vitals>Flowsheet, trends and recording</a></p>
    </section>

    @* Appointments still to come (FR-17), part of the chart's one recorded read; booked for a patient on the
       clinician's panel while the clinic's server can be reached. *@
    <section class="sc-panel" aria-labelledby="chart-appointments">
        <h2 class="sc-panel__title" id="chart-appointments">Appointments</h2>
        @if (Model.OnPanel && OnPrem.IsReachable)
        {
            var bookRoute = Model.Search.RouteData();
            bookRoute["id"] = Model.Patient.Id.ToString();
            <p class="sc-actions"><a asp-page="/Schedule/New" asp-all-route-data="bookRoute" class="sc-btn sc-btn--compact" data-book-appointment>Book appointment</a></p>
        }
        else if (Model.OnPanel)
        {
            <p class="sc-muted">Booking an appointment needs the clinic's server.</p>
        }
        @if (Model.Chart.Upcoming.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var appointment in Model.Chart.Upcoming)
                {
                    <li>
                        <strong>@Clinic.Format(appointment.StartsAt)</strong> · @appointment.Minutes minutes · @appointment.Clinician
                        <br>@appointment.Reason
                        <span class="sc-list__actions"><a asp-page="/Schedule/Appointment" asp-route-appointmentId="@appointment.Id" aria-label="Open appointment: @Clinic.Format(appointment.StartsAt)">Open</a></span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">No upcoming appointments.</p>
        }
    </section>

    @* Messages with the patient (FR-18): the conversations, latest first, read with the chart; a new one for a patient
       on the clinician's panel while the clinic's server can be reached. *@
    <section class="sc-panel" aria-labelledby="chart-messages">
        <h2 class="sc-panel__title" id="chart-messages">Messages</h2>
        @if (Model.OnPanel && OnPrem.IsReachable)
        {
            <p class="sc-actions"><a asp-page="Messages/New" asp-route-patientId="@Model.Patient.Id" class="sc-btn sc-btn--compact" data-new-message>New message</a></p>
        }
        else if (Model.OnPanel)
        {
            <p class="sc-muted">Messages can't be sent until the clinic's server is back.</p>
        }
        @if (Model.Threads.Count > 0)
        {
            <ul class="sc-list">
                @foreach (var thread in Model.Threads)
                {
                    <li>
                        <a asp-page="Messages/Thread" asp-route-patientId="@Model.Patient.Id" asp-route-threadId="@thread.Id">@thread.Subject</a>
                        @if (thread.Unread > 0)
                        {
                            <span class="sc-tag sc-tag--info">New</span>
                        }
                        <span class="sc-muted">· @Clinic.Day(thread.LastMessageAt)</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="sc-muted">No messages.</p>
        }
    </section>

    @* The patient's use of the portal: the code to register, who can use it for them, and the forms asked for before visits. *@
    <section class="sc-panel" aria-labelledby="chart-portal">
        <h2 class="sc-panel__title" id="chart-portal">Patient portal</h2>
        @if (Model.EnrollmentCode is { } code)
        {
            <section class="sc-notice sc-notice--info">
                <p>Give the patient this code to register for the portal. It works once, for 14 days, and isn't shown again.</p>
                <p class="mono-code">@code</p>
            </section>
        }
        else if (!OnPrem.IsReachable)
        {
            <p class="sc-muted">Enrollment codes can be issued once the clinic's server is back.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Enroll" asp-all-route-data="Model.Search.RouteData()">
                <button class="sc-btn sc-btn--compact">Issue an enrollment code</button>
            </form>
        }
        @* Who can use the portal for this patient (FR-19): on its own page, read when it is opened. *@
        <p><a asp-page="Proxies/Index" asp-route-patientId="@Model.Patient.Id" data-proxies>Who can use the portal for this patient</a></p>
        @* Step 13e: the forms asked for before visits, each a sensitive item, on their own page; only how many here. *@
        <p><a asp-page="Forms/Index" asp-route-patientId="@Model.Patient.Id" data-forms>Pre-visit forms@(Model.Chart.Forms > 0 ? $" ({Model.Chart.Forms})" : "")</a></p>
    </section>

    <section class="sc-panel sc-panel--wide" aria-labelledby="chart-visits">
        <h2 class="sc-panel__title" id="chart-visits">Recent visits</h2>
        @if (Model.Chart.Visits.Count > 0)
        {
            var latest = Model.Chart.Visits[0];
            <p class="latest-visit">
                Latest visit, @Clinic.Day(latest.PeriodStart):
                blood pressure @(Model.BloodPressure(latest) ?? "not taken"), heart rate @(Model.HeartRate(latest) ?? "not taken").
            </p>
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead>
                        <tr><th>Date</th><th>Reason</th><th>Blood pressure</th><th>Heart rate</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var visit in Model.Chart.Visits)
                        {
                            <tr>
                                <td class="sc-table__mono">@Clinic.Day(visit.PeriodStart)</td>
                                <td>@visit.Reason</td>
                                <td>@Model.BloodPressure(visit)</td>
                                <td>@Model.HeartRate(visit)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="sc-muted">No visits.</p>
        }
    </section>
</div>

@functions {
    // "Add ..." above a list, for a patient on the clinician's panel; off-site with the clinic's server down, a
    // sentence in its place.
    void AddLink(string list, string label)
    {
        if (Model.OnPanel && OnPrem.IsReachable)
        {
            // A plain link: a method like this one can't hold a tag helper.
            var route = Model.Search.ChartRouteValues(Model.Patient.Id);
            route["list"] = list;
            KeepSensitiveShown(route);
            <p class="sc-actions"><a href="@Url.Page("Lists/Entry", route)" class="sc-btn sc-btn--compact" data-add-entry="@list">@label</a></p>
        }
        else if (Model.OnPanel)
        {
            <p class="sc-muted">Changes to @list need the clinic's server.</p>
        }
    }

    // While sensitive items are shown, the entry form brings the clinician back to them (Lists/Entry's showSensitive).
    void KeepSensitiveShown(RouteValueDictionary route)
    {
        if (Model.Chart.SensitiveShown)
        {
            route["showSensitive"] = "true";
        }
    }

    // "Change" after an entry: a plain link, so Tab reaches it and Enter follows it.
    void EditLink(string list, Guid entry, string display)
    {
        if (Model.OnPanel && OnPrem.IsReachable)
        {
            var route = Model.Search.ChartRouteValues(Model.Patient.Id);
            route["list"] = list;
            route["entryId"] = entry;
            KeepSensitiveShown(route);
            <span class="sc-list__actions"><a href="@Url.Page("Lists/Entry", route)" aria-label="Change: @display" data-change-entry="@list">Change</a></span>
        }
    }
}
