@page "/patients/{id:guid}/dictate"
@model DictateModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    // This page's address carries the patient and the search the clinician came from. Without htmx, nothing keeps it
    // in the browser's sessionStorage history, as on the chart.
    ViewData["UseHtmx"] = false;
    ViewData["Title"] = $"Dictate: {Model.Patient.FamilyName}, {Model.Patient.GivenName}";
    // The patient and the search the clinician came from, in one dictionary: asp-all-route-data replaces asp-route-*.
    var chartRoute = Model.Search.RouteData();
    chartRoute["id"] = Model.Patient.Id.ToString();
}
@* UC 9 and UC 10 (Samir Mukshe): the screen for the dictation API. The markup is the page's skeleton; js/dictation.js
   fills it in from the API's answers, finding each part by its data-dictation-* attribute. *@
@section Scripts {
    @if (OnPrem.IsReachable)
    {
        <script src="~/_content/Ehr.Design/js/dictation-view.js" defer></script>
        <script src="~/_content/Ehr.Design/js/dictation.js" defer></script>
    }
}
@* The patient, in the banner under the app bar. This page reads no allergies, so the banner shows none. *@
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(Model.Patient, Model.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="Chart" asp-all-route-data="chartRoute" class="sc-back">Back to chart</a></p>
</div>
<h1>Dictate a note</h1>

@if (!OnPrem.IsReachable)
{
    @* The dictation service runs beside the on-prem app, so off-site with the clinic's server down there is nothing to
       send the audio to (UC 2). *@
    <p class="sc-notice sc-notice--warning" data-dictation-offline><span class="sc-notice__state">Dictation unavailable.</span></p>
}
else
{
    @* Without its settings (Ehr:Dictation:Url and ApiKey) every dictation is refused, so the page says so first, from
       what the on-prem app already holds; the cloud app doesn't hold it, and says nothing. Nothing else changes. *@
    @if (HttpContext.RequestServices.GetService(typeof(Ehr.Web.Api.Dictation.DictationSidecar)) is Ehr.Web.Api.Dictation.DictationSidecar { IsConfigured: false })
    {
        <p class="sc-notice sc-notice--warning" data-dictation-not-set-up><span class="sc-notice__state">Dictation unavailable.</span></p>
    }
    <section data-dictation data-dictation-api="@Ehr.Web.Api.Dictation.DictationApi.Path" data-patient-id="@Model.Patient.Id" data-draft-id="@Model.DraftId" data-draft-version="@Model.DraftVersion">
        @Html.AntiForgeryToken()
        <noscript><p class="sc-notice sc-notice--danger">Dictation needs JavaScript.</p></noscript>

        @* The controls and the transcript beside the proposed fields, each in its frame. *@
        <div class="sc-review">
        <div>
        <div class="sc-formcard sc-formcard--wide">
        @* The language of this dictation (the expansion plan's step 17): chosen for each, English first, and never
           remembered, by this page or the browser. js/dictation.js shows the hint when Spanish is chosen, and disables
           the choice while a dictation is under way. Spanish is labelled experimental (the owner's ruling of
           2026-11-25): in its choice's words, and with a tag at the head of its hint. *@
        <div class="sc-field">
            <label for="dictation-language">Language</label>
            <select id="dictation-language" class="sc-field__input" autocomplete="off" data-dictation-language>
                <option value="en" selected>English</option>
                <option value="es">Spanish, experimental (proposals in English)</option>
            </select>
            <p class="sc-field__hint" id="dictation-language-hint" data-dictation-language-hint hidden><span class="sc-tag sc-tag--warning">Experimental</span> The transcript stays in Spanish; the proposed note is in English.</p>
        </div>

        @* "Dictate" is the page's one primary button; its shortcut is printed on it (js/dictation.js binds it). While
           recording, the time left of the dictation's limit follows the buttons. Not a live region: it changes every
           second, and the status line under it says the few points worth hearing. *@
        <div class="sc-actions">
            <button type="button" class="sc-btn sc-btn--primary" data-dictation-start aria-keyshortcuts="Alt+Shift+D">Dictate <kbd class="sc-kbd" aria-hidden="true">Alt+Shift+D</kbd></button>
            <button type="button" class="sc-btn" data-dictation-stop disabled>Stop</button>
            <button type="button" class="sc-btn sc-btn--quiet" data-dictation-cancel disabled>Cancel</button>
            <span class="sc-timeleft" data-dictation-time-left hidden><span class="sc-timeleft__value" data-dictation-time-left-value></span> left</span>
        </div>
        <p class="sc-status" role="status" aria-live="polite" data-dictation-status>Select Dictate and speak your note.</p>
        @* At the limit, the script's words for it, until the dictation goes on to its review. *@
        <p class="sc-notice sc-notice--warning" data-dictation-limit hidden></p>
        <div class="sc-actions">
            <button type="button" class="sc-btn" data-dictation-review hidden>Retry saving proposals for review</button>
            <a data-dictation-manual hidden>Open the draft</a>
            <form method="post" asp-page="Chart" asp-page-handler="NewNote" asp-route-id="@Model.Patient.Id" data-dictation-new-manual><button class="sc-btn">New note</button></form>
        </div>
        </div>

        @* Not a live region: the script rebuilds the transcript every second, and a screen reader would read all of it again
           each time. The status line above announces what changes. *@
        <section class="sc-transcript" aria-labelledby="dictation-transcript">
            <div class="sc-transcript__head">
                <h2 class="sc-transcript__title" id="dictation-transcript">Transcript</h2>
                <span class="sc-transcript__rec" data-dictation-recording hidden>Recording</span>
            </div>
            <div class="sc-transcript__body" data-dictation-transcript><p class="sc-transcript__placeholder">Your words appear here as you speak.</p></div>
            <p class="sc-transcript__note" data-dictation-unclear hidden>Highlighted passages may be wrong. Say them again, or correct them during review.</p>
        </section>
        </div>

        <div class="sc-sheet">
        <h2>Proposed fields</h2>
        <p class="sc-status" data-dictation-sort-message></p>
        <dl class="sc-proposals">
            @foreach (var (key, label) in new[] { ("subjective", "Subjective"), ("objective", "Objective"), ("assessment", "Assessment"), ("plan", "Plan") })
            {
                <div class="sc-proposal" data-dictation-field="@key">
                    <dt class="sc-proposal__head"><span class="sc-proposal__field">@label</span> <span class="sc-tag" data-field-status>Not dictated yet</span></dt>
                    <dd data-field-value></dd>
                </div>
            }
        </dl>

        <section class="sc-notice sc-notice--warning" data-dictation-not-carried hidden>
            <h3>Orders and allergy changes you dictated</h3>
            <p>Dictation never places orders or changes allergies. Place any not marked proposed yourself.</p>
            <ul data-dictation-not-carried-list></ul>
        </section>
        </div>
        </div>
    </section>
}
