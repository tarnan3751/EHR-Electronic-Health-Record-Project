@page "/patients"
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Patients";
}
<h1>Patients</h1>
@* A plain GET: it works without JavaScript and off-site from the replica, and the results' links carry the criteria
   back from the chart. The fields' names are the query string's. *@
<form method="get" class="search-form" role="search">
    <label>Name <input type="search" name="name" value="@Model.Search.Name" autocomplete="off" autofocus></label>
    <label>Date of birth <input type="date" name="birthdate" value="@Model.Search.Birthdate" max="@IndexModel.LatestBirthDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"></label>
    <label>MRN <input type="search" name="mrn" value="@Model.Search.Mrn" autocomplete="off"></label>
    <button>Search</button>
    <a asp-page="Index" class="button">Clear</a>
</form>
<div id="search-results">
    <partial name="_SearchResults" model="Model" />
</div>
