@page "/patients"
@model IndexModel
@{
    ViewData["Title"] = "Patients";
}
<h1>Patients</h1>
<form method="get" class="search-form">
    <label>Name or MRN <input asp-for="Q" type="search" autocomplete="off" autofocus></label>
    <button>Search</button>
</form>
@if (Model.Q is { Length: > 0 })
{
    <h2>Search results</h2>
    @if (Model.Results.Count == 0)
    {
        <p>No patients match.</p>
    }
    else
    {
        <partial name="_PatientTable" model="new PatientTable(Model.Results, Model.Panel, MarkPanel: true)" />
    }
}
else
{
    <h2>My patients</h2>
    @if (Model.PanelPatients.Count == 0)
    {
        <p>No patients are on your panel yet. Search for a patient and add them from the chart.</p>
    }
    else
    {
        <partial name="_PatientTable" model="new PatientTable(Model.PanelPatients, Model.Panel, MarkPanel: false)" />
    }
}
