@page "/patients/{id:guid}/reason"
@using Ehr.Domain.Patients
@model ReasonModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["UseHtmx"] = false;
    ViewData["Title"] = "Break the glass";
}
<h1>Break the glass</h1>
@if (!OnPrem.IsReachable)
{
    @* Off-site with the clinic's server down, the grant couldn't be saved (UC 2). *@
    <p class="sc-prose">Not one of your patients. Breaking the glass needs the clinic's server.</p>
}
else
{
    @* The one thing to do first, then what follows from it as a short list, and the reason: one task, in one card. *@
    <div class="sc-formcard sc-formcard--wide">
    <div class="sc-prose">
        <p>Not one of your patients.</p>
        <ul>
            <li>Access is audited and lasts @BreakGlass.Duration.TotalHours hours.</li>
            <li>The patient can see this access in the portal.</li>
        </ul>
    </div>
    @* No action: the form posts to this page's own address, the search's criteria included. *@
    <form method="post" class="sc-form">
        <div class="sc-field">
            <label asp-for="Reason" class="sc-field__label">Reason</label>
            <textarea asp-for="Reason" class="sc-field__input" rows="3" required autofocus></textarea>
            <span asp-validation-for="Reason" class="sc-field__error"></span>
        </div>
        <button class="sc-btn sc-btn--primary">Break the glass</button>
    </form>
    </div>
}
<p><partial name="_BackToSearch" model="Model.Search" /></p>
