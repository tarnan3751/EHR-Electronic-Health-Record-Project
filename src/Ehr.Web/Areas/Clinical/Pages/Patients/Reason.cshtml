@page "/patients/{id:guid}/reason"
@using Ehr.Domain.Patients
@model ReasonModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["UseHtmx"] = false;
    ViewData["Title"] = "Emergency access";
}
<h1>Emergency access</h1>
@if (!OnPrem.IsReachable)
{
    @* Off-site with the clinic's server down, the grant couldn't be saved (UC 2). *@
    <p class="sc-prose">Not one of your patients. Emergency access can't be granted until the clinic's server is back.</p>
}
else
{
    @* The one thing to do first, then what follows from it as a short list, and the reason: one task, in one card. *@
    <div class="sc-formcard sc-formcard--wide">
    <div class="sc-prose">
        <p>Not one of your patients. To open the chart, say why you need it, in @BreakGlass.MinimumReasonLength to @BreakGlass.MaximumReasonLength characters.</p>
        <ul>
            <li>Your access and your reason are logged and reviewed.</li>
            <li>The chart stays open to you for @BreakGlass.Duration.TotalHours hours.</li>
            <li>The patient, and anyone they share sensitive items with, can see in the portal that you used emergency access, and when. They never see your reason.</li>
        </ul>
    </div>
    @* No action: the form posts to this page's own address, the search's criteria included. *@
    <form method="post" class="sc-form">
        <div class="sc-field">
            <label asp-for="Reason" class="sc-field__label">Reason</label>
            <textarea asp-for="Reason" class="sc-field__input" rows="3" required autofocus></textarea>
            <span asp-validation-for="Reason" class="sc-field__error"></span>
        </div>
        <button class="sc-btn sc-btn--primary">Open the chart</button>
    </form>
    </div>
}
<p><partial name="_BackToSearch" model="Model.Search" /></p>
