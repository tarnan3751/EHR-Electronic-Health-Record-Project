@page "/patients/{id:guid}/orders/new"
@using Ehr.Data.Patients
@using Ehr.Domain.Orders
@model Ehr.Web.Areas.Clinical.Pages.Patients.Orders.NewModel
@{
    // The address carries the patient. Without htmx, nothing keeps it in the browser's sessionStorage history.
    ViewData["UseHtmx"] = false;
    var patient = Model.Form.Patient;
    var replaced = Model.Form.Replaced;
    var heading = replaced is null ? "New order" : "Change order";
    ViewData["Title"] = $"{heading}: {patient.FamilyName}, {patient.GivenName}";
}
@* UC 1 Place an order (Tahseen Arnan). js/orders.js posts the form with fetch, and keeps it filled when the clinic's
   server can't be reached; without JavaScript it posts as a normal form. *@
@section Scripts {
    <script src="~/_content/Ehr.Design/js/orders.js" defer></script>
    @* The item's list starts with the clinic's common items; the rest of the catalog comes as the clinician types. *@
    <script src="~/_content/Ehr.Design/js/code-search.js" defer></script>
}
@section Banner {
    <partial name="_PatientBanner" model="new PatientBanner(patient, Model.Form.Allergies)" />
}
<div class="sc-pagehead">
    <p><a asp-page="/Patients/Chart" asp-all-route-data="Model.ChartLink">Back to the chart</a></p>
</div>
<h1>@heading: @patient.FamilyName, @patient.GivenName</h1>

@if (replaced is null && Model.Form.Refill is null)
{
<nav aria-label="Type of order">
    <ul class="sc-tabs">
        @foreach (var (type, name) in OrderForms.TypeNames)
        {
            var route = Model.Search.RouteData();
            route["id"] = patient.Id.ToString();
            route["type"] = type;
            <li><a asp-page="New" asp-all-route-data="route" aria-current="@(type == Model.KnownType ? "page" : null)">@name</a></li>
        }
    </ul>
</nav>
}

@if (Model.KnownType is not { } selected)
{
    <p class="sc-muted">Choose the type of order.</p>
}
else
{
    <form method="post" class="sc-form" data-order-form>
        @if (Model.Gone)
        {
            <p class="sc-notice sc-notice--danger" role="alert" data-order-message><span class="sc-notice__state">Not saved:</span> this order is no longer active. Someone discontinued or changed it first. Go back to the chart to see its orders.</p>
        }
        else if (Model.RefillRefused is { } refused)
        {
            @* Step 13d: nothing was ordered, so nothing waits to be undone. *@
            <p class="sc-notice sc-notice--danger" role="alert" data-order-message><span class="sc-notice__state">Not saved:</span> @(refused == SignRefusal.Answered
                ? "someone answered this refill request first. Nothing was ordered."
                : "this refill request can't be approved: its medication is no longer active, or this isn't the same medication. Nothing was ordered.") <a asp-page="/Patients/Refills/Review" asp-route-patientId="@patient.Id" asp-route-requestId="@Model.Refill">Go back to the request</a>.</p>
        }
        else
        {
            <p class="sc-notice sc-notice--danger" role="alert" data-order-message hidden="@(Model.Errors.Count == 0)">Not saved. Fix the highlighted fields and sign again.</p>
        }
        <h2>@OrderForms.TypeNames[selected] order</h2>
        @if (Model.Form.Refill is { } refill)
        {
            @* Step 13d: what the order approves. Signing it answers the request, and the patient sees what was ordered. *@
            <div class="sc-notice sc-notice--info" data-order-refill>
                <p><span class="sc-notice__state">Approves:</span> the refill request for <strong>@refill.MedicationDisplay</strong>@if (refill.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning">Sensitive</span> }, asked by @refill.AskedBy, @Clinic.Format(refill.RequestedAt).</p>
                <p>On the chart: @refill.Medication.Display@(refill.Medication.Dosage is { } dosage ? $", {dosage}" : "").@if (refill.Note is { } note) { <br><text>The patient's note: </text><span class="sc-note__text">@note</span> }</p>
                <p>Signing this order approves the request, and the patient sees what was ordered. It renews the same medication, at any strength.</p>
            </div>
        }
        @if (replaced is not null)
        {
            @* A signed order is never edited: the change is a new order, and signing it discontinues this one. *@
            <div class="sc-notice sc-notice--info" data-order-replaces>
                <p><span class="sc-notice__state">Replaces:</span> <strong>@replaced.Display</strong> @OrderForms.Summary(replaced.Type, replaced.Details) · signed @Clinic.Format(replaced.SignedAt)</p>
                <p>Signing the change discontinues that order and keeps it in the chart's discontinued orders.</p>
            </div>
        }
        @{ Field("Item", "order-item", "Item", required: true, Model.Item, "order-items"); }
        <datalist id="order-items">
            @foreach (var item in Model.Catalog)
            {
                <option value="@item.Display"></option>
            }
        </datalist>
        @foreach (var field in OrderForms.Fields[selected])
        {
            Field(field.Name, $"order-{field.Name}", field.Label, field.Required, Model.Details.GetValueOrDefault(field.Name), list: null);
        }
        @if (Model.Form.Duplicates.Count > 0)
        {
            <section class="sc-notice sc-notice--warning" data-order-duplicate>
                <h3>Already ordered</h3>
                @foreach (var duplicate in Model.Form.Duplicates)
                {
                    <p>An active order for <strong>@duplicate.Display</strong> was signed @Clinic.Format(duplicate.SignedAt).</p>
                }
                <p>Cancel, or give a reason and sign to order it again.</p>
                <div class="sc-field">
                    <label for="order-reason">Reason for ordering it again <span>(required)</span></label>
                    <textarea id="order-reason" class="sc-field__input" name="DuplicateReason" rows="2" maxlength="@OrderForms.MaximumReasonLength" required
                              aria-invalid="@(Model.Errors.ContainsKey("DuplicateReason") ? "true" : null)">@Model.DuplicateReason</textarea>
                </div>
            </section>
        }
        @if (Model.Form.Warnings.Count > 0)
        {
            @* Step 8: what the database knows against this order. Signing needs a reason, kept on the order. *@
            var safetyError = Model.Errors.GetValueOrDefault("SafetyReason");
            var stops = Model.Form.Warnings.Any(OrderSafetyText.NeedsReason);
            <section class="sc-notice @(stops ? "sc-notice--danger" : "sc-notice--warning")" data-order-safety="@(stops ? "reason" : "information")">
                <h3>@(stops ? "Check before signing" : "Be aware")</h3>
                <ul class="sc-list">
                    @foreach (var warning in OrderSafetyText.Ordered(Model.Form.Warnings))
                    {
                        <li data-safety="@warning.Kind" data-safety-source="@warning.Source">
                            <strong>@OrderSafetyText.Heading(warning)</strong>
                            <span class="sc-tag sc-tag--warning">@OrderSafetyText.SeverityName(warning.Severity)</span>
                            <br>@OrderSafetyText.Advice(warning)
                            @if (warning.Detail is not null)
                            {
                                <br>@warning.Detail
                            }
                            <br><span class="sc-muted">Source: @OrderSafetyText.SourceName(warning.Source)@(warning.Citation is null ? "." : $". {warning.Citation}")
                                @if (warning.Source == Ehr.Data.Reference.DrugInteractionSource.DdInter)
                                {
                                    <a href="@OrderSafetyText.DdInterChecker" rel="noreferrer noopener" target="_blank">Look the pair up in DDInter (needs internet)</a>
                                }
                            </span>
                        </li>
                    }
                </ul>
                @if (!stops)
                {
                    <input type="hidden" name="SafetySeen" value="true">
                    <p>These don't stop the order. They are kept on it. @(Model.ShowingNotes ? "Sign again to go ahead, or cancel." : null)</p>
                }
                else
                {
                <p>Cancel, or give a reason and sign to order it all the same.</p>
                <div class="sc-field">
                    <label for="order-safety-reason">Reason for ordering despite the warnings <span>(required)</span></label>
                    <textarea id="order-safety-reason" class="sc-field__input" name="SafetyReason" rows="2" maxlength="@OrderForms.MaximumReasonLength" required
                              autofocus="@(safetyError is not null && Model.Errors.Count == 1)"
                              aria-invalid="@(safetyError is null ? null : "true")" aria-describedby="@(safetyError is null ? null : "order-safety-reason-error")">@Model.SafetyReason</textarea>
                    @if (safetyError is not null)
                    {
                        <p class="sc-field__error" id="order-safety-reason-error">@safetyError</p>
                    }
                </div>
                }
            </section>
        }
        @if (Model.KnownType == Ehr.Data.Orders.OrderType.Medication)
        {
            <p class="sc-muted" data-safety-disclaimer>Medication orders with a drug code are checked against the patient's coded allergies and medications. @OrderSafetyText.Disclaimer</p>
        }
        @if (replaced is not null)
        {
            var changeError = Model.Errors.GetValueOrDefault("ChangeReason");
            <div class="sc-field">
                <label for="order-change-reason">Reason for the change</label>
                <textarea id="order-change-reason" class="sc-field__input" name="ChangeReason" rows="2" maxlength="@OrderForms.MaximumReasonLength"
                          aria-invalid="@(changeError is null ? null : "true")" aria-describedby="@(changeError is null ? null : "order-change-reason-error")">@Model.ChangeReason</textarea>
                @if (changeError is not null)
                {
                    <p class="sc-field__error" id="order-change-reason-error">@changeError</p>
                }
            </div>
        }
        <div class="sc-actions">
            <button type="submit" class="sc-btn sc-btn--primary" data-order-sign autofocus="@Model.ShowingNotes">@(replaced is null ? "Sign order" : "Sign changed order")</button>
            <a asp-page="/Patients/Chart" asp-all-route-data="Model.ChartLink">Cancel</a>
        </div>
    </form>
}

@functions {
    // Keyboard first (NFR-12): the page opens with the cursor in the first field to fix, or in the item when there is
    // nothing to fix yet.
    string Focused() => Model.ShowingNotes
        // Back only to show notes: the cursor is on "Sign order".
        ? ""
        : Model.Errors.Count == 0 || Model.Errors.ContainsKey("Item")
        ? "Item"
        : OrderForms.Fields[Model.KnownType!].Select(detail => detail.Name).FirstOrDefault(Model.Errors.ContainsKey) ?? "";

    // A labelled input, marked when required, and highlighted with its message when it needs fixing.
    void Field(string name, string id, string label, bool required, string? value, string? list)
    {
        var error = Model.Errors.GetValueOrDefault(name);
        <div class="sc-field">
            <label for="@id">@label @if (required) { <span>(required)</span> }</label>
            <input id="@id" class="sc-field__input" name="@(name == "Item" ? "Item" : $"Details[{name}]")" value="@value" list="@list" maxlength="@OrderForms.MaximumLength"
                   autocomplete="off" required="@required" aria-invalid="@(error is null ? null : "true")" autofocus="@(name == Focused())"
                   data-code-search="@(name == "Item" ? $"order-{Model.KnownType}" : null)"
                   aria-describedby="@(error is null ? null : $"{id}-error")">
            @if (error is not null)
            {
                <p class="sc-field__error" id="@id-error">@error</p>
            }
        </div>
    }
}
