@* The way back from a chart, or from the reason it asks for: to the search it came from, with its criteria, or to the
   clinician's panel when it didn't come from a search. The "/" key follows it (patient-search.js). *@
@model SearchQuery
@if (Model.IsEmpty)
{
    <a asp-page="Index" class="sc-back" data-search-back aria-keyshortcuts="/">Back to patients</a>
}
else
{
    <a asp-page="Index" asp-all-route-data="Model.RouteData()" class="sc-back" data-search-back aria-keyshortcuts="/">Back to search</a>
}
