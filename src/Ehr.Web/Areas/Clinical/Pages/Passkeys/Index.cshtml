@page "/passkeys"
@model IndexModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Passkeys";
}
@section Scripts {
    <script src="~/_content/Ehr.Design/js/passkeys.js" defer></script>
}
<h1>Passkeys</h1>

@* Each notice starts with its state, a sentence of its own ("Passkey added.", "Not saved."), marked up as the guide's
   notices have it. *@
@if (Model.Message is { } message)
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">@IndexModel.State(message)</span>@IndexModel.Rest(message)</p>
}
@if (Model.Problem is { } problem)
{
    <p class="sc-notice sc-notice--danger" role="alert"><span class="sc-notice__state">@IndexModel.State(problem)</span>@IndexModel.Rest(problem)</p>
}

@if (Model.Passkeys.Count == 0)
{
    <p class="sc-empty">No passkeys.</p>
}
else
{
    <div class="sc-table-wrap">
        <table class="sc-table">
            <thead>
                <tr><th>Name</th><th class="sc-table__fit">Added</th><th class="sc-table__actions"><span class="sc-visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var passkey in Model.Passkeys)
                {
                    <tr>
                        <td>@passkey.Name</td>
                        <td class="sc-table__mono">@Clinic.Format(passkey.CreatedAt)</td>
                        <td class="sc-table__actions">
                            @if (OnPrem.IsReachable)
                            {
                                <form method="post" asp-page-handler="Remove"><input type="hidden" name="id" value="@IndexModel.IdOf(passkey)"><button class="sc-btn sc-btn--compact">Remove<span class="sc-visually-hidden"> @passkey.Name</span></button></form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="sc-muted">Lost a device? Ask an administrator to reset your authenticator.</p>
}

<div class="sc-sheet">
<h2>Add a passkey</h2>
@if (!OnPrem.IsReachable)
{
    @* UC 2: off-site with the clinic's server unreachable, nothing could be saved. *@
    <p class="sc-muted">Adding or removing a passkey needs the clinic's server.</p>
}
else if (Model.Passkeys.Count >= StaffPasskeys.MostPerAccount)
{
    <p class="sc-muted">You have the maximum of @StaffPasskeys.MostPerAccount passkeys. Remove one to add another.</p>
}
else
{
    @* Shown until passkeys.js finds this browser can make a passkey, and so without JavaScript. *@
    <p data-passkey-unsupported>This browser doesn't support passkeys.</p>
    <form method="post" asp-page-handler="Options" class="sc-form" data-passkey-add hidden>
        <div class="sc-field">
            <label for="passkey-name" class="sc-field__label">Name</label>
            <input id="passkey-name" name="name" class="sc-field__input" maxlength="@StaffPasskeys.LongestName" autocomplete="off" required>
        </div>
        <div class="sc-field">
            <label for="passkey-code" class="sc-field__label">Code from your authenticator app</label>
            <input id="passkey-code" name="code" class="sc-field__input sc-field__input--mono" inputmode="numeric" autocomplete="one-time-code" required>
        </div>
        <p class="sc-notice sc-notice--danger" role="alert" data-passkey-problem hidden></p>
        <button class="sc-btn sc-btn--primary">Add passkey</button>
    </form>
    @* The passkey the browser made, sent as a plain form, so the page that follows is the server's. *@
    <form method="post" asp-page-handler="Add" data-passkey-finish hidden>
        <input type="hidden" name="credential">
        <input type="hidden" name="state">
    </form>
}
</div>
