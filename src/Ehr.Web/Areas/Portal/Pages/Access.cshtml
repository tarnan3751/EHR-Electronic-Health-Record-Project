@page "/portal/access"
@using Ehr.Data.Proxies
@using Ehr.Domain.Proxies
@model Ehr.Web.Areas.Portal.Pages.AccessModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Sharing";
    var inForce = Model.Grants.Where(g => g.InForce).ToList();
    var ended = Model.Grants.Where(g => !g.InForce).Take(10).ToList();
}
<h1>Sharing</h1>
@if (Model.Done is "given")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Shared.</span> They can see your record when they sign in with that email address. We've emailed them a link to sign in, or to create an account.</p>
}
else if (Model.Done is "removed")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Sharing removed.</span> They can no longer see your record.</p>
}
else if (Model.Done is "changed")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Saved.</span> What they can see has changed.</p>
}

<h2>Records shared with you</h2>
@if (Model.Acting)
{
    <p class="sc-muted">You're looking at one of them now. Go back to your own record to choose another.</p>
}
else if (Model.Records.Count == 0)
{
    <p class="sc-muted">Nobody has shared a record with you.</p>
}
else
{
    <ul class="sc-results">
        @foreach (var record in Model.Records)
        {
            <li class="sc-result" data-record>
                <h3>@record.PatientName</h3>
                <p>@ProxyAccess.ScopeLabel(record.Scope). Until @Clinic.Plain(record.ExpiresAt, "MMM d, yyyy").</p>
                <form method="post" asp-page="/Acting">
                    <input type="hidden" name="grantId" value="@record.GrantId">
                    <button type="submit" class="sc-btn sc-btn--primary">View this record</button>
                </form>
            </li>
        }
    </ul>
}

@if (!Model.HasOwnRecord)
{
    @* A proxy-only account (step 6b) has no record of its own, so nothing to share. *@
    return;
}
<h2>Who can see your record</h2>
@if (Model.Acting)
{
    <p class="sc-muted">You're looking at someone else's record. Go back to your own to see or change who can see yours.</p>
}
else
{
    @if (inForce.Count == 0)
    {
        <p class="sc-muted">You haven't shared your record with anyone.</p>
    }
    else
    {
        <ul class="sc-results">
            @foreach (var grant in inForce)
            {
                <li class="sc-result" data-grant>
                    <h3>@grant.Email</h3>
                    <p>
                        @ProxyAccess.ScopeLabel(grant.Scope). Until @Clinic.Plain(grant.ExpiresAt, "MMM d, yyyy").
                        @(grant.ByClinic ? "Shared by your clinic." : "Shared by you.")
                    </p>
                    <p>@(grant.IncludeSensitive ? "They can also see sensitive items, and see and fill in your pre-visit forms." : "They can't see sensitive items or your pre-visit forms.")</p>
                    @if (OnPrem.IsReachable)
                    {
                        <div class="sc-actions">
                            <form method="post" asp-page-handler="Sensitive">
                                <input type="hidden" name="grantId" value="@grant.Id">
                                <input type="hidden" name="allow" value="@(grant.IncludeSensitive ? "false" : "true")">
                                <button type="submit" class="sc-btn">@(grant.IncludeSensitive ? "Stop sharing sensitive items" : "Share sensitive items too")</button>
                            </form>
                            <form method="post" asp-page-handler="Revoke">
                                <input type="hidden" name="grantId" value="@grant.Id">
                                <button type="submit" class="sc-btn sc-btn--danger">Stop sharing</button>
                            </form>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <h2>Share your record</h2>
    @if (!OnPrem.IsReachable)
    {
        <p class="sc-notice sc-notice--warning"><span class="sc-notice__state">Read-only.</span> Sharing can't be changed until the clinic's server is back.</p>
    }
    else
    {
        <div class="sc-prose sc-muted">
            <p>For a family member or carer who helps with your care.</p>
            <ul>
                <li>They sign in with their own portal account, never yours.</li>
                <li>We email them a link to sign in, or to create an account. The email doesn't say whose record it is.</li>
                <li>Sharing ends after the time you choose, and you can stop it at any time.</li>
            </ul>
        </div>
        <form method="post" class="sc-form">
            @if (Model.Errors.Count > 0)
            {
                <p class="sc-notice sc-notice--danger" role="alert"><span class="sc-notice__state">Not saved.</span> Fix the highlighted fields and try again.</p>
            }
            <div class="sc-field">
                <label for="access-email">Their email address</label>
                <input id="access-email" class="sc-field__input" type="email" name="Email" value="@Model.Email" maxlength="@ProxyGrantConfiguration.MaximumEmail" autocomplete="off" required
                       aria-invalid="@(Model.Errors.ContainsKey("Email") ? "true" : null)" aria-describedby="@(Model.Errors.ContainsKey("Email") ? "access-email-error" : null)">
                @if (Model.Errors.TryGetValue("Email", out var emailError))
                {
                    <p class="sc-field__error" id="access-email-error">@emailError</p>
                }
            </div>
            <div class="sc-field">
                <label for="access-scope">What they can see</label>
                <select id="access-scope" class="sc-field__input" name="Scope"
                        aria-invalid="@(Model.Errors.ContainsKey("Scope") ? "true" : null)" aria-describedby="@(Model.Errors.ContainsKey("Scope") ? "access-scope-error" : null)">
                    @foreach (var scope in ProxyScope.All)
                    {
                        <!option value="@scope" @(Model.Scope == scope ? "selected" : null)>@ProxyAccess.ScopeLabel(scope)</!option>
                    }
                </select>
                @if (Model.Errors.TryGetValue("Scope", out var scopeError))
                {
                    <p class="sc-field__error" id="access-scope-error">@scopeError</p>
                }
            </div>
            <div class="sc-field">
                <label class="sc-check" for="access-sensitive"><input type="checkbox" id="access-sensitive" name="IncludeSensitive" value="true" checked="@Model.IncludeSensitive" aria-describedby="access-sensitive-hint"> Also share sensitive items</label>
                @* Step 13e: pre-visit forms are sensitive items, and a proxy allowed them can answer them too. *@
                <p class="sc-field__hint" id="access-sensitive-hint">Items your care team marked sensitive, and your pre-visit forms, which they can then fill in.</p>
            </div>
            <div class="sc-field">
                <label for="access-days">For how long</label>
                <select id="access-days" class="sc-field__input" name="Days"
                        aria-invalid="@(Model.Errors.ContainsKey("Days") ? "true" : null)" aria-describedby="@(Model.Errors.ContainsKey("Days") ? "access-days-error" : null)">
                    @foreach (var (days, label) in ProxyAccess.Durations)
                    {
                        <!option value="@days" @(Model.Days == days ? "selected" : null)>@label</!option>
                    }
                </select>
                @if (Model.Errors.TryGetValue("Days", out var daysError))
                {
                    <p class="sc-field__error" id="access-days-error">@daysError</p>
                }
            </div>
            <div class="sc-actions">
                <button type="submit" class="sc-btn sc-btn--primary">Share record</button>
            </div>
        </form>
    }

    @if (ended.Count > 0)
    {
        <h2>Sharing that has ended</h2>
        <ul class="sc-list">
            @foreach (var grant in ended)
            {
                <li>@grant.Email <span class="sc-muted">· @(grant.RevokedAt is { } revoked ? $"stopped {Clinic.Plain(revoked, "MMM d, yyyy")}" : $"ended {Clinic.Plain(grant.ExpiresAt, "MMM d, yyyy")}")</span></li>
            }
        </ul>
    }
}
