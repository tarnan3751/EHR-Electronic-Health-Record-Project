@page "/portal/results"
@using Ehr.Domain.Results
@model ResultsModel
@{
    ViewData["Title"] = "Test results";
}
<h1>Test results</h1>
@if (!Model.Available)
{
    <p class="sc-notice sc-notice--danger">Your results are not available right now. Contact the clinic if this continues.</p>
}
else if (Model.Results.Count == 0)
{
    <p>@(HttpContext.Items[Ehr.Web.PortalSubjectFilter.Item] is Ehr.Web.PortalSubject { Acting: not null } ? "There are no test results yet. If one is expected, contact the care team." : "You have no test results yet. If you are waiting for one, contact your care team.")</p>
}
else
{
    <p class="sc-muted">Newest first. Select a result to see what it means.</p>
    @* <details> opens each result in place: no script, no result ID in a URL, and the keyboard works as it does
       everywhere else. Each result leads with one plain sentence; its value and range come under it (docs/brand). *@
    <ul class="sc-results">
        @foreach (var result in Model.Results)
        {
            var flag = ResultExplanation.Flag(result);
            <li>
                <details class="sc-result">
                    @* The flex layout is on a span inside the summary, so the summary keeps its open/close marker. *@
                    <summary><span class="sc-result__line">
                        <strong>@result.Display</strong>
                        <span class="sc-result__date">@result.EffectiveAt.UtcDateTime.ToString("MMM d, yyyy") UTC</span>
                        @if (flag == ResultFlag.High)
                        {
                            <span class="sc-tag sc-tag--warning">High</span>
                        }
                        else if (flag == ResultFlag.Low)
                        {
                            <span class="sc-tag sc-tag--warning">Low</span>
                        }
                        else if (flag == ResultFlag.Normal)
                        {
                            <span class="sc-tag sc-tag--success">Normal</span>
                        }
                    </span></summary>
                    <div class="sc-result__body">
                        <p>@ResultExplanation.Meaning(result)</p>
                        <dl class="record">
                            @if (ResultExplanation.Value(result) is { } value)
                            {
                                <dt>@(HttpContext.Items[Ehr.Web.PortalSubjectFilter.Item] is Ehr.Web.PortalSubject { Acting: not null } ? "Result" : "Your result")</dt><dd>@value</dd>
                            }
                            @if (ResultExplanation.Range(result) is { } range)
                            {
                                <dt>Normal range</dt><dd>@range</dd>
                            }
                        </dl>
                        @if (ResultExplanation.WhatItMeasures(result) is { } measures)
                        {
                            <p>@measures</p>
                        }
                        @if (result.Note is { Length: > 0 } note)
                        {
                            <p><strong>Note from your care team:</strong> @note</p>
                        }
                    </div>
                </details>
            </li>
        }
    </ul>
}
<p><a asp-page="/Index">@(HttpContext.Items[Ehr.Web.PortalSubjectFilter.Item] is Ehr.Web.PortalSubject { Acting: not null } ? "Back to the record" : "Back to my record")</a></p>
