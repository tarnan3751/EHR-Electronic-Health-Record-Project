@* A patient's appointments, as cards down one column (docs/brand: the portal). Dates are written out; times are the
   clinic's, labeled with its zone, as the clinic's schedule shows them. *@
@using Ehr.Data.Scheduling
@model IReadOnlyList<Ehr.Domain.Scheduling.AppointmentEntry>
<ul class="sc-results">
    @foreach (var appointment in Model)
    {
        <li class="sc-result" data-appointment="@appointment.Status">
            <h3>@Clinic.Plain(appointment.StartsAt, "dddd, MMM d, yyyy")</h3>
            <p>@Clinic.Format(appointment.StartsAt, "HH:mm"), for @appointment.Minutes minutes, with @appointment.Clinician</p>
            <p>@appointment.Reason</p>
            @if (appointment.Status != AppointmentStatus.Booked)
            {
                <p><span class="sc-tag">@(appointment.Status == AppointmentStatus.Fulfilled ? "Attended" : appointment.Status == AppointmentStatus.NoShow ? "Missed" : "Cancelled")</span></p>
            }
        </li>
    }
</ul>
