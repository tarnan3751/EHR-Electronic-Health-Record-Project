@page "/portal/appointments"
@model AppointmentsModel
@{
    ViewData["Title"] = "Appointments";
}
<h1>Appointments</h1>
@if (Model.Appointments is { } appointments)
{
    <h2>Coming up</h2>
    @if (appointments.Upcoming.Count > 0)
    {
        <partial name="_Appointments" model="appointments.Upcoming" />
    }
    else
    {
        <p class="sc-empty">No upcoming appointments.</p>
    }
    <p class="sc-muted">To book, change or cancel an appointment, contact the clinic.</p>
    <h2>Earlier</h2>
    @if (appointments.Past.Count > 0)
    {
        <partial name="_Appointments" model="appointments.Past" />
    }
    else
    {
        <p class="sc-empty">No earlier appointments.</p>
    }
}
else
{
    <p class="sc-notice sc-notice--danger">@(Model.Acting ? "The appointments are" : "Your appointments are") not available right now.</p>
}
