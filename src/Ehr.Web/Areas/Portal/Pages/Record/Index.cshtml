@page "/portal/record"
@model IndexModel
@{
    var own = Model.ActingFor is null;
    ViewData["Title"] = own ? "Download my record" : "Download this record";
}
<div class="sc-pagehead"><a asp-page="/Index" class="sc-back">Back to home</a></div>
<h1>@ViewData["Title"]</h1>
@if (Model.Unavailable)
{
    <p class="sc-notice sc-notice--danger">@(own ? "Your record is" : "The record is") not available right now.</p>
}
@* Said before anything is downloaded: the copy is the person's to look after once it leaves the portal. *@
<p class="sc-notice sc-notice--warning" data-download-warning><span class="sc-notice__state">Keep it private.</span> Anyone with the file or the printout can read @(own ? "your" : "this person's") health information.</p>
@* A GET form, so the cloud app answers it too: the box asks for sensitive items, and each button names what it makes. A
   proxy the patient didn't allow sensitive items is offered no box: for them there are none. *@
<form method="get" class="sc-stack sc-formcard">
    @if (Model.MaySeeSensitive)
    {
        <div class="sc-field">
            <label class="sc-check" for="record-sensitive"><input type="checkbox" id="record-sensitive" name="sensitive" value="true" checked="@Model.Sensitive" aria-describedby="record-sensitive-hint"> Include sensitive items</label>
            <p class="sc-field__hint" id="record-sensitive-hint">Including them is logged.</p>
        </div>
    }
    <div class="sc-actions">
        <button type="submit" class="sc-btn sc-btn--primary" name="handler" value="File">Download file</button>
        <button type="submit" class="sc-btn" asp-page="/Record/Print">Open printable page</button>
    </div>
</form>
<details class="sc-prose">
    <summary>More about what's included</summary>
    <ul>
        <li>Both have the allergies, medications, diagnoses, test results, vital signs and appointments.</li>
        <li>The file uses FHIR, a standard format other clinics and health apps can read. It has no visit summaries.</li>
        <li>The printable page also has the @SummariesModel.Limit most recent visit summaries.</li>
        <li>Neither includes the care team's notes, messages, pre-visit forms, or who has looked at the record.</li>
    </ul>
</details>
