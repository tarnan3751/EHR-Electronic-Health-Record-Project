@page "/portal/record/print"
@model PrintModel
@using Ehr.Data.Patients
@using Ehr.Domain.Results
@using Ehr.Web.Fhir
@{
    ViewData["Title"] = "Health record";
    var own = Model.Own;
    string[] parts = Ehr.Domain.Notes.VisitSummaries.Parts;
}
@if (Model.Record is not { } record || record.Summaries is not { } summaries)
{
    <h1>Health record</h1>
    <p class="sc-notice sc-notice--danger">@(own ? "Your record is" : "The record is") not available right now. Contact the clinic if this continues.</p>
}
else
{
    var patient = record.Patient;
    var hidden = record.SensitiveHidden + summaries.SensitiveHidden;
    var anyShown = record.Medications.Entries.Any(m => m.Sensitive) || record.Conditions.Entries.Any(c => c.Sensitive)
        || summaries.Summaries.Any(s => s.Sensitive) || summaries.Withdrawn.Any(w => w.Sensitive);
    <h1>Health record of @patient.GivenName @patient.FamilyName</h1>
    <p class="sc-muted">A copy from the SwiftChart patient portal, as of @Clinic.Format(Model.At, "MMM d, yyyy HH:mm").</p>
    <p class="sc-muted sc-screen-only">To print it or save it as a PDF, use your browser's Print command.</p>
    @if (Model.MaySeeSensitive && hidden > 0)
    {
        @* Left out until asked for (docs/brand: sensitive items). On screen only: paper never says that anything was left out. *@
        <p class="sc-notice sc-notice--info sc-screen-only" data-sensitive="hidden"><span class="sc-notice__state">Sensitive items hidden.</span> @hidden @(hidden == 1 ? "diagnosis, medication or visit summary is not" : "diagnoses, medications or visit summaries are not") shown. <a asp-page="/Record/Print" asp-route-sensitive="true">Show sensitive items</a></p>
    }
    else if (Model.MaySeeSensitive && record.SensitiveShown && anyShown)
    {
        <p class="sc-notice sc-notice--info" data-sensitive="shown"><span class="sc-notice__state">Sensitive items shown.</span> Your view is logged. <a asp-page="/Record/Print" class="sc-screen-only">Hide sensitive items</a></p>
    }

    <section class="sc-panel" aria-labelledby="record-about">
        <h2 class="sc-panel__title" id="record-about">@(own ? "About you" : "About the patient")</h2>
        <dl class="record">
            <dt>Name</dt><dd>@patient.GivenName @patient.FamilyName</dd>
            <dt>Medical record number</dt><dd class="mono-id">@patient.Mrn</dd>
            <dt>Date of birth</dt><dd>@patient.BirthDate.ToString("yyyy-MM-dd")</dd>
            <dt>Gender</dt><dd>@PrintModel.Said(patient.Gender)</dd>
        </dl>
    </section>

    <section class="sc-panel" aria-labelledby="record-allergies" data-record="allergies">
        <h2 class="sc-panel__title" id="record-allergies">Allergies</h2>
        @if (FhirRecord.Cut(record.Allergies, "allergies") is { } allergiesCut)
        {
            <p class="sc-muted">@allergiesCut are shown.</p>
        }
        @if (record.Allergies.Entries.Count == 0)
        {
            <p class="sc-muted">No allergy information recorded.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Allergy</th><th>Reaction</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var allergy in record.Allergies.Entries)
                        {
                            <tr>
                                <td>@allergy.Display@if (allergy.Criticality == AllergyCriticality.High) { <text> </text><span class="sc-tag sc-tag--danger">High risk</span> }</td>
                                <td>@allergy.Reaction</td>
                                <td>@PrintModel.Said(allergy.ClinicalStatus)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="sc-panel" aria-labelledby="record-medications" data-record="medications">
        <h2 class="sc-panel__title" id="record-medications">Medications</h2>
        @if (FhirRecord.Cut(record.Medications, "medications") is { } medicationsCut)
        {
            <p class="sc-muted">@medicationsCut are shown.</p>
        }
        @if (record.Medications.Entries.Count == 0)
        {
            <p class="sc-muted">No medications.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Medication</th><th>How to take it</th><th>Status</th><th>Started</th></tr></thead>
                    <tbody>
                        @foreach (var medication in record.Medications.Entries)
                        {
                            <tr>
                                <td>@medication.Display@if (medication.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning">Sensitive</span> }</td>
                                <td>@medication.Dosage</td>
                                <td>@PrintModel.Said(medication.Status)</td>
                                <td>@medication.EffectiveStart?.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="sc-panel" aria-labelledby="record-diagnoses" data-record="diagnoses">
        <h2 class="sc-panel__title" id="record-diagnoses">Diagnoses</h2>
        @if (FhirRecord.Cut(record.Conditions, "diagnoses") is { } diagnosesCut)
        {
            <p class="sc-muted">@diagnosesCut are shown.</p>
        }
        @if (record.Conditions.Entries.Count == 0)
        {
            <p class="sc-muted">No diagnoses.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Diagnosis</th><th>Status</th><th>Since</th></tr></thead>
                    <tbody>
                        @foreach (var condition in record.Conditions.Entries)
                        {
                            <tr>
                                <td>@condition.Display@if (condition.Code is { } code) { <text> (@code)</text> }@if (condition.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning">Sensitive</span> }</td>
                                <td>@PrintModel.Said(condition.ClinicalStatus)</td>
                                <td>@condition.OnsetDate?.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="sc-panel" aria-labelledby="record-results" data-record="results">
        <h2 class="sc-panel__title" id="record-results">Test results</h2>
        @if (FhirRecord.Cut(record.Results, "test results") is { } resultsCut)
        {
            <p class="sc-muted">@resultsCut are shown.</p>
        }
        @if (record.Results.Entries.Count == 0)
        {
            <p class="sc-muted">No test results yet.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Test</th><th>Result</th><th>Normal range</th><th>Taken</th></tr></thead>
                    <tbody>
                        @foreach (var entry in record.Results.Entries)
                        {
                            var result = entry.Observation;
                            var flag = ResultExplanation.Flag(result);
                            <tr>
                                <td>
                                    @ForPatients.Name(result.Code, result.Display)
                                    @if (result.Note is { Length: > 0 } note)
                                    {
                                        <br><span class="sc-muted">Note from the care team: @note</span>
                                    }
                                </td>
                                <td>@ResultExplanation.Value(result)@if (flag is ResultFlag.High or ResultFlag.Low) { <text> </text><span class="sc-tag sc-tag--warning">@(flag == ResultFlag.High ? "High" : "Low")</span> }</td>
                                <td>@ResultExplanation.Range(result)</td>
                                <td>@Clinic.Format(result.EffectiveAt, "MMM d, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="sc-panel" aria-labelledby="record-vitals" data-record="vitals">
        <h2 class="sc-panel__title" id="record-vitals">Vital signs</h2>
        @if (FhirRecord.Cut(record.VitalSigns, "vital signs") is { } vitalsCut)
        {
            <p class="sc-muted">@vitalsCut are shown.</p>
        }
        @if (record.VitalSigns.Entries.Count == 0)
        {
            <p class="sc-muted">No vital signs.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Sign</th><th>Value</th><th>Taken</th></tr></thead>
                    <tbody>
                        @foreach (var entry in record.VitalSigns.Entries)
                        {
                            var sign = entry.Observation;
                            @* A blood pressure is one reading, its two numbers together (step 9c). *@
                            var value = entry.Diastolic is { } diastolic
                                ? new BloodPressure(sign, diastolic.Observation).Text
                                : sign.Value?.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
                            <tr>
                                <td>@(entry.Diastolic is null ? ForPatients.Name(sign.Code, sign.Display) : "Blood pressure")</td>
                                <td>@value @ForPatients.Unit(sign.Unit)</td>
                                <td>@Clinic.Format(sign.EffectiveAt, "MMM d, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="sc-panel" aria-labelledby="record-appointments" data-record="appointments">
        <h2 class="sc-panel__title" id="record-appointments">Appointments</h2>
        @if (FhirRecord.Cut(record.Appointments, "appointments") is { } appointmentsCut)
        {
            <p class="sc-muted">@appointmentsCut are shown.</p>
        }
        @if (record.Appointments.Entries.Count == 0)
        {
            <p class="sc-muted">No appointments.</p>
        }
        else
        {
            <div class="sc-table-wrap">
                <table class="sc-table">
                    <thead><tr><th>Date</th><th>Time</th><th>With</th><th>Reason</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var appointment in record.Appointments.Entries)
                        {
                            <tr>
                                <td>@Clinic.Plain(appointment.StartsAt, "dddd, MMM d, yyyy")</td>
                                <td>@Clinic.Format(appointment.StartsAt, "HH:mm"), @appointment.Minutes minutes</td>
                                <td>@appointment.Clinician</td>
                                <td>@appointment.Reason</td>
                                <td>@PrintModel.AppointmentSaid(appointment.Status)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* The visit summaries as the portal's summaries page has them (PhiReader.VisitSummariesAsync): standing ones and the
       placeholders of withdrawn ones, in one list by date, newest first, a standing one before a placeholder of the
       same date; each dated the day the visit's notes were signed. An item is a standing summary by its place in the
       reader's list, or a placeholder (-1); of a summary the page reads its date, writer, sensitivity and three parts,
       by name, and nothing else. *@
    var items = summaries.Summaries.Select((s, index) => (Date: s.NoteSignedAt, Index: index))
        .Concat(summaries.Withdrawn.Select(w => (Date: w.NoteSignedAt, Index: -1)))
        .OrderByDescending(item => item.Date.UtcDateTime.Date).ThenBy(item => item.Index < 0).ThenByDescending(item => item.Date).ToList();
    <section class="sc-panel" aria-labelledby="record-summaries" data-record="summaries">
        <h2 class="sc-panel__title" id="record-summaries">Visit summaries</h2>
        @if (summaries.Summaries.Count >= SummariesModel.Limit)
        {
            @* The reader gives the newest of them, as Visit summaries has them, and doesn't say whether there are more: so
               the page says what it holds at most, true whether or not any were left out. *@
            <p class="sc-muted" data-summaries-cut>This page shows at most the @SummariesModel.Limit newest visit summaries.</p>
        }
        @if (items.Count == 0)
        {
            <p class="sc-muted">No visit summaries yet.</p>
        }
        else
        {
            <ul class="sc-results">
                @foreach (var item in items)
                {
                    @if (item.Index >= 0)
                    {
                        var summary = summaries.Summaries.ElementAt(item.Index);
                        <li data-summary="standing">
                            <h3>@Clinic.Format(summary.NoteSignedAt, "MMM d, yyyy")</h3>
                            <p class="sc-muted">Written by @summary.ReleasedBy@if (summary.Sensitive) { <text> </text><span class="sc-tag sc-tag--warning">Sensitive</span> }</p>
                            <h4>@parts[0]</h4>
                            <p class="sc-note__text">@summary.TalkedAbout</p>
                            <h4>@parts[1]</h4>
                            <p class="sc-note__text">@summary.Found</p>
                            <h4>@parts[2]</h4>
                            <p class="sc-note__text">@summary.NextSteps</p>
                        </li>
                    }
                    else
                    {
                        @* Tahseen's decision of 21 November 2026, as on the summaries page: the date and nothing else. *@
                        <li data-summary="withdrawn">
                            <partial name="_WithdrawnSummary" model="item.Date" />
                        </li>
                    }
                }
            </ul>
        }
    </section>
}
<p class="sc-screen-only"><a asp-page="/Record/Index">Back to download</a></p>
