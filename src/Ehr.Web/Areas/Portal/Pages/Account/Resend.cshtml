@page "/portal/resend"
@model ResendModel
@{
    ViewData["Title"] = "Send a new confirmation link";
}
<h1>Send a new confirmation link</h1>
@if (Model.Sent)
{
    <p class="sc-notice sc-notice--info">If that address has a portal account waiting to be confirmed, we've sent it a new link.</p>
}
else
{
    <p>Enter the email address you registered with. We'll send a new link to confirm it.</p>
    <form method="post" class="sc-form">
        <div class="sc-field">
            <label asp-for="Email" class="sc-field__label">Email</label>
            <input asp-for="Email" class="sc-field__input" type="email" autocomplete="username" required autofocus>
            <span asp-validation-for="Email" class="sc-field__error"></span>
        </div>
        <button class="sc-btn sc-btn--primary">Send a new link</button>
    </form>
}
<p><a asp-page="SignIn">Back to sign in</a></p>
