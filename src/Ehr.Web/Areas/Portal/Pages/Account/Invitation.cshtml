@page "/portal/invitation"
@model InvitationModel
@{
    ViewData["Title"] = "Create your portal account";
}
<h1>Create your portal account</h1>
@if (Model.State == "created")
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Account created.</span> <a asp-page="SignIn">Sign in</a> with the email address the invitation was sent to.</p>
}
else if (Model.State == "has-account")
{
    <p class="sc-notice sc-notice--info">You already have a portal account. <a asp-page="SignIn">Sign in</a> to see the shared record.</p>
}
else if (Model.State == "invalid")
{
    <p class="sc-notice sc-notice--danger">This invitation has expired or has been used. Ask the person who shared their record to share it again.</p>
    <p>Already have an account? <a asp-page="SignIn">Sign in</a></p>
}
else
{
    <p>Create an account to see the record shared with you.</p>
    <form method="post" class="sc-form">
        <input type="hidden" asp-for="Input.Code">
        <div class="sc-field">
            <label asp-for="Input.Name" class="sc-field__label">Your name</label>
            <input asp-for="Input.Name" class="sc-field__input" autocomplete="name" maxlength="100" required autofocus>
            <span asp-validation-for="Input.Name" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Password" class="sc-field__label">Password</label>
            <input asp-for="Input.Password" class="sc-field__input" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Input.Password" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Confirm" class="sc-field__label">Password, again</label>
            <input asp-for="Input.Confirm" class="sc-field__input" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Input.Confirm" class="sc-field__error"></span>
        </div>
        <div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>
        <button class="sc-btn sc-btn--primary">Create account</button>
    </form>
}
