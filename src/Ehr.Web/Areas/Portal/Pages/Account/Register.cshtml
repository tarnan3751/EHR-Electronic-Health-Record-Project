@page "/portal/register"
@model RegisterModel
@{
    ViewData["Title"] = "Register for the patient portal";
}
<h1>Register for the patient portal</h1>
@if (Model.Registered)
{
    <p class="sc-notice sc-notice--success"><span class="sc-notice__state">Check your email.</span> Open the link we sent you, then <a asp-page="SignIn">sign in</a>.</p>
}
else
{
    <form method="post" class="sc-form">
        <div class="sc-field">
            <label asp-for="Input.Code" class="sc-field__label">Enrollment code</label>
            <input asp-for="Input.Code" class="sc-field__input sc-field__input--mono" autocomplete="off" required autofocus placeholder="XXXX-XXXX-XXXX">
            <span asp-validation-for="Input.Code" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Email" class="sc-field__label">Email</label>
            <input asp-for="Input.Email" class="sc-field__input" type="email" autocomplete="username" required>
            <span asp-validation-for="Input.Email" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Password" class="sc-field__label">Password</label>
            <input asp-for="Input.Password" class="sc-field__input" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Input.Password" class="sc-field__error"></span>
        </div>
        <div class="sc-field">
            <label asp-for="Input.Confirm" class="sc-field__label">Password, again</label>
            <input asp-for="Input.Confirm" class="sc-field__input" type="password" autocomplete="new-password" required>
            <span asp-validation-for="Input.Confirm" class="sc-field__error"></span>
        </div>
        <div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>
        <button class="sc-btn sc-btn--primary">Register</button>
    </form>
    <p>Already registered? <a asp-page="SignIn">Sign in</a></p>
}
