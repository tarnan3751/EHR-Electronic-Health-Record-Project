@page "/portal/register"
@model RegisterModel
@{
    ViewData["Title"] = "Register for the patient portal";
}
<h1>Register for the patient portal</h1>
@if (Model.Registered)
{
    <p class="notice">Check your email. We've sent a link to confirm your address; once you've opened it, you can <a asp-page="SignIn">sign in</a>.</p>
}
else
{
    <p>You need the enrollment code the clinic gave you.</p>
    <form method="post" class="account-form">
        <label>Enrollment code <input asp-for="Input.Code" autocomplete="off" required autofocus placeholder="XXXX-XXXX-XXXX"></label>
        <span asp-validation-for="Input.Code" class="error"></span>
        <label>Email <input asp-for="Input.Email" type="email" autocomplete="username" required></label>
        <span asp-validation-for="Input.Email" class="error"></span>
        <label>Password <input asp-for="Input.Password" type="password" autocomplete="new-password" required></label>
        <span asp-validation-for="Input.Password" class="error"></span>
        <label>Password, again <input asp-for="Input.Confirm" type="password" autocomplete="new-password" required></label>
        <span asp-validation-for="Input.Confirm" class="error"></span>
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <button>Register</button>
    </form>
    <p>Already registered? <a asp-page="SignIn">Sign in</a>.</p>
}
