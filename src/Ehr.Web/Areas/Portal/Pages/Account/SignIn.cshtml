@page "/portal/sign-in"
@model SignInModel
@{
    ViewData["Title"] = "Sign in to the patient portal";
}
<h1>Sign in to the patient portal</h1>
<form method="post" class="sc-form">
    <input type="hidden" asp-for="ReturnUrl">
    <div class="sc-field">
        <label asp-for="Input.Email" class="sc-field__label">Email</label>
        <input asp-for="Input.Email" class="sc-field__input" type="email" autocomplete="username" required autofocus>
        <span asp-validation-for="Input.Email" class="sc-field__error"></span>
    </div>
    <div class="sc-field">
        <label asp-for="Input.Password" class="sc-field__label">Password</label>
        <input asp-for="Input.Password" class="sc-field__input" type="password" autocomplete="current-password" required>
        <span asp-validation-for="Input.Password" class="sc-field__error"></span>
    </div>
    <div asp-validation-summary="ModelOnly" class="sc-notice sc-notice--danger"></div>
    <button class="sc-btn sc-btn--primary">Sign in</button>
</form>
<p>New here? <a asp-page="Register">Register</a></p>
<p><a asp-page="Forgot">Forgot your password?</a></p>
<p><a asp-page="Resend">Resend the confirmation email</a></p>
