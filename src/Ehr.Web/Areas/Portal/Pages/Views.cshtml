@page "/portal/views"
@model ViewsModel
@{
    ViewData["Title"] = Model.ActingFor is { } name ? $"Who viewed {name}'s record" : "Who viewed my record";
    var own = Model.Own;
}
<h1>@ViewData["Title"]</h1>
@if (!Model.Available)
{
    <p class="sc-notice sc-notice--danger">@(own ? "Who viewed your record is" : "Who viewed the record is") not available right now. Contact the clinic if this continues.</p>
}
else
{
    @* What is listed, in the patient's words: every time the record or part of it was shown to someone, which the audit
       log records, over the window the database looks at (db/policies/42-record-views.sql). A proxy is told whose views
       they are shown in words that say nothing of anyone else: every staff member's when the patient allowed them
       sensitive items, otherwise the care team's alone, the lab's and their own. *@
    <p class="sc-muted">
        @(own ? "Each time someone saw your record, or part of it,"
            : Model.MaySeeSensitive ? "Each time the clinic's staff, the lab or you saw the record, or part of it,"
            : "Each time the patient's care team, the lab or you saw the record, or part of it,")
        in the last @ViewsModel.Months months, newest first. @(own ? "Your own views are listed too. " : "")This includes a clinician's search, list or schedule
        that showed @(own ? "your" : "the patient's") name. A view from the last minute may not be listed yet.
    </p>
    @* Only to someone who may be shown a view through emergency access: the patient, and a proxy with sensitive items. *@
    @if (Model.MaySeeSensitive && Model.Lines.Any(line => line.Emergency))
    {
        <p class="sc-notice sc-notice--warning" data-emergency="explained"><span class="sc-notice__state">Emergency access.</span> A clinician outside @(own ? "your" : "the patient's") care team opened the record and gave a reason. The clinic reviews each one.</p>
    }
    @if (Model.Lines.Count == 0)
    {
        <p>@(Model.PastTheEnd ? "No more views to show." : own ? "Nobody has viewed your record yet." : "Nobody has viewed the record yet.")</p>
        @if (Model.PastTheEnd)
        {
            <p><a asp-page="/Views">Newest views</a></p>
        }
    }
    else
    {
        <section class="sc-panel" aria-label="Views">
            <ul class="sc-list">
                @foreach (var line in Model.Lines)
                {
                    <li data-who="@line.Kind">
                        <div><strong>@line.Who</strong>@if (line.Role is { } role) {<text>, @role</text>}@if (line.Emergency) {<text> </text><span class="sc-tag sc-tag--warning">Emergency access</span>}</div>
                        <div>@line.Part</div>
                        <div class="sc-muted"><time datetime="@line.At.UtcDateTime.ToString("yyyy-MM-ddTHH:mmZ")">@Clinic.Format(line.At, "MMM d, yyyy, HH:mm")</time></div>
                    </li>
                }
            </ul>
        </section>
        @if (Model.NewerFrom is not null || Model.OlderFrom is not null)
        {
            <nav aria-label="More views" class="sc-actions">
                @if (Model.NewerFrom is { } newer)
                {
                    <a asp-page="/Views" asp-route-newer="@newer">Newer views</a>
                }
                @if (Model.OlderFrom is { } older)
                {
                    <a asp-page="/Views" asp-route-older="@older">Older views</a>
                }
            </nav>
        }
    }
}
<p><a asp-page="/Index">Back to home</a></p>
