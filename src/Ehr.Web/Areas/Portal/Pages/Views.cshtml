@page "/portal/views"
@model ViewsModel
@{
    var own = Model.Own;
    ViewData["Title"] = own ? "Who viewed my record" : "Who viewed this record";
}
<div class="sc-pagehead"><a asp-page="/Index" class="sc-back">Back to home</a></div>
<h1>@ViewData["Title"]</h1>
@if (!Model.Available)
{
    <p class="sc-notice sc-notice--danger">@(own ? "Who viewed your record is" : "Who viewed the record is") not available right now.</p>
}
else
{
    @* The window the database looks at (db/policies/42-record-views.sql). *@
    <p class="sc-muted">Last @ViewsModel.Months months.</p>
    @* Only to someone who may be shown a view through emergency access: the patient, and a proxy with sensitive items. *@
    @if (Model.MaySeeSensitive && Model.Lines.Any(line => line.Emergency))
    {
        <p class="sc-notice sc-notice--warning" data-emergency="explained"><span class="sc-notice__state">Emergency access.</span> A clinician outside @(own ? "your" : "the patient's") care team opened the record. The clinic reviews each one.</p>
    }
    @if (Model.Lines.Count == 0)
    {
        <p class="sc-empty">@(Model.PastTheEnd ? "No more views." : "No views yet.")</p>
        @if (Model.PastTheEnd)
        {
            <p><a asp-page="/Views">Newest views</a></p>
        }
    }
    else
    {
        @* One row a view: who, and when on the right; what they saw under it. *@
        <section aria-label="Views">
            <ul class="sc-rows">
                @foreach (var line in Model.Lines)
                {
                    <li data-who="@line.Kind">
                        <div><strong>@line.Who</strong>@if (line.Role is { } role) {<text>, @role</text>}@if (line.Emergency) {<text> </text><span class="sc-tag sc-tag--warning">Emergency access</span>}</div>
                        <div class="sc-rows__meta">@line.Part</div>
                        <div class="sc-muted sc-rows__end"><time datetime="@line.At.UtcDateTime.ToString("yyyy-MM-ddTHH:mmZ")">@Clinic.Format(line.At, "MMM d, yyyy, HH:mm")</time></div>
                    </li>
                }
            </ul>
        </section>
        @if (Model.NewerFrom is not null || Model.OlderFrom is not null)
        {
            <nav aria-label="More views" class="sc-actions">
                @if (Model.NewerFrom is { } newer)
                {
                    <a asp-page="/Views" asp-route-newer="@newer">Newer views</a>
                }
                @if (Model.OlderFrom is { } older)
                {
                    <a asp-page="/Views" asp-route-older="@older">Older views</a>
                }
            </nav>
        }
    }
}
