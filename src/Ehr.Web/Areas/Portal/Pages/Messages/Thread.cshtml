@page "/portal/messages/{threadId:guid}"
@using Ehr.Data.Messaging
@using Ehr.Domain.Messaging
@model Ehr.Web.Areas.Portal.Pages.Messages.ThreadModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = Model.Thread.Subject;
}
<div class="sc-pagehead"><a asp-page="Index" class="sc-back">Back to messages</a></div>
<h1>@Model.Thread.Subject</h1>
@if (Model.Sent && Model.Error is null)
{
    <p class="sc-notice sc-notice--success" role="status"><span class="sc-notice__state">Sent.</span> @(Model.Acting ? "Replies from the care team appear here." : "Replies from your care team appear here.")</p>
}
<partial name="_Thread" model="(Model.Thread.Messages, MessageSender.Patient)" />
@if (!OnPrem.IsReachable)
{
    <p class="sc-notice sc-notice--warning"><span class="sc-notice__state">Read-only.</span> Messages can't be sent until the clinic's server is back.</p>
}
else
{
    <div class="sc-formcard">
        <form method="post" class="sc-form">
            @if (Model.Error is not null)
            {
                <p class="sc-notice sc-notice--danger" role="alert"><span class="sc-notice__state">Not sent.</span> Fix the highlighted fields and try again.</p>
            }
            <div class="sc-field">
                <label for="message-body">Your reply</label>
                <textarea id="message-body" class="sc-field__input" name="Body" rows="6" maxlength="@SecureMessages.MaximumBody" required
                          aria-invalid="@(Model.Error is null ? null : "true")" aria-describedby="@(Model.Error is null ? null : "message-body-error")">@(Model.Error is null ? null : Model.Body)</textarea>
                @if (Model.Error is not null)
                {
                    <p class="sc-field__error" id="message-body-error">@Model.Error</p>
                }
            </div>
            <button type="submit" class="sc-btn sc-btn--primary">Send reply</button>
        </form>
    </div>
}
