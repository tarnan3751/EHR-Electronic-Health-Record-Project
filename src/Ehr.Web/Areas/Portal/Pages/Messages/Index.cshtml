@page "/portal/messages"
@model Ehr.Web.Areas.Portal.Pages.Messages.IndexModel
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@{
    ViewData["Title"] = "Messages";
}
@if (!Model.Allowed)
{
    <h1>Messages</h1>
    <p class="sc-notice sc-notice--info">Your access to this record doesn't include messages.</p>
    return;
}
@* The page's one action beside its title. *@
<div class="sc-titlebar">
    <h1>Messages</h1>
    @if (OnPrem.IsReachable)
    {
        <a asp-page="New" class="sc-btn sc-btn--primary">New message</a>
    }
</div>
@if (!OnPrem.IsReachable)
{
    <p class="sc-notice sc-notice--warning"><span class="sc-notice__state">Read-only.</span> Messages can't be sent until the clinic's server is back. You can still read them.</p>
}
<p class="sc-muted">For an emergency, call your local emergency number. Messages are read during clinic hours.</p>
@if (Model.Threads is not { } threads)
{
    <p class="sc-notice sc-notice--danger">@(Model.Acting ? "The messages are" : "Your messages are") not available right now. Contact the clinic if this continues.</p>
}
else if (threads.Threads.Count == 0)
{
    <p class="sc-empty">No messages.</p>
}
else
{
    @* One row a conversation: its subject, which opens it (the whole row does), and when it last had a message. *@
    <ul class="sc-rows">
        @foreach (var thread in threads.Threads)
        {
            <li data-thread="@(thread.Unread > 0 ? "new" : "read")">
                <h2><a asp-page="Thread" asp-route-threadId="@thread.Id" class="sc-rows__link">@thread.Subject</a></h2>
                <p class="sc-rows__end">
                    @if (thread.Unread > 0)
                    {
                        <span class="sc-tag sc-tag--info">New</span>
                    }
                    Last message @Clinic.Plain(thread.LastMessageAt, "MMM d, yyyy")
                </p>
            </li>
        }
    </ul>
    @if (threads.Threads.Count == Ehr.Web.Areas.Portal.Pages.Messages.IndexModel.Limit)
    {
        <p class="sc-muted">These are the @Ehr.Web.Areas.Portal.Pages.Messages.IndexModel.Limit latest conversations. For an older one, contact the clinic.</p>
    }
}
