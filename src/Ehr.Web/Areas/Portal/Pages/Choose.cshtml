@page "/portal/choose"
@using Ehr.Domain.Proxies
@model Ehr.Web.Areas.Portal.Pages.ChooseModel
@{
    ViewData["Title"] = "Whose record?";
}
<h1>Whose record?</h1>
@if (Model.Ended)
{
    <p class="sc-notice sc-notice--warning" role="status"><span class="sc-notice__state">Access ended.</span> You can no longer see that record.</p>
}
@if (!Model.HasOwnRecord && Model.Records.Count == 0)
{
    <p>Nobody is sharing a record with you. When someone does, it's listed here.</p>
    return;
}
<p class="sc-muted">Choose a record. You can switch at any time under Sharing.</p>
<ul class="sc-results">
    @if (Model.HasOwnRecord)
    {
        <li class="sc-result" data-record="own">
            <h2>My record</h2>
            <form method="post" asp-page="/Acting" asp-page-handler="Mine">
                <button type="submit" class="sc-btn sc-btn--primary" autofocus>View my record</button>
            </form>
        </li>
    }
    @foreach (var record in Model.Records)
    {
        <li class="sc-result" data-record="shared">
            <h2>@record.PatientName</h2>
            <p>Shared with you. @ProxyAccess.ScopeLabel(record.Scope). Until @Clinic.Plain(record.ExpiresAt, "MMM d, yyyy").</p>
            <form method="post" asp-page="/Acting">
                <input type="hidden" name="grantId" value="@record.GrantId">
                <button type="submit" class="sc-btn @(Model.HasOwnRecord ? null : "sc-btn--primary")">View this record</button>
            </form>
        </li>
    }
</ul>
