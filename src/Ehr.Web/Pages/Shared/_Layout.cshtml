@* The one page frame: the head every page needs, and an app bar that says who is signed in and where they can go.
   Staff see the clinic's links for their roles; a patient sees the portal's. Nobody signed in sees no app bar. A
   signed-in page also carries the session's warning and what replaces the page when the session ends (session.js; the
   expansion plan's step 18), which asks the server how long the session has left (SessionTimes). *@
@{
    var isPatient = User.IsPortalAccount();
    var displayName = User.FindFirst(EhrClaims.DisplayName)?.Value ?? User.Identity?.Name;
    // The portal's pages, signed in or not: its account pages have no patient yet.
    var isPortal = isPatient || string.Equals(ViewContext.RouteData.Values["area"] as string, "Portal", StringComparison.Ordinal);
    var signedIn = User.Identity?.IsAuthenticated == true;
    // A page sets its own width: "content" for clinician pages, "reading" for long text, "form" for one narrow column.
    var width = ViewData["Width"] as string ?? (isPortal ? "reading" : "content");
    // The page being shown, to mark its place in the navigation.
    var here = ViewContext.RouteData.Values["page"] as string ?? "";
    // How many inbox items need the signed-in staff member's action, when the page counted them (InboxCountFilter).
    var waiting = Context.Items[Ehr.Web.InboxCountFilter.Item] as int? ?? 0;
    // Whose record a portal page is about, when it is someone else's (PortalSubjectFilter; FR-19).
    var subject = Context.Items[Ehr.Web.PortalSubjectFilter.Item] as Ehr.Web.PortalSubject;
    var acting = subject?.Acting;
    Func<string, string?> current = start => here.StartsWith(start, StringComparison.Ordinal) ? "page" : null;
    // The session's page (step 18), which session.js asks: the portal's sign-in on its pages, the staff's on the rest.
    var sessionPage = isPatient ? "/portal/session" : "/session";
    var keeps = isPatient ? "your health information" : "patient information";
    var button = isPatient ? "sc-btn sc-btn--portal" : "sc-btn";
}
@inject Ehr.Web.Forwarding.OnPremStatus OnPrem
@inject Ehr.Domain.Accounts.PasskeySettings Passkeys
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @* The htmx features that run JavaScript from attributes stay off, so a strict CSP can be added later. *@
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"historyCacheSize":0}'>
    <title>@ViewData["Title"]</title>
    @* The browser's own chrome takes the app bar's color (docs/brand/tokens.json: appbar for staff, surface-raised
       for the portal), in each theme. *@
    @if (isPortal)
    {
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#182a3f" media="(prefers-color-scheme: dark)">
    }
    else
    {
        <meta name="theme-color" content="#0e1b2c" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#091320" media="(prefers-color-scheme: dark)">
    }
    <link rel="icon" href="~/_content/Ehr.Design/img/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="~/_content/Ehr.Design/img/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="~/_content/Ehr.Design/img/apple-touch-icon.png">
    @* The fonts come from this server, never a CDN (tokens.css), so the on-site app works with no internet. They
       swap in when they arrive and never hold up the first paint. No font is fetched ahead: a test holds that nothing
       on the patient search page asks for anything early (PatientSearchTests), so no page does. *@
    <link rel="stylesheet" href="~/_content/Ehr.Design/css/tokens.css">
    <link rel="stylesheet" href="~/_content/Ehr.Design/css/ehr.css">
    @if (ViewData["UseHtmx"] is not false)
    {
        <script src="~/_content/Ehr.Design/lib/htmx/dist/htmx.min.js" defer></script>
        <script src="~/_content/Ehr.Design/js/request-errors.js" defer></script>
    }
    @if (!isPatient && User.IsInRole(StaffRoles.Clinician))
    {
        @* "/" reaches the patient search from any clinical page, and the arrow keys move through its results. *@
        <script src="~/_content/Ehr.Design/js/patient-search.js" defer></script>
    }
    @if (signedIn)
    {
        @* The warning before the session ends, and what happens when it does (step 18). *@
        <script src="~/_content/Ehr.Design/js/session.js" defer></script>
    }
    @if (signedIn && !isPatient)
    {
        @* A staff app bar link reached from the keyboard is scrolled into view on a narrow window (step 19's review). *@
        <script src="~/_content/Ehr.Design/js/app-bar.js" defer></script>
    }
    @* A page's own scripts, such as dictation's, so no other page loads them. *@
    @await RenderSectionAsync("Scripts", required: false)
</head>
<body class="sc-app @(isPortal ? "sc-app--portal" : "sc-app--clinician")">
    <a class="sc-skip" href="#main">Skip to main content</a>
    @if (signedIn)
    {
        @* The app bar (docs/brand: AppBar). Staff get the dark bar with the reversed lockup, in both themes; patients
           the light one with the color lockup, which the stylesheet swaps for the reversed one in the dark theme. *@
        <header class="sc-appbar @(isPatient ? "sc-appbar--portal" : "sc-appbar--clinician")">
            <div class="sc-appbar__brand">
                @if (isPatient)
                {
                    <img class="sc-appbar__logo sc-art--color" src="~/_content/Ehr.Design/img/swiftchart-lockup.png" alt="SwiftChart" width="105" height="24">
                    <img class="sc-appbar__logo sc-art--reversed" src="~/_content/Ehr.Design/img/swiftchart-lockup-reversed.png" alt="SwiftChart" width="105" height="24">
                }
                else
                {
                    <img class="sc-appbar__logo" src="~/_content/Ehr.Design/img/swiftchart-lockup-reversed.png" alt="SwiftChart" width="105" height="24">
                }
                @if (!OnPrem.IsReachable)
                {
                    <span class="sc-appbar__site">Off-site</span>
                }
            </div>
            <nav class="sc-appbar__nav" aria-label="Main">
                @if (isPatient)
                {
                    @* A proxy-only account that hasn't chosen a record has no record pages to go to (step 6b). *@
                    @if (subject?.HasSubject != false)
                    {
                        <a asp-area="Portal" asp-page="/Index" class="sc-appbar__link" aria-current="@current("/Index")">@(acting is null ? "My record" : "Record")</a>
                        <a asp-area="Portal" asp-page="/Results" class="sc-appbar__link" aria-current="@current("/Results")">Results</a>
                        <a asp-area="Portal" asp-page="/Appointments" class="sc-appbar__link" aria-current="@current("/Appointments")">Appointments</a>
                    }
                    @if (subject?.HasSubject != false && subject?.MayMessage != false)
                    {
                        <a asp-area="Portal" asp-page="/Messages/Index" class="sc-appbar__link" aria-current="@current("/Messages/")">Messages</a>
                    }
                    <a asp-area="Portal" asp-page="/Access" class="sc-appbar__link" aria-current="@current("/Access")">Access</a>
                }
                else
                {
                    @if (User.IsInRole(StaffRoles.Clinician))
                    {
                        <a asp-area="Clinical" asp-page="/Patients/Index" class="sc-appbar__link" data-search-shortcut aria-keyshortcuts="/" aria-current="@current("/Patients/")">Patients <kbd class="sc-kbd" aria-hidden="true">/</kbd></a>
                    }
                    @if (User.IsInRole(StaffRoles.Clinician))
                    {
                        <a asp-area="Clinical" asp-page="/Schedule/Index" class="sc-appbar__link" aria-current="@current("/Schedule/")">Schedule</a>
                    }
                    @* The inbox, with how many items need action when any do (InboxCountFilter). *@
                    <a asp-area="Clinical" asp-page="/Inbox/Index" class="sc-appbar__link" aria-current="@current("/Inbox/")">
                        Inbox
                        @if (waiting > 0)
                        {
                            <span class="sc-appbar__count" data-inbox-count><span class="sc-visually-hidden">, </span>@waiting<span class="sc-visually-hidden"> to do</span></span>
                        }
                    </a>
                    <a asp-area="Clinical" asp-page="/QuickTexts/Index" class="sc-appbar__link" aria-current="@current("/QuickTexts/")">Quick text</a>
                    @* A staff member's own passkeys (step 19), where the clinic has them. *@
                    @if (Passkeys.On)
                    {
                        <a asp-area="Clinical" asp-page="/Passkeys/Index" class="sc-appbar__link" aria-current="@current("/Passkeys/")">Passkeys</a>
                    }
                    @if (User.IsInRole(StaffRoles.Admin))
                    {
                        <a asp-area="Clinical" asp-page="/Admin/Staff" class="sc-appbar__link" aria-current="@current("/Admin/Staff")">Staff</a>
                        <a asp-area="Clinical" asp-page="/Admin/Audit" class="sc-appbar__link" aria-current="@current("/Admin/Audit")">Audit</a>
                    }
                }
            </nav>
            <form method="post" asp-area="@(isPatient ? "Portal" : "Clinical")" asp-page="/Account/SignOut" class="sc-appbar__end">
                <span class="sc-appbar__user">@displayName</span>
                <button class="sc-appbar__signout">Sign out</button>
            </form>
        </header>
    }
    @if (!OnPrem.IsReachable)
    {
        @* FR-34: off-site, with the clinic's server down, records can still be read but nothing can be saved. The band
           runs the full width under the app bar on every page. *@
        <p class="sc-notice sc-notice--warning sc-notice--band" role="status"><span class="sc-notice__state">Read-only:</span> the clinic's server can't be reached. You can look at records, but the newest changes may not appear yet, and nothing can be saved until it's back.</p>
    }
    @if (acting is not null)
    {
        @* FR-19: a proxy is never left to wonder whose record is on screen. The band sits under the app bar on every
           portal page while the session is acting for someone, with the way back. *@
        <form method="post" asp-area="Portal" asp-page="/Acting" asp-page-handler="Mine" class="sc-notice sc-notice--info sc-notice--band sc-acting" data-acting>
            <p><span class="sc-notice__state">Viewing as a proxy:</span> this is <strong>@acting.PatientName</strong>'s record, not your own.</p>
            <button type="submit" class="sc-btn sc-btn--compact">@(subject!.OwnPatientId is null ? "Choose another record" : "Back to my own record")</button>
        </form>
    }
    @* The patient banner, on a page about a patient: directly under the app bar, and it stays put as the page scrolls. *@
    @await RenderSectionAsync("Banner", required: false)
    <main id="main" class="sc-page sc-page--@width">
        @if (!signedIn && width == "form")
        {
            @* Signed out, an account form: the mark alone, centered above it. *@
            <p class="sc-brandmark">
                <img class="sc-art--color" src="~/_content/Ehr.Design/img/swiftchart-mark.svg" alt="SwiftChart" width="56" height="48">
                <img class="sc-art--reversed" src="~/_content/Ehr.Design/img/swiftchart-mark-reversed.svg" alt="SwiftChart" width="56" height="48">
            </p>
        }
        <p id="request-error" class="sc-notice sc-notice--danger" role="alert" hidden></p>
        @RenderBody()
    </main>
    @if (signedIn)
    {
        @* Step 18: the warning, 2 minutes before the session ends, as a dialog that takes the focus; session.js opens it
           when the server confirms. Its settings are the server's, the same for everyone, so the page carries nothing
           of the session's (no account, record or time left): the script asks for those. The words are here. *@
        <dialog class="sc-dialog" role="alertdialog" aria-labelledby="session-warning-title" aria-describedby="session-warning-text"
                data-session-warning data-session-kind="@(isPatient ? "portal" : "staff")" data-session-url="@sessionPage"
                data-session-idle="@((int)SessionTimes.Idle.TotalSeconds)" data-session-warn="@((int)SessionTimes.Warning.TotalSeconds)"
                data-session-sign-in="@(isPatient ? "/portal/sign-in" : "/sign-in")?ReturnUrl=@Uri.EscapeDataString(sessionPage)"
                data-session-home="@(isPatient ? "/portal" : "/")" data-session-choose="/portal/choose" data-session-acting-url="/portal/acting">
            <h2 class="sc-dialog__title" id="session-warning-title">You'll be signed out soon</h2>
            <div id="session-warning-text">
                <p data-session-idle-text>Nothing has been done here for a while. To keep @keeps safe, you'll be signed out in <span data-session-countdown>2:00</span> unless you stay signed in.</p>
                <p data-session-final-text hidden>A sign-in lasts at most 12 hours, and yours ends in <span data-session-countdown>2:00</span>. Save what you're doing, then sign in again.</p>
                <p data-session-typed hidden>What you've typed on this page stays here if you're signed out, out of sight, until you sign in again.</p>
                <p data-session-unreachable hidden>The server couldn't be reached, so you may still be signed out. Check the connection, then select Stay signed in again.</p>
                <p data-session-waiting hidden>The visit on this page is paused, or waiting for its voices to be named. The dictation service discards a visit left like that for 10 minutes, whether or not you stay signed in.</p>
            </div>
            <div class="sc-dialog__actions">
                <button type="button" class="@button sc-btn--primary" data-session-stay>Stay signed in</button>
                <button type="button" class="@button sc-btn--primary" data-session-carry-on hidden>Keep working</button>
                <form method="post" asp-area="@(isPatient ? "Portal" : "Clinical")" asp-page="/Account/SignOut">
                    <button class="@button">Sign out now</button>
                </form>
            </div>
        </dialog>
        @* What takes the page's place when the session has ended: nothing of the page is on screen, and the sign-in is in a
           frame here, so what was typed can come back for the same account (session.js). *@
        <template data-session-ended>
            <main id="main" class="sc-page sc-page--form sc-signed-out">
                <h1 data-session-ended-heading>Signed out</h1>
                <p class="sc-notice sc-notice--info" data-session-why="idle"><span class="sc-notice__state">Signed out:</span> nothing was done here for 15 minutes, so you were signed out to keep @keeps safe.</p>
                <p class="sc-notice sc-notice--info" data-session-why="longest"><span class="sc-notice__state">Signed out:</span> a sign-in lasts at most 12 hours.</p>
                <p class="sc-notice sc-notice--info" data-session-why="ended"><span class="sc-notice__state">Signed out:</span> this sign-in has ended, in this window or another.</p>
                <p class="sc-notice sc-notice--info" data-session-why="signed-out"><span class="sc-notice__state">Signed out:</span> you signed out.</p>
                <p data-session-kept>What you typed is kept in this tab, out of sight, and comes back when you sign in again. If anyone else signs in here, it's cleared.</p>
                <p><button type="button" class="@button sc-btn--primary" data-session-sign-in>Sign in again</button></p>
                <iframe class="sc-signed-out__frame" title="Sign in again" data-session-frame hidden></iframe>
            </main>
        </template>
    }
</body>
</html>
