{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftChart",
  "identifier": "io.github.tarnan3751.swiftchart",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SwiftChart",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCM0RCQzg2OEVENjM1NEUKUldST05kYU9ocnc5Vy8zU3gwSWlWcnJRZDkxQmtUcFA3OUU0NjdjTXZoUzlLM05HdXFnbGJGOGIK",
      "requireSignedVersion": true
    }
  }
}
