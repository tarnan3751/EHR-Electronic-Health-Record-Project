<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the macOS app may do under the hardened runtime, which its ad-hoc seal turns on (tauri.conf.json, bundle.macOS;
     the expansion plan's step 20). The hardened runtime keeps other code out of the app, which holds the key to the
     offline charts; the microphone, for an offline recording, is the one thing it then needs leave for. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
