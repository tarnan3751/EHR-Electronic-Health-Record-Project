<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI gates: each layer calls only the one below it; PHI reads go only through the PHI reader. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
    <!-- Reads the compiled IL directly, for the rules type-level analysis can't see into (async method bodies). -->
    <PackageReference Include="Mono.Cecil" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ehr.Web\Ehr.Web.csproj" />
  </ItemGroup>

</Project>
