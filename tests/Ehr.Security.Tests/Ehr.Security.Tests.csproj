<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI gates: RLS enabled and forced on every PHI table, write-audit triggers, runtime roles
       own nothing and lack BYPASSRLS, zero rows without app.user_id. Runs against real PostgreSQL 18. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migrations, which bring in Ehr.Data: the tests build the database the way infra/migrate does. -->
    <ProjectReference Include="..\..\db\migrations\Ehr.Migrations.csproj" />
  </ItemGroup>

</Project>
