<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the web app in memory, as the on-prem and the cloud server, against a real PostgreSQL 18, and checks
       what it serves. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <!-- UCUM, to check every unit the reference data and the seed record (UcumTests.cs). -->
    <PackageReference Include="Fhir.Metrics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ehr.Web\Ehr.Web.csproj" />
    <ProjectReference Include="..\Ehr.Testing\Ehr.Testing.csproj" />
    <!-- The benchmark's app, which must never write a Data Protection key (BenchmarkTests). -->
    <ProjectReference Include="..\..\bench\Ehr.Bench\Ehr.Bench.csproj" />
  </ItemGroup>

</Project>
